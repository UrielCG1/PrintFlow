{% extends 'layouts/app.html.twig' %}

{% block title %}Trabajo de impresión · {{ item.serviceOrder.folio }} | OoxCorp{% endblock %}
{% block app_navigation_active %}printing{% endblock %}
{% block app_breadcrumb %}Operación / Impresión / {{ item.serviceOrder.folio }} / P{{ item.displayLineNumber }}{% endblock %}

{% block app_content %}
    {% set productName = item.commercialItemSnapshot.name ?? item.commercialItem.name %}
    {% set scannedMaterial = currentScan and currentScan.stockUnit ? currentScan.stockUnit.variant : plan.materialVariant %}
    {% set scanIsDone = activeExecution or output or (currentScan and currentScan.available) %}
    {% set activeStep = output and output.labelPlaced ? 6 : (output ? 5 : (activeExecution ? 4 : (currentScan and currentScan.available ? 3 : (release ? 2 : 1)))) %}
    <section class="pf-page__content printing-page printing-detail">
        <header class="printing-detail-header">
            <div class="printing-detail-heading">
                <p class="pf-page-header__eyebrow">Trabajo de impresión</p>
                <h1>{{ item.serviceOrder.folio }} <span>· Partida {{ item.displayLineNumber }}</span></h1>
                <p>{{ productName }} <span>·</span> {{ item.quantity|number_format(6, '.', ',')|trim('0', 'right')|trim('.', 'right') }} {{ item.commercialItemSnapshot.measurement_unit.code|default('') }}</p>
            </div>
            <a href="{{ path('admin_printing_index') }}" class="btn pf-button pf-button--secondary printing-back"><i class="bi bi-arrow-left" aria-hidden="true"></i> Volver a cola</a>
        </header>

        <ol class="printing-stepper" style="--printing-progress: {{ activeStep > 5 ? 100 : (activeStep - 1) * 25 }}%" aria-label="Etapas del trabajo de impresión">
            {% set stepLabels = ['Arte liberado', 'Validar máquina y material', 'Iniciar impresión', 'Registrar consumo', 'Etiqueta QR'] %}
            {% for label in stepLabels %}
                {% set stepNumber = loop.index %}
                <li class="{{ stepNumber < activeStep ? 'is-complete' : (stepNumber == activeStep ? 'is-current' : '') }}">
                    <span class="printing-stepper__node">{% if stepNumber < activeStep %}<i class="bi bi-check-lg" aria-hidden="true"></i>{% else %}{{ stepNumber }}{% endif %}</span>
                    <strong>{{ label }}</strong>
                    <small>{{ stepNumber < activeStep ? 'Completado' : (stepNumber == activeStep ? (stepNumber == 4 and activeExecution ? 'En curso' : 'Siguiente paso') : 'Pendiente') }}</small>
                </li>
            {% endfor %}
        </ol>

        <div class="printing-overview-grid">
            <section class="pf-card printing-detail-card printing-art-card">
                <div class="printing-card-heading"><h2>Arte aprobado</h2>{% if release %}<span class="printing-inline-status printing-inline-status--success"><i class="bi bi-check-circle-fill" aria-hidden="true"></i>Liberado para impresión</span>{% endif %}</div>
                <div class="printing-art-file">
                    <i class="bi bi-file-earmark-pdf" aria-hidden="true"></i>
                    <div>{% if release %}<a href="{{ path('admin_design_download_file', {id: release.artworkFile.id}) }}">{{ release.artworkFile.originalName }}</a><small>{{ release.artworkFile.mimeType|split('/')|last|upper }}{% if release.artworkFile.byteSize %} · {{ (release.artworkFile.byteSize / 1048576)|number_format(1) }} MB{% endif %}</small>{% else %}<span class="printing-art-pending">Arte pendiente de liberación</span><small>Diseño aún no libera esta partida</small>{% endif %}</div>
                    {% if release %}<a class="printing-file-button" href="{{ path('admin_design_download_file', {id: release.artworkFile.id}) }}" aria-label="Ver arte aprobado"><i class="bi bi-eye" aria-hidden="true"></i><span>Ver arte</span></a>{% endif %}
                </div>
                {% if release %}
                    <div class="printing-callout printing-callout--success"><i class="bi bi-check-circle-fill" aria-hidden="true"></i><p><strong>El arte fue revisado y aprobado por Diseño.</strong><span>Versión {{ release.versionNumber }} · {{ release.authorizationType.label }} · {{ release.authorizedAt|date('d/m/Y H:i', 'America/Mexico_City') }}</span></p></div>
                    {% if release.referenceFile %}<a class="printing-reference-link" href="{{ path('admin_design_download_file', {id: release.referenceFile.id}) }}"><i class="bi bi-images" aria-hidden="true"></i>Ver captura guía</a>{% endif %}
                {% else %}<div class="printing-callout printing-callout--warning"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i><p>No hay liberación vigente de Diseño. La impresión no puede iniciar.</p></div>{% endif %}
            </section>

            <section class="pf-card printing-detail-card">
                <div class="printing-card-heading"><h2>Requerimientos de producción</h2></div>
                <dl class="printing-requirements">
                    <div><dt><i class="bi bi-printer" aria-hidden="true"></i>Máquina asignada</dt><dd>{{ plan.equipment ? plan.equipment.name : 'Pendiente de configurar' }}{% if plan.equipment %}<small>{{ plan.equipment.code }}</small>{% if is_granted('equipment.view') or is_granted('production.execute') %}<small><a href="{{ path('admin_equipment_label', {id: plan.equipment.id}) }}" target="_blank" rel="noopener">Imprimir etiqueta de máquina</a></small>{% endif %}{% endif %}</dd></div>
                    <div><dt><i class="bi bi-layers" aria-hidden="true"></i>Material</dt><dd>{{ plan.materialVariant ? plan.materialVariant.material.name : 'Pendiente de configurar' }}{% if plan.materialVariant %}<small>{{ plan.materialVariant.code }}</small>{% endif %}</dd></div>
                    <div><dt><i class="bi bi-box-seam" aria-hidden="true"></i>Cantidad a producir</dt><dd>{{ item.quantity|number_format(6, '.', ',')|trim('0', 'right')|trim('.', 'right') }} {{ item.commercialItemSnapshot.measurement_unit.code|default('') }}</dd></div>
                    <div><dt><i class="bi bi-layers" aria-hidden="true"></i>Material previsto</dt><dd>{{ plannedUsage ? plannedUsage.plannedQuantity ~ ' ' ~ plannedUsage.unitLabelSnapshot : 'Pendiente de captura' }}</dd></div>
                </dl>
                {% if allowedMaterialVariants is not empty %}
                    <div class="printing-callout printing-callout--success"><i class="bi bi-qr-code-scan" aria-hidden="true"></i><p><strong>Material autorizado para etiqueta QR.</strong><span>{% for material in allowedMaterialVariants %}{{ material.material.name }} · {{ material.code }}{{ not loop.last ? ' / ' : '' }}{% endfor %}</span></p></div>
                {% endif %}
                {% if canConfigure and not activeExecution and not plan.hasCompletedExecution %}
                    <details class="printing-configure-details">
                        <summary><i class="bi bi-sliders" aria-hidden="true"></i>Ajustar requerimientos</summary>
                        <form class="pf-form printing-configure-form" method="post" action="{{ path('admin_printing_configure', {id: plan.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('printing-configure-' ~ plan.id) }}">
                            <div><label class="form-label" for="printing-equipment">Máquina prevista</label><select id="printing-equipment" name="equipment_id" class="form-select"><option value="">{{ plan.equipment ? 'Conservar ' ~ plan.equipment.name : 'Selecciona una máquina' }}</option>{% for equipment in equipmentChoices %}<option value="{{ equipment.id }}" {{ plan.equipment and plan.equipment.id == equipment.id ? 'selected' : '' }}>{{ equipment.name }} · {{ equipment.code }}</option>{% endfor %}</select></div>
                            <div><label class="form-label" for="printing-material">Material previsto</label><select id="printing-material" name="material_variant_id" class="form-select" required><option value="">Selecciona un material</option>{% for material in materialChoices %}<option value="{{ material.id }}" {{ plan.materialVariant and plan.materialVariant.id == material.id ? 'selected' : '' }} {{ material.specifications.legacy_migration|default(false) ? 'disabled' : '' }}>{{ material.material.name }} · {% if material.specifications.width_m|default(false) %}rollo de {{ material.specifications.width_m|number_format(2, '.', '') }} m de ancho{% else %}{{ material.code }}{% endif %} · consumo en {{ material.consumptionUnit.symbol }}{{ material.specifications.legacy_migration|default(false) ? ' (configurar presentación real)' : '' }}</option>{% endfor %}</select></div>
                            <div><label class="form-label" for="printing-planned-quantity">Cantidad de material prevista</label><input id="printing-planned-quantity" name="planned_quantity" value="{{ plannedUsage ? plannedUsage.plannedQuantity : '' }}" class="form-control" inputmode="decimal" placeholder="Ej. 30.4" required><div class="form-text">Captura la cantidad en la unidad de consumo del material seleccionado. Para lona: m² de material necesarios, incluida la merma prevista; no la longitud del rollo.</div></div>
                            <div><label class="form-label" for="printing-reason">Motivo técnico</label><textarea id="printing-reason" name="reason" class="form-control" rows="2" minlength="5" maxlength="500" required>{{ plan.materialVariant ? 'Ajuste técnico autorizado de requisitos.' : 'Definición inicial de requisitos de Impresión.' }}</textarea></div>
                            {% if multiplePlannedUsages %}<div class="alert alert-warning">Esta operación tiene varias previsiones; revísalas antes de modificar los requisitos.</div>{% endif %}
                            <button class="btn pf-button pf-button--secondary" type="submit" {{ multiplePlannedUsages ? 'disabled' : '' }}>Guardar material y apartar</button>
                        </form>
                    </details>
                {% endif %}
                {% if plan.materialSnapshot %}<details class="printing-configure-details"><summary>Características técnicas del material</summary><pre class="small mt-2 mb-0">{{ plan.materialSnapshot.specifications|default({})|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre></details>{% endif %}
            </section>

            <section class="pf-card printing-detail-card printing-instructions-card">
                <div class="printing-card-heading"><h2>Instrucciones</h2></div>
                {% if release and release.instructions %}<div class="printing-instructions"><i class="bi bi-shield-check" aria-hidden="true"></i><p>{{ release.instructions|nl2br }}</p></div>{% else %}<p class="printing-muted-copy">Sigue el perfil de impresión definido para este producto y confirma la alineación antes de iniciar.</p>{% endif %}
                {% if item.productionSpecificationsSnapshot is not empty %}<details class="printing-configure-details"><summary>Especificaciones técnicas de la partida</summary><pre class="small mt-2 mb-0">{{ item.productionSpecificationsSnapshot|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre></details>{% endif %}
            </section>
        </div>

        <div class="printing-workflow-grid">
            <section class="pf-card printing-detail-card printing-validation-card" data-controller="ui--printing-scanner" data-ui--printing-scanner-src-value="{{ asset('vendor/zxing-browser/zxing-browser.min.js') }}">
                <div class="printing-card-heading"><div><h2>Validar máquina y material</h2><p>Escanea los códigos o ingrésalos manualmente.</p></div><span class="printing-step-number">1</span></div>
                {% if canExecute and release and not activeExecution and canStartPrinting %}
                    <form class="pf-form" method="post" action="{{ path('admin_printing_validate_scans', {id: plan.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('printing-scan-' ~ plan.id) }}">
                        <input type="hidden" name="capture_mode" value="SCANNER" data-ui--printing-scanner-target="mode">
                        <div class="printing-scan-fields">
                            <div><label class="form-label" for="scan-equipment">Código de máquina <span>*</span></label><div class="input-group"><input id="scan-equipment" name="equipment_code" class="form-control" placeholder="Escanea o ingresa el código" maxlength="40" required autocomplete="off" data-ui--printing-scanner-target="equipment"><button class="btn printing-scan-camera" type="button" aria-label="Usar cámara para máquina" data-ui--printing-scanner-target="cameraButton" data-action="ui--printing-scanner#scanEquipment"><i class="bi bi-upc-scan" aria-hidden="true"></i></button></div></div>
                            <div><label class="form-label" for="scan-material">Etiqueta QR de unidad física <span>*</span></label><div class="input-group"><input id="scan-material" name="material_qr_payload" class="form-control" placeholder="Escanea el QR del rollo, envase o paquete" maxlength="80" required autocomplete="off" data-ui--printing-scanner-target="material"><button class="btn printing-scan-camera" type="button" aria-label="Usar cámara para etiqueta QR" data-ui--printing-scanner-target="cameraButton" data-action="ui--printing-scanner#scanMaterial"><i class="bi bi-upc-scan" aria-hidden="true"></i></button></div></div>
                        </div>
                        <div class="pf-qr-scan-preview" data-ui--printing-scanner-target="panel" hidden><video autoplay muted playsinline data-ui--printing-scanner-target="video" aria-label="Vista de la cámara para escanear códigos"></video><button class="btn pf-button pf-button--secondary pf-button--sm mt-2" type="button" data-action="ui--printing-scanner#stop">Cerrar cámara</button></div>
                        <p class="printing-scan-message" data-ui--printing-scanner-target="message" aria-live="polite"></p>
                        <p class="printing-form-hint">Escanea la etiqueta QR de la unidad física; debe conservar saldo disponible.</p>
                        <button class="btn pf-button pf-button--primary printing-wide-button" type="submit"><i class="bi bi-upc-scan" aria-hidden="true"></i>Validar escaneos</button>
                        <p class="printing-form-hint">La etiqueta debe pertenecer a una unidad con saldo disponible. La captura manual requiere autorización del jefe de Producción.</p>
                    </form>
                {% elseif currentScan and currentScan.available %}
                    <div class="printing-callout printing-callout--success"><i class="bi bi-check-circle-fill" aria-hidden="true"></i><p><strong>Máquina y material validados.</strong><span>Validación {{ currentScan.validatedAt|date('d/m/Y H:i', 'America/Mexico_City') }}.</span></p></div>
                {% else %}
                    <div class="printing-callout printing-callout--muted"><i class="bi bi-lock-fill" aria-hidden="true"></i><p>{% if not release %}Se requiere un arte liberado por Diseño antes de validar.{% elseif activeExecution %}La impresión está en curso.{% elseif not canExecute %}Necesitas permiso de ejecución para validar.{% elseif not canStartPrinting %}Esta impresión ya se completó. Un retrabajo requiere autorización de Calidad.{% else %}Configura máquina y material para continuar.{% endif %}</p></div>
                    <button class="btn pf-button pf-button--secondary printing-wide-button" type="button" disabled>Validar máquina y material</button>
                {% endif %}
            </section>

            <section class="pf-card printing-detail-card printing-next-card">
                <div class="printing-card-heading"><h2>Siguiente paso</h2></div>
                {% if canExecute and currentScan and currentScan.available and not activeExecution and canStartPrinting %}
                    <form method="post" action="{{ path('admin_printing_start', {id: plan.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('printing-start-' ~ plan.id) }}"><input type="hidden" name="expected_order_version" value="{{ orderVersion }}"><input type="hidden" name="command_id" value="{{ startCommandId }}">
                        {% if reworkOrigin %}<p class="printing-next-note">Calidad autorizó el retrabajo del intento {{ reworkOrigin.attemptNumber }}.</p>{% else %}<p class="printing-next-note">La máquina y el material están validados para esta partida.</p>{% endif %}
                        <button class="btn pf-button pf-button--primary printing-wide-button" type="submit"><i class="bi bi-play-circle-fill" aria-hidden="true"></i>Iniciar impresión</button>
                    </form>
                {% else %}
                    <button class="btn pf-button pf-button--primary printing-wide-button" type="button" disabled><i class="bi bi-play-circle-fill" aria-hidden="true"></i>Iniciar impresión</button>
                    <p class="printing-form-hint">Valida la máquina y el material para habilitar el inicio.</p>
                {% endif %}
            </section>

            <section class="pf-card printing-detail-card printing-close-card">
                <div class="printing-card-heading"><div><h2>Cerrar impresión</h2><p>Registra el consumo al finalizar.</p></div><i class="bi bi-lock printing-locked-icon" aria-hidden="true"></i></div>
                {% if canExecute and activeExecution %}
                    <form class="pf-form" method="post" action="{{ path('admin_printing_complete', {id: activeExecution.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('printing-complete-' ~ activeExecution.id) }}"><input type="hidden" name="expected_order_version" value="{{ orderVersion }}"><input type="hidden" name="command_id" value="{{ completeCommandId }}">
                        <div class="printing-consumption-grid">
                            {% if confirmedPlanQuantity %}
                                <div><label class="form-label" for="printing-planned-total">Total propuesto desde Material previsto ({{ scannedMaterial.consumptionUnit.symbol }})</label><input id="printing-planned-total" class="form-control" value="{{ confirmedPlanQuantity }}" readonly><div class="form-text">{% if plannedInventoryQuantity %}Equivale a {{ plannedInventoryQuantity }} {{ scannedMaterial.inventoryUnit.symbol }} de la unidad QR escaneada.{% endif %} Confirma que la impresión utilizó esta cantidad.</div></div>
                            {% else %}
                                <div><label class="form-label" for="printing-total">Total real utilizado ({{ scannedMaterial ? scannedMaterial.consumptionUnit.symbol : 'unidad' }})</label><input id="printing-total" class="form-control" name="total_consumed" inputmode="decimal" placeholder="Cantidad medida" required><div class="form-text">El material escaneado no tiene un total previsto aplicable; mide su consumo.</div></div>
                            {% endif %}
                            <div><label class="form-label" for="printing-waste">Merma medida ({{ scannedMaterial ? scannedMaterial.consumptionUnit.symbol : 'unidad' }})</label><input id="printing-waste" class="form-control" name="waste" inputmode="decimal" value="0" required></div>
                        </div>
                        <p class="printing-form-hint">La merma forma parte del total descontado; no se suma otra vez. Si el material usado superó el previsto, registra el total real diferente.</p>
                        {% if confirmedPlanQuantity %}
                            <details class="printing-configure-details"><summary>Registrar un consumo distinto al previsto</summary><div class="mt-3"><label class="form-label" for="printing-total">Total real utilizado ({{ scannedMaterial.consumptionUnit.symbol }})</label><input id="printing-total" class="form-control" name="total_consumed" inputmode="decimal" placeholder="Solo si difiere de {{ confirmedPlanQuantity }}"><div class="form-text">Al capturar este valor se usará en lugar del total propuesto.</div><label class="form-label mt-3" for="printing-method">Cómo se midió el total</label><select id="printing-method" class="form-select" name="measurement_method"><option value="medición manual">Medición manual</option><option value="lectura de máquina">Lectura de máquina</option></select><label class="form-label mt-3" for="printing-adjustment-reason">Motivo de la diferencia</label><input id="printing-adjustment-reason" class="form-control" name="adjustment_reason" minlength="5" maxlength="500" placeholder="Ej. Reimpresión parcial o avance adicional"><div class="form-text">Obligatorio si cambió la cantidad prevista.</div></div></details>
                        {% else %}
                            <div><label class="form-label" for="printing-method">Cómo se midió el total</label><select id="printing-method" class="form-select" name="measurement_method" required><option value="medición manual">Medición manual</option><option value="lectura de máquina">Lectura de máquina</option></select><label class="form-label mt-3" for="printing-adjustment-reason">Motivo de usar una cantidad distinta</label><input id="printing-adjustment-reason" class="form-control" name="adjustment_reason" minlength="5" maxlength="500" required placeholder="Ej. Sustituto autorizado o consumo sin previsión aplicable"></div>
                        {% endif %}
                        <details class="printing-configure-details"><summary>Agregar datos de cierre</summary><div class="mt-3"><label class="form-label" for="printing-waste-reason">Motivo de merma</label><input id="printing-waste-reason" class="form-control" name="waste_reason" maxlength="255"><div class="form-text">Obligatorio si la merma es mayor que cero.</div><label class="form-label mt-3" for="printing-note">Nota de cierre</label><input id="printing-note" class="form-control" name="note" maxlength="500"></div></details>
                        <details class="printing-configure-details"><summary>Separar sobrante reutilizable</summary><div class="mt-3"><p class="printing-form-hint">Regístralo solo si separaste físicamente un retazo o remanente. Se conserva el saldo total y se crea una etiqueta QR propia.</p><label class="form-label" for="printing-surplus-quantity">Cantidad separada ({{ scannedMaterial ? scannedMaterial.inventoryUnit.symbol : 'unidad de inventario' }})</label><input id="printing-surplus-quantity" class="form-control" name="surplus_quantity" inputmode="decimal" value="0"><label class="form-label mt-3" for="printing-surplus-location">Ubicación del sobrante</label><input id="printing-surplus-location" class="form-control" name="surplus_location" maxlength="100" placeholder="Conserva la ubicación actual si se deja vacío"><label class="form-label mt-3" for="printing-surplus-description">Descripción física</label><input id="printing-surplus-description" class="form-control" name="surplus_description" maxlength="500" placeholder="Ej. Retazo 1.20 m × 0.80 m, ancho útil 0.80 m"></div></details>
                        <div class="form-check"><input id="printing-confirm-consumption" class="form-check-input" type="checkbox" name="confirmed_consumption" value="1" required><label class="form-check-label" for="printing-confirm-consumption">Confirmo que el total a descontar corresponde al material realmente utilizado en esta impresión.</label></div>
                        <button class="btn pf-button pf-button--primary printing-wide-button" type="submit">Terminar impresión y crear etiqueta</button>
                    </form>
                {% else %}
                    <div class="printing-disabled-fields"><span>Total previsto ({{ scannedMaterial ? scannedMaterial.consumptionUnit.symbol : 'unidad' }})<b>{{ confirmedPlanQuantity ?: 'Pendiente' }}</b></span><span>Merma ({{ scannedMaterial ? scannedMaterial.consumptionUnit.symbol : 'unidad' }})<b>0</b></span></div>
                    <p class="printing-form-hint">El registro estará disponible cuando finalice la impresión.</p>
                    <button class="btn pf-button pf-button--secondary printing-wide-button" type="button" disabled>Cerrar impresión</button>
                {% endif %}
            </section>
        </div>

        <div class="printing-bottom-grid">
            <section class="pf-card printing-detail-card printing-label-card">
                <div class="printing-card-heading"><h2>Etiqueta QR de producción</h2></div>
                {% if output %}
                    <div class="printing-label-preview"><div class="printing-label-mark"><img src="{{ asset('images/brand/logo.png') }}" alt="OoxCorp" class="printing-label-logo">{% if outputQrSvg %}<div class="printing-label-qr">{{ outputQrSvg|raw }}</div>{% else %}<i class="bi bi-qr-code printing-label-qr-fallback" aria-hidden="true"></i>{% endif %}<strong>{{ output.labelCode }}</strong><small>{{ item.serviceOrder.folio }} · P{{ item.displayLineNumber }}</small><span>PRODUCCIÓN</span></div><div class="printing-label-actions"><small>Código de etiqueta</small><code>{{ output.labelCode }}</code><p>Salida versión {{ output.versionNumber }}{% if output.labelReadyAt %} · generada {{ output.labelReadyAt|date('d/m/Y H:i', 'America/Mexico_City') }}{% endif %}</p>{% if canPrintLabels %}{% if output.labelReadyAt %}<a class="btn pf-button pf-button--primary printing-wide-button" href="{{ path('admin_printing_label', {id: output.id}) }}" target="_blank"><i class="bi bi-printer" aria-hidden="true"></i>Imprimir etiqueta</a>{% else %}<a class="btn pf-button pf-button--primary printing-wide-button" href="{{ path('admin_printing_label', {id: output.id}) }}" target="_blank"><i class="bi bi-printer" aria-hidden="true"></i>Generar e imprimir etiqueta</a>{% endif %}{% endif %}{% if canExecute %}<form method="post" action="{{ path('admin_printing_confirm_label_placed', {id: output.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('printing-label-placed-' ~ output.id) }}"><button class="btn pf-button pf-button--secondary printing-wide-button" type="submit" {{ output.labelPlaced ? 'disabled' : '' }}><i class="bi bi-check2" aria-hidden="true"></i>{{ output.labelPlaced ? 'Etiqueta colocada' : 'Confirmar colocación' }}</button></form>{% endif %}{% if canPrintLabels and output.labelReadyAt %}<details class="printing-reprint-details"><summary>Reimprimir etiqueta</summary><form class="pf-form mt-2" method="post" action="{{ path('admin_printing_reprint_label', {id: output.id}) }}" target="_blank"><input type="hidden" name="_token" value="{{ csrf_token('printing-reprint-label-' ~ output.id) }}"><label class="form-label" for="reprint-reason">Motivo de reimpresión</label><input id="reprint-reason" class="form-control mb-2" name="reason" minlength="5" required><button class="btn pf-button pf-button--secondary" type="submit">Reimprimir</button></form></details>{% endif %}</div></div>
                    {% if output.labelPlaced %}<div class="printing-callout printing-callout--success mt-3"><i class="bi bi-check-circle-fill" aria-hidden="true"></i><p><strong>Etiqueta colocada</strong><span>La colocación quedó confirmada.</span></p></div>{% elseif not output.labelReadyAt %}<p class="printing-form-hint">Generar la etiqueta no duplica la impresión ni el consumo.</p>{% endif %}
                {% else %}<div class="printing-label-placeholder"><i class="bi bi-qr-code" aria-hidden="true"></i><strong>Etiqueta pendiente</strong><span>Se generará al cerrar la impresión y registrar el consumo.</span></div>{% endif %}
            </section>

            {% if surplusStockUnits is not empty %}
                <section class="pf-card printing-detail-card printing-label-card">
                    <div class="printing-card-heading"><h2>Etiquetas de sobrantes</h2></div>
                    <p class="printing-form-hint">Estos remanentes conservan su procedencia y saldo como unidades físicas independientes.</p>
                    <div class="printing-usage-list">
                        {% for stockUnit in surplusStockUnits %}
                            <article><strong>{{ stockUnit.unitCode }} · {{ stockUnit.remainingQuantity }} {{ stockUnit.variant.inventoryUnit.symbol }}</strong><span>{{ stockUnit.variant.material.name }}{% if stockUnit.storageLocation %} · {{ stockUnit.storageLocation }}{% endif %}</span>{% if canPrintInventoryLabels %}<a class="btn pf-button pf-button--secondary pf-button--sm" href="{{ path('admin_inventory_receipts_stock_unit_label', {id: stockUnit.id}) }}" target="_blank"><i class="bi bi-printer" aria-hidden="true"></i> Imprimir QR</a>{% endif %}</article>
                        {% endfor %}
                    </div>
                </section>
            {% endif %}

            <section class="pf-card printing-detail-card printing-trace-card">
                <div class="printing-card-heading"><h2>Trazabilidad del trabajo</h2><span class="printing-trace-order">{{ item.serviceOrder.folio }} · P{{ item.displayLineNumber }}</span></div>
                <ol class="printing-timeline">
                    <li class="{{ release ? 'is-complete' : '' }}"><span class="printing-timeline__node"></span><div><strong>Arte liberado por Diseño</strong>{% if release %}<small>{{ release.authorizedAt|date('d/m/Y H:i', 'America/Mexico_City') }} · {{ release.authorizedBy.userIdentifier }}</small>{% else %}<small>Pendiente</small>{% endif %}</div></li>
                    <li class="{{ scanIsDone ? 'is-complete' : '' }}"><span class="printing-timeline__node"></span><div><strong>Validación de máquina y material</strong>{% if currentScan %}<small>{{ currentScan.validatedAt|date('d/m/Y H:i', 'America/Mexico_City') }} · {{ currentScan.operator.userIdentifier }}</small>{% else %}<small>Pendiente</small>{% endif %}</div></li>
                    {% for execution in plan.executions %}<li class="{{ execution.completedAt ? 'is-complete' : 'is-current' }}"><span class="printing-timeline__node"></span><div><strong>Inicio de impresión · intento {{ execution.attemptNumber }}</strong><small>{{ execution.startedAt|date('d/m/Y H:i', 'America/Mexico_City') }} · {{ execution.assignedOperator.userIdentifier }}</small>{% if execution.completedAt %}<small>Terminado {{ execution.completedAt|date('d/m/Y H:i', 'America/Mexico_City') }}{% if execution.completionNote %} · {{ execution.completionNote }}{% endif %}</small>{% endif %}</div></li>{% endfor %}
                    {% for usage in materialUsages %}<li class="is-complete"><span class="printing-timeline__node"></span><div><strong>Consumo registrado · {{ usage.actualQuantity }} {{ usage.unitLabelSnapshot }}</strong><small>{{ usage.measuredAt|date('d/m/Y H:i', 'America/Mexico_City') }} · merma {{ usage.wasteQuantity }} {{ usage.unitLabelSnapshot }}</small></div></li>{% endfor %}
                    {% if output %}<li class="{{ output.labelReadyAt ? 'is-complete' : '' }}"><span class="printing-timeline__node"></span><div><strong>Etiqueta QR generada</strong><small>{{ output.labelReadyAt ? output.labelReadyAt|date('d/m/Y H:i', 'America/Mexico_City') : 'Pendiente' }}</small></div></li><li class="{{ output.labelPlaced ? 'is-complete' : '' }}"><span class="printing-timeline__node"></span><div><strong>Etiqueta colocada</strong><small>{{ output.labelPlaced ? 'Confirmada' : 'Pendiente' }}</small></div></li>{% else %}<li><span class="printing-timeline__node"></span><div><strong>Registro de consumo</strong><small>{{ activeExecution ? 'Impresión en curso' : 'Pendiente' }}</small></div></li><li><span class="printing-timeline__node"></span><div><strong>Etiqueta QR colocada</strong><small>Pendiente</small></div></li>{% endif %}
                </ol>
            </section>
        </div>

        {% if materialUsages is not empty %}<section class="pf-card printing-usage-history"><div class="printing-card-heading"><h2>Consumos registrados</h2><span>Cada cierre descuenta la unidad QR validada.</span></div><div class="printing-usage-list">{% for usage in materialUsages %}<article><strong>Intento {{ usage.operationExecution.attemptNumber }} · {{ usage.materialNameSnapshot }}</strong><span>{{ usage.actualQuantity }} {{ usage.unitLabelSnapshot }} usados · {{ usage.wasteQuantity }} {{ usage.unitLabelSnapshot }} de merma</span><time>{{ usage.measuredAt|date('d/m/Y H:i', 'America/Mexico_City') }}</time></article>{% endfor %}</div></section>{% endif %}
    </section>
{% endblock %}
