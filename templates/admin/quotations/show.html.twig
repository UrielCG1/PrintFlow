{% extends 'layouts/app.html.twig' %}

{% block title %}Cotización {{ quotation.folio ?? quotation.requestReference ?? ('#' ~ quotation.id) }} | OoxCorp{% endblock %}

{% block app_navigation_active %}quotations{% endblock %}

{% block app_breadcrumb %}Comercial / Cotizaciones / Detalle{% endblock %}

{% block app_content %}
    {% form_theme emailForm 'form/printflow_theme.html.twig' %}
    {% form_theme acceptForm 'form/printflow_theme.html.twig' %}
    {% form_theme rejectForm 'form/printflow_theme.html.twig' %}
    {% form_theme cancellationForm 'form/printflow_theme.html.twig' %}
    {% form_theme revisionForm 'form/printflow_theme.html.twig' %}
    {% if purchaseOrderForm %}{% form_theme purchaseOrderForm 'form/printflow_theme.html.twig' %}{% endif %}

    {% set status = quotation.status.value %}
    {% set status_tones = {
        'REQUEST': 'pf-status-badge--info',
        'IN_REVIEW': 'pf-status-badge--warning',
        'DRAFT': 'pf-status-badge--warning',
        'ISSUED': 'pf-status-badge--info',
        'SENT': 'pf-status-badge--info',
        'ACCEPTED': 'pf-status-badge--success',
        'ACCEPTED_WITH_CHANGES': 'pf-status-badge--warning',
        'REJECTED': 'pf-status-badge--danger',
        'EXPIRED': 'pf-status-badge--warning',
        'CANCELLED': 'pf-status-badge--neutral',
        'SUPERSEDED': 'pf-status-badge--neutral'
    } %}
    {# Las capacidades comerciales se resuelven desde QuotationStatus, no desde listas duplicadas en Twig. #}
    {% set can_send = quotation.status.canBeSent() and is_granted('quotations.send') %}
    {% set can_receive_decision = quotation.status.canReceiveDecision() and is_granted('quotations.manage_status') %}
    {% set can_revise = quotation.status.canBeRevised() and quotation.revisions is empty and is_granted('quotations.create_revision') %}

    {% if decisionErrors is not empty %}
        <span hidden data-controller="ui--quotation-decision-alert"
              data-ui--quotation-decision-alert-message-value="{{ decisionErrors|join(' ') }}"
              data-ui--quotation-decision-alert-panel-value="{{ decisionErrorPanel }}"></span>
    {% endif %}

    <section class="pf-page__content">
        <header class="pf-page-header">
            <div class="pf-page-header__content">
                <p class="pf-page-header__eyebrow">Comercial / Cotizaciones</p>
                <h1 class="pf-page-header__title">
                    {{ quotation.folio ?? quotation.requestReference ?? ('Borrador #' ~ quotation.id) }}
                    {% if quotation.revisionNumber > 1 %}
                        <span class="text-muted">· Revisión {{ quotation.revisionNumber }}</span>
                    {% endif %}
                </h1>
                <p class="pf-page-header__description">
                    {{ quotation.clientSnapshot.business_name ?? 'Cliente no disponible' }} · Vigencia hasta {{ quotation.expiresAt|date('d/m/Y') }}.
                </p>
            </div>

            <div class="pf-page-header__actions">
                <span class="pf-status-badge {{ status_tones[status]|default('pf-status-badge--neutral') }}">
                    {{ quotation.status.label }}
                </span>

                {% if status == 'REQUEST' and is_granted('quotations.update') %}
                    <form method="post" action="{{ path('admin_quotations_start_review',{id:quotation.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('quotation-review-' ~ quotation.id) }}"><button class="btn pf-button pf-button--primary" type="submit">Iniciar revisión</button></form>
                {% elseif status == 'IN_REVIEW' and is_granted('quotations.update') %}
                    <form method="post" action="{{ path('admin_quotations_prepare_draft',{id:quotation.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('quotation-draft-' ~ quotation.id) }}"><button class="btn pf-button pf-button--primary" type="submit">Preparar borrador</button></form>
                {% endif %}

                {% if quotation.hasBeenIssued and is_granted('quotations.download_pdf') %}
                    <a href="{{ path('admin_quotations_pdf', {id: quotation.id}) }}" class="btn pf-button pf-button--subtle">
                        <i class="bi bi-filetype-pdf" aria-hidden="true"></i>
                        PDF
                    </a>
                {% endif %}

                {% if quotation.editable and is_granted('quotations.update') %}
                    <a href="{{ path('admin_quotations_edit', {id: quotation.id}) }}" class="btn pf-button pf-button--secondary">
                        <i class="bi bi-pencil-square" aria-hidden="true"></i>
                        Editar borrador
                    </a>
                {% endif %}

                {% if serviceOrder and is_granted('service_orders.view') %}
                    <a href="{{ path('admin_service_orders_show', {id: serviceOrder.id}) }}" class="btn pf-button pf-button--primary">
                        <i class="bi bi-clipboard-check" aria-hidden="true"></i>
                        Ver orden {{ serviceOrder.folio }}
                    </a>
                {% endif %}

                <a href="{{ path('admin_quotations_index') }}" class="btn pf-button pf-button--secondary">
                    <i class="bi bi-arrow-left" aria-hidden="true"></i>
                    Volver
                </a>
            </div>
        </header>

        {% if quotation.publicRequest %}
            <div class="alert alert-info" role="status">
                <strong>Solicitud pública.</strong>
                Contacto: {{ quotation.requestContactName }} · {{ quotation.requestEmail }} · {{ quotation.requestPhone }}.
                {% if quotation.requestedDeliveryAt %} Fecha solicitada: {{ quotation.requestedDeliveryAt|date('d/m/Y') }}.{% endif %}
            </div>
        {% endif %}

        {% if quotation.previousRevision %}
            <div class="alert alert-secondary" role="status">
                Esta es la revisión {{ quotation.revisionNumber }} de la cotización
                <a href="{{ path('admin_quotations_show', {id: quotation.previousRevision.id}) }}">{{ quotation.previousRevision.folio ?? ('#' ~ quotation.previousRevision.id) }}</a>.
                Los importes y datos de la revisión anterior se conservaron sin modificaciones.
            </div>
        {% endif %}

        {% if status == 'ACCEPTED_WITH_CHANGES' %}
            <div class="alert alert-warning" role="status">
                El cliente aceptó esta cotización solicitando cambios. Conserva esta versión como evidencia y genera una nueva revisión antes de continuar con el flujo comercial.
            </div>
        {% endif %}

        {% set commercialContact = quotation.clientSnapshot.commercial_contact|default(null) %}

        <div class="row g-3 mb-4 quotation-detail-summary">
            <div class="col-12 col-md-4">
                <section class="pf-card h-100 quotation-detail-summary-card quotation-detail-summary-card--total">
                    <div class="pf-card__body">
                        <span class="quotation-detail-summary-card__icon" aria-hidden="true"><i class="bi bi-currency-dollar"></i></span>
                        <div class="quotation-detail-summary-card__content">
                            <span class="quotation-detail-summary-card__label">Total de la cotización</span>
                            <strong class="quotation-detail-summary-card__value">${{ quotation.total|number_format(2, '.', ',') }} <small>{{ quotation.currency }}</small></strong>
                            <span class="quotation-detail-summary-card__meta">IVA incluido: ${{ quotation.taxAmount|number_format(2, '.', ',') }}</span>
                        </div>
                    </div>
                </section>
            </div>
            <div class="col-12 col-md-4">
                <section class="pf-card h-100 quotation-detail-summary-card">
                    <div class="pf-card__body">
                        <span class="quotation-detail-summary-card__icon" aria-hidden="true"><i class="bi bi-person-vcard"></i></span>
                        <div class="quotation-detail-summary-card__content">
                        {% if commercialContact %}
                            <span class="quotation-detail-summary-card__label">Contacto comercial</span>
                            <strong class="quotation-detail-summary-card__value quotation-detail-summary-card__value--compact">{{ commercialContact.full_name|default('No especificado') }}</strong>
                            {% if commercialContact.job_title|default(null) %}
                                <span class="quotation-detail-summary-card__meta">{{ commercialContact.job_title }}</span>
                            {% endif %}
                            {% if commercialContact.email|default(null) or commercialContact.phone|default(null) %}
                                <span class="quotation-detail-summary-card__meta">{{ commercialContact.email|default('') }}{% if commercialContact.email|default(null) and commercialContact.phone|default(null) %} · {% endif %}{{ commercialContact.phone|default('') }}</span>
                            {% endif %}
                            <span class="quotation-detail-summary-card__meta">{{ quotation.clientSnapshot.legal_name ?? quotation.clientSnapshot.business_name ?? 'No especificado' }}</span>
                        {% else %}
                            <span class="quotation-detail-summary-card__label">Cliente</span>
                            <strong class="quotation-detail-summary-card__value quotation-detail-summary-card__value--compact">{{ quotation.clientSnapshot.legal_name ?? quotation.clientSnapshot.business_name ?? 'No especificado' }}</strong>
                        {% endif %}
                        {% if quotation.clientSnapshot.tax_id ?? false %}
                            <span class="quotation-detail-summary-card__meta">RFC: {{ quotation.clientSnapshot.tax_id }}</span>
                        {% endif %}
                        </div>
                    </div>
                </section>
            </div>
            <div class="col-12 col-md-4">
                <section class="pf-card h-100 quotation-detail-summary-card">
                    <div class="pf-card__body">
                        <span class="quotation-detail-summary-card__icon" aria-hidden="true"><i class="bi bi-calendar2-check"></i></span>
                        <div class="quotation-detail-summary-card__content">
                        <span class="quotation-detail-summary-card__label">Emisión</span>
                        {% if quotation.issuedAt %}
                            <strong class="quotation-detail-summary-card__value quotation-detail-summary-card__value--compact">{{ quotation.issuedAt|date('d/m/Y H:i', 'America/Mexico_City') }}</strong>
                            <span class="quotation-detail-summary-card__meta">Creada por {{ quotation.createdBy.fullName }}</span>
                        {% else %}
                            <strong class="quotation-detail-summary-card__value quotation-detail-summary-card__value--compact">Pendiente de emisión</strong>
                        {% endif %}
                        </div>
                    </div>
                </section>
            </div>
        </div>

        {% set fiscalAddress = quotation.fiscalAddressSnapshot %}
        {% set deliveryAddress = quotation.deliveryAddressSnapshot %}
        {% if commercialContact or fiscalAddress or deliveryAddress %}
            <section class="pf-card mb-4">
                <header class="pf-card__header">
                    <h2 class="pf-card__title">Datos comerciales</h2>
                    <p class="pf-card__description">Información seleccionada y congelada para esta cotización.</p>
                </header>
                <div class="pf-card__body">
                    <div class="quotation-detail-commercial-grid">
                        {% if commercialContact %}
                            <article class="quotation-detail-commercial-field quotation-detail-commercial-field--contact">
                                <span class="quotation-detail-commercial-field__icon" aria-hidden="true"><i class="bi bi-person-lines-fill"></i></span>
                                <div class="quotation-detail-commercial-field__content">
                                <h3>Contacto comercial</h3>
                                <strong>{{ commercialContact.full_name|default('No especificado') }}</strong>
                                {% if commercialContact.job_title|default(null) %}<span>{{ commercialContact.job_title }}</span>{% endif %}
                                {% if commercialContact.email|default(null) or commercialContact.phone|default(null) %}
                                    <span>{{ commercialContact.email|default('') }}{% if commercialContact.email|default(null) and commercialContact.phone|default(null) %} · {% endif %}{{ commercialContact.phone|default('') }}</span>
                                {% endif %}
                                </div>
                            </article>
                        {% endif %}
                        {% if fiscalAddress %}
                            <article class="quotation-detail-commercial-field">
                                <span class="quotation-detail-commercial-field__icon" aria-hidden="true"><i class="bi bi-receipt-cutoff"></i></span>
                                <div class="quotation-detail-commercial-field__content">
                                    <h3>Domicilio fiscal</h3>
                                    {% if fiscalAddress.label|default(null) %}<strong>{{ fiscalAddress.label }}</strong>{% endif %}
                                    {% if fiscalAddress.recipient_name|default(null) %}<span>{{ fiscalAddress.recipient_name }}</span>{% endif %}
                                    <p>{{ fiscalAddress.formatted_address|default('No especificado') }}</p>
                                </div>
                            </article>
                        {% endif %}
                        {% if deliveryAddress %}
                            <article class="quotation-detail-commercial-field">
                                <span class="quotation-detail-commercial-field__icon" aria-hidden="true"><i class="bi bi-geo-alt"></i></span>
                                <div class="quotation-detail-commercial-field__content">
                                    <h3>Domicilio de entrega</h3>
                                    {% if deliveryAddress.label|default(null) %}<strong>{{ deliveryAddress.label }}</strong>{% endif %}
                                    {% if deliveryAddress.recipient_name|default(null) %}<span>{{ deliveryAddress.recipient_name }}</span>{% endif %}
                                    <p>{{ deliveryAddress.formatted_address|default('No especificado') }}</p>
                                </div>
                            </article>
                        {% endif %}
                    </div>
                </div>
            </section>
        {% endif %}

        {% if quotation.decisionAt %}
            <section class="pf-card mb-4 quotation-decision-record">
                <header class="pf-card__header quotation-decision-record__header">
                    <div>
                        <p class="quotation-decision-record__eyebrow">Respuesta del cliente</p>
                        <h2 class="pf-card__title">Registro comercial</h2>
                    </div>
                    <span class="pf-status-badge {{ status_tones[status]|default('pf-status-badge--neutral') }}">{{ quotation.status.label }}</span>
                </header>
                <div class="pf-card__body quotation-decision-record__body">
                    <div class="quotation-decision-record__facts">
                        <article class="quotation-decision-record__fact quotation-decision-record__fact--date">
                            <span class="quotation-decision-record__icon" aria-hidden="true"><i class="bi bi-calendar-check"></i></span>
                            <div class="quotation-decision-record__fact-content">
                                <span class="quotation-decision-record__label">Fecha y hora</span>
                                <strong>{{ quotation.decisionAt|date('d/m/Y', 'America/Mexico_City') }}</strong>
                                <small>{{ quotation.decisionAt|date('H:i', 'America/Mexico_City') }} h</small>
                            </div>
                        </article>
                        {% if quotation.decisionChannel %}
                            <article class="quotation-decision-record__fact">
                                <span class="quotation-decision-record__icon" aria-hidden="true"><i class="bi bi-chat-square-text"></i></span>
                                <div class="quotation-decision-record__fact-content">
                                    <span class="quotation-decision-record__label">Canal de respuesta</span>
                                    <strong>{{ quotation.decisionChannel.label }}</strong>
                                </div>
                            </article>
                        {% endif %}
                        {% if quotation.decisionContact %}
                            <article class="quotation-decision-record__fact">
                                <span class="quotation-decision-record__icon" aria-hidden="true"><i class="bi bi-person-check"></i></span>
                                <div class="quotation-decision-record__fact-content">
                                    <span class="quotation-decision-record__label">Contacto</span>
                                    <strong>{{ quotation.decisionContact }}</strong>
                                </div>
                            </article>
                        {% endif %}
                    </div>

                    {% if quotation.decisionNotes or quotation.decisionEvidenceReference or quotation.responseScreenshotFile %}
                        <div class="quotation-decision-record__notes">
                            {% if quotation.decisionNotes %}
                                <article class="quotation-decision-record__note">
                                    <span class="quotation-decision-record__icon" aria-hidden="true"><i class="bi bi-chat-left-text"></i></span>
                                    <div>
                                        <span class="quotation-decision-record__label">Observación</span>
                                        <p>{{ quotation.decisionNotes }}</p>
                                    </div>
                                </article>
                            {% endif %}
                            {% if quotation.decisionEvidenceReference or quotation.responseScreenshotFile %}
                                <article class="quotation-decision-record__note">
                                    <span class="quotation-decision-record__icon" aria-hidden="true"><i class="bi bi-paperclip"></i></span>
                                    <div>
                                        <span class="quotation-decision-record__label">Evidencia</span>
                                        {% if quotation.decisionEvidenceReference %}<p>{{ quotation.decisionEvidenceReference }}</p>{% endif %}
                                        {% if quotation.responseScreenshotFile %}
                                            <a class="btn pf-button pf-button--subtle pf-button--sm mt-2" href="{{ path('admin_quotations_decision_file', {id: quotation.id, type: 'response-screenshot'}) }}">
                                                <i class="bi bi-download" aria-hidden="true"></i>
                                                Descargar captura
                                            </a>
                                        {% endif %}
                                    </div>
                                </article>
                            {% endif %}
                        </div>
                    {% endif %}
                </div>
            </section>
        {% endif %}

        {% if status in ['ACCEPTED', 'ACCEPTED_WITH_CHANGES'] %}
            {% set hasPurchaseOrderNumber = quotation.purchaseOrderNumber is not empty %}
            {% set hasPurchaseOrderFile = quotation.purchaseOrderFile is not empty %}
            {% set purchaseOrderDownloadUrl = quotation.purchaseOrderFile ? path('admin_quotations_decision_file', {id: quotation.id, type: 'purchase-order'}) : null %}
            <section class="pf-card mb-4 quotation-purchase-order" data-controller="ui--file-preview">
                <header class="pf-card__header quotation-purchase-order__header">
                    <div class="quotation-purchase-order__heading">
                        <div class="quotation-purchase-order__title-row">
                            <h2 class="pf-card__title">Orden de compra del cliente</h2>
                            <span class="quotation-purchase-order__state {{ hasPurchaseOrderNumber and hasPurchaseOrderFile ? 'quotation-purchase-order__state--complete' : (hasPurchaseOrderNumber or hasPurchaseOrderFile ? 'quotation-purchase-order__state--partial' : 'quotation-purchase-order__state--pending') }}">
                                <i class="bi {{ hasPurchaseOrderNumber and hasPurchaseOrderFile ? 'bi-check-circle-fill' : (hasPurchaseOrderNumber or hasPurchaseOrderFile ? 'bi-clock-history' : 'bi-info-circle') }}" aria-hidden="true"></i>
                                {% if hasPurchaseOrderNumber and hasPurchaseOrderFile %}Folio y PDF registrados{% elseif hasPurchaseOrderNumber %}Folio registrado · PDF pendiente{% elseif hasPurchaseOrderFile %}PDF adjunto · folio pendiente{% else %}Pendiente de registrar{% endif %}
                            </span>
                        </div>
                        <p class="pf-card__description">Puedes iniciar la orden de servicio sin el PDF y completar estos datos cuando los recibas.</p>
                    </div>
                </header>
                <div class="pf-card__body">
                    <div class="quotation-purchase-order__overview">
                        <div class="quotation-purchase-order__summary">
                            <span class="quotation-purchase-order__summary-icon"><i class="bi bi-receipt" aria-hidden="true"></i></span>
                            <div>
                                <span class="quotation-decision-record__label">Folio del cliente</span>
                                <strong>{{ quotation.purchaseOrderNumber|default('Sin folio registrado') }}</strong>
                                {% if not hasPurchaseOrderNumber %}<small>Se puede agregar más adelante.</small>{% endif %}
                            </div>
                        </div>

                        {% if hasPurchaseOrderFile %}
                            <div class="quotation-file-preview__card quotation-purchase-order__file">
                                <div class="quotation-file-preview__thumbnail">
                                    <i class="bi bi-file-earmark-pdf" aria-hidden="true"></i>
                                </div>
                                <div class="quotation-file-preview__details">
                                    <span class="quotation-file-preview__label">PDF de orden de compra</span>
                                    <strong class="quotation-file-preview__name" title="{{ quotation.purchaseOrderFile.original_name|default('Orden de compra.pdf') }}">{{ quotation.purchaseOrderFile.original_name|default('Orden de compra.pdf') }}</strong>
                                    <span class="quotation-file-preview__metadata">PDF{% if quotation.purchaseOrderFile.size|default(0) %} · {{ (quotation.purchaseOrderFile.size / 1024)|round(0, 'ceil')|number_format(0, '.', ',') }} KB{% endif %}</span>
                                </div>
                                <button
                                    type="button"
                                    class="btn pf-button pf-button--subtle pf-button--sm quotation-file-preview__open"
                                    data-action="ui--file-preview#openExistingPreview"
                                    data-preview-url="{{ path('admin_quotations_decision_file', {id: quotation.id, type: 'purchase-order', preview: 1}) }}"
                                    data-download-url="{{ purchaseOrderDownloadUrl }}"
                                    data-file-name="{{ quotation.purchaseOrderFile.original_name|default('Orden de compra.pdf') }}"
                                    data-file-type="application/pdf"
                                    aria-label="Visualizar {{ quotation.purchaseOrderFile.original_name|default('Orden de compra.pdf') }} en grande"
                                    title="Visualizar archivo"
                                ><i class="bi bi-eye" aria-hidden="true"></i></button>
                                <a class="btn pf-button pf-button--subtle pf-button--sm quotation-file-preview__open" href="{{ purchaseOrderDownloadUrl }}" aria-label="Descargar orden de compra" title="Descargar archivo"><i class="bi bi-download" aria-hidden="true"></i></a>
                            </div>
                        {% else %}
                            <div class="quotation-purchase-order__empty">
                                <span class="quotation-purchase-order__empty-icon"><i class="bi bi-file-earmark-pdf" aria-hidden="true"></i></span>
                                <div><strong>PDF pendiente</strong><span>Adjúntalo aquí cuando lo recibas.</span></div>
                            </div>
                        {% endif %}
                    </div>

                    {% if purchaseOrderForm %}
                        <details class="quotation-purchase-order__editor" {% if not hasPurchaseOrderNumber and not hasPurchaseOrderFile %}open{% endif %}>
                            <summary>
                                <span class="quotation-purchase-order__editor-icon"><i class="bi bi-pencil-square" aria-hidden="true"></i></span>
                                <span class="quotation-purchase-order__editor-copy"><strong>{% if hasPurchaseOrderNumber or hasPurchaseOrderFile %}Editar datos de compra{% else %}Agregar datos de compra{% endif %}</strong><small>Folio del cliente y PDF opcional</small></span>
                                <i class="bi bi-chevron-down quotation-purchase-order__editor-chevron" aria-hidden="true"></i>
                            </summary>
                            <div class="quotation-purchase-order__editor-content">
                                {{ form_start(purchaseOrderForm, {action: path('admin_quotations_purchase_order', {id: quotation.id}), attr: {class: 'quotation-purchase-order__form'}}) }}
                                    <div class="row g-3 align-items-end">
                                        <div class="col-lg-4">{{ form_row(purchaseOrderForm.purchaseOrderNumber) }}</div>
                                        <div class="col-lg-6">{{ form_row(purchaseOrderForm.purchaseOrderFile, {attr: {accept: 'application/pdf,.pdf', 'data-ui--file-preview-target': 'fileInput', 'data-action': 'change->ui--file-preview#previewFile'}}) }}</div>
                                        <div class="col-lg-2"><button type="submit" class="btn pf-button pf-button--primary w-100"><i class="bi bi-save2" aria-hidden="true"></i> Guardar</button></div>
                                    </div>
                                    <div class="quotation-file-preview" data-ui--file-preview-target="preview" aria-live="polite" hidden></div>
                                {{ form_end(purchaseOrderForm) }}
                            </div>
                        </details>
                    {% endif %}
                </div>

                {{ include('partials/_file_preview_modal.html.twig', {controllerIdentifier: 'ui--file-preview', modalTitleId: 'purchase-order-modal-title'}) }}
            </section>
        {% endif %}

        {% if quotation.editable and is_granted('quotations.issue') %}
            <section class="pf-card mb-4">
                <div class="pf-card__body d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                    <div>
                        <h2 class="pf-card__title">Emitir cotización</h2>
                        <p class="pf-card__description">Asignará el folio definitivo y bloqueará el contenido del borrador.</p>
                    </div>
                    <form method="post" action="{{ path('admin_quotations_issue', {id: quotation.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('quotation-issue-' ~ quotation.id) }}">
                        <button type="submit" class="btn pf-button pf-button--primary">
                            <i class="bi bi-file-earmark-check" aria-hidden="true"></i>
                            Emitir cotización
                        </button>
                    </form>
                </div>
            </section>
        {% endif %}

        {% if status == 'ACCEPTED' and serviceOrder is null and is_granted('service_orders.create_from_quotation') %}
            <section class="pf-card mb-4">
                <div class="pf-card__body d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                    <div>
                        <h2 class="pf-card__title">Crear orden de servicio</h2>
                        <p class="pf-card__description mb-1">La orden iniciará con todas sus partidas en Diseño y conservará su ruta, archivos, especificaciones, contacto y modalidad de entrega.</p>
                        <p class="pf-card__description">
                            Generará una única orden con todas las partidas, precios e impuestos de esta cotización aceptada.
                            La fecha compromiso se definirá después, durante la planificación.
                        </p>
                    </div>
                    <form method="post" action="{{ path('admin_service_orders_create_from_quotation', {id: quotation.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('service-order-create-from-quotation-' ~ quotation.id) }}">
                        <button type="submit" class="btn pf-button pf-button--primary">
                            <i class="bi bi-clipboard-plus" aria-hidden="true"></i>
                            Crear orden de servicio
                        </button>
                    </form>
                </div>
            </section>
        {% endif %}

        {% set hasVolumeDiscount = false %}
        {% for discount in quotation.discountBreakdown %}
            {% if discount.type == 'VOLUME' and discount.discount_amount|default(0) > 0 %}{% set hasVolumeDiscount = true %}{% endif %}
        {% endfor %}
        {% if hasVolumeDiscount %}
            <section class="pf-card mb-4 border-warning">
                <header class="pf-card__header">
                    <h2 class="pf-card__title">Aprobación de descuento por volumen</h2>
                    <p class="pf-card__description">La emisión, el envío formal y la aceptación permanecerán bloqueados hasta una aprobación administrativa.</p>
                </header>
                <div class="pf-card__body">
                    <div class="table-responsive mb-3">
                        <table class="table table-sm align-middle mb-0">
                            <caption class="caption-top text-muted small pt-0">Detalle de las reglas aplicadas sobre la base bruta original de cada linea de negocio.</caption>
                            <thead>
                                <tr>
                                    <th scope="col">Linea de negocio</th>
                                    <th scope="col" class="text-end">Volumen acumulado</th>
                                    <th scope="col" class="text-end">Tramo desde</th>
                                    <th scope="col" class="text-end">Porcentaje</th>
                                    <th scope="col" class="text-end">Base original</th>
                                    <th scope="col" class="text-end">Descuento</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for discount in quotation.discountBreakdown %}
                                    {% if discount.type == 'VOLUME' and discount.discount_amount|default(0) > 0 %}
                                        <tr>
                                            <th scope="row">
                                                {{ discount.category|default('Linea de negocio') }}
                                                {% if discount.rule_id|default(null) %}
                                                    <small class="d-block text-muted fw-normal">Regla #{{ discount.rule_id }}</small>
                                                {% endif %}
                                            </th>
                                            <td class="text-end text-nowrap">
                                                {{ discount.volume|default('0')|number_format(2, '.', ',') }}
                                                <small class="text-muted">{{ discount.unit|default('unid.') }}</small>
                                            </td>
                                            <td class="text-end text-nowrap">
                                                {% if discount.min_volume|default(null) is not null %}
                                                    {{ discount.min_volume|number_format(2, '.', ',') }} {{ discount.unit|default('') }}
                                                {% else %}
                                                    <span class="text-muted">No disponible</span>
                                                {% endif %}
                                            </td>
                                            <td class="text-end text-nowrap">{{ discount.percentage|default('0')|number_format(2, '.', ',') }}%</td>
                                            <td class="text-end text-nowrap">${{ discount.base_amount|default('0')|number_format(2, '.', ',') }} {{ quotation.currency }}</td>
                                            <td class="text-end text-nowrap text-success fw-semibold">-${{ discount.discount_amount|default('0')|number_format(2, '.', ',') }} {{ quotation.currency }}</td>
                                        </tr>
                                    {% endif %}
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    <div class="alert alert-warning py-2 small mb-3">Verifica el volumen, el tramo y el porcentaje antes de aprobar. La emision, el envio formal y la aceptacion permaneceran bloqueados hasta resolver esta revision.</div>
                    <div class="d-flex gap-2 flex-wrap">
                    {% if is_granted('quotations.approve_volume_discount') %}
                        <form method="post" action="{{ path('admin_quotations_approve_volume_discount', {id: quotation.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('quotation-volume-approve-' ~ quotation.id) }}">
                            <button class="btn pf-button pf-button--primary" type="submit">Aprobar descuento</button>
                        </form>
                        <form method="post" action="{{ path('admin_quotations_reject_volume_discount', {id: quotation.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('quotation-volume-reject-' ~ quotation.id) }}">
                            <input type="hidden" name="notes" value="Requiere ajustes antes de aprobar.">
                            <button class="btn pf-button pf-button--danger" type="submit">Rechazar descuento</button>
                        </form>
                    {% else %}
                        <span class="text-warning">Pendiente de aprobación por un administrador.</span>
                    {% endif %}
                    </div>
                </div>
            </section>
        {% endif %}

        {% if can_send or can_receive_decision or can_revise %}
            <section class="pf-card mb-4">
                <header class="pf-card__header quotation-actions__header">
                    <div>
                        <span class="quotation-actions__eyebrow">Seguimiento de cotización</span>
                        <h2 class="pf-card__title">Acciones comerciales</h2>
                        <p class="pf-card__description">Elige el siguiente paso. Cada cambio queda registrado en la bitácora.</p>
                    </div>
                    <span class="pf-status-badge {{ status_tones[status]|default('pf-status-badge--neutral') }}">
                        {{ quotation.status.label }}
                    </span>
                </header>
                <div class="pf-card__body quotation-actions">
                    {% if quotation.isEditable and is_granted('quotations.apply_additional_discount') %}
                        <details class="quotation-action quotation-action--additional">
                            <summary class="fw-semibold"><span>Aplicar descuento adicional</span><small>Requiere motivo</small></summary>
                            <div class="quotation-action__content">
                                <form method="post" action="{{ path('admin_quotations_additional_discount', {id: quotation.id}) }}" class="pf-form quotation-action__form">
                                    <input type="hidden" name="_token" value="{{ csrf_token('quotation-additional-discount-' ~ quotation.id) }}">
                                    <div class="row g-3">
                                        <div class="col-md-4"><label class="form-label" for="additional_discount_percentage">Porcentaje</label><input class="form-control" id="additional_discount_percentage" name="percentage" type="number" min="0" max="100" step="0.0001" required></div>
                                        <div class="col-md-8"><label class="form-label" for="additional_discount_reason">Motivo</label><input class="form-control" id="additional_discount_reason" name="reason" maxlength="5000" required></div>
                                    </div>
                                    <button type="submit" class="btn pf-button pf-button--secondary mt-3">Guardar descuento adicional</button>
                                </form>
                            </div>
                        </details>
                    {% endif %}
                    <div class="quotation-actions__grid">
                    {% if can_send and is_granted('quotations.send') %}
                        <details class="quotation-action quotation-action--send"{% if emailForm.vars.submitted %} open{% endif %}>
                            <summary class="quotation-action__summary">
                                <span class="quotation-action__icon" aria-hidden="true"><i class="bi bi-envelope-paper"></i></span>
                                <span class="quotation-action__copy"><strong>Enviar al cliente</strong><span>Prepara el correo y adjunta el PDF de esta versión.</span></span>
                                <span class="quotation-action__toggle">Completar envío <i class="bi bi-chevron-down" aria-hidden="true"></i></span>
                            </summary>
                            <div class="quotation-action__content">
                                {{ form_start(emailForm, {action: path('admin_quotations_send', {id: quotation.id}), method: 'POST', attr: {class: 'pf-form quotation-action__form'}}) }}
                                    {{ form_errors(emailForm) }}
                                    <div class="row g-3">
                                        <div class="col-md-6">{{ form_row(emailForm.recipientEmail) }}</div>
                                        <div class="col-md-6">{{ form_row(emailForm.recipientName) }}</div>
                                        <div class="col-12">{{ form_row(emailForm.copyEmail) }}</div>
                                        <div class="col-12">{{ form_row(emailForm.message) }}</div>
                                    </div>
                                    <button type="submit" class="btn pf-button pf-button--primary mt-3">Enviar cotización</button>
                                {{ form_end(emailForm) }}
                            </div>
                        </details>
                    {% endif %}

                    {% if can_receive_decision and is_granted('quotations.manage_status') %}
                        <details class="quotation-action quotation-action--accept"{% if acceptForm.vars.submitted or (decisionErrors is not empty and decisionErrorPanel == '.quotation-action--accept') %} open{% endif %}>
                            <summary class="quotation-action__summary">
                                <span class="quotation-action__icon" aria-hidden="true"><i class="bi bi-check2-circle"></i></span>
                                <span class="quotation-action__copy"><strong>Registrar aceptación</strong><span>Guarda quién aprobó y cuándo. El folio y PDF de su orden de compra son opcionales.</span></span>
                                <span class="quotation-action__toggle">Registrar <i class="bi bi-chevron-down" aria-hidden="true"></i></span>
                            </summary>
                            <div class="quotation-action__content">
                                {{ form_start(acceptForm, {action: path('admin_quotations_accept', {id: quotation.id}), method: 'POST', attr: {class: 'pf-form quotation-action__form', 'data-controller': 'ui--quotation-response'}}) }}
                                    {{ form_errors(acceptForm) }}
                                    <p class="text-secondary small mb-3">Para registrar la aceptación, agrega una observación o una referencia de evidencia. Si la respuesta fue por WhatsApp, adjunta su captura.</p>
                                    <div class="row g-3">
                                        <div class="col-md-6">{{ form_row(acceptForm.channel, {attr: {'data-ui--quotation-response-target': 'channel', 'data-action': 'change->ui--quotation-response#update'}}) }}</div>
                                        <div class="col-md-6">{{ form_row(acceptForm.contact) }}</div>
                                        <div class="col-md-6">{{ form_row(acceptForm.respondedAt) }}</div>
                                        <div class="col-12">{{ form_row(acceptForm.notes) }}</div>
                                        <div class="col-12">{{ form_row(acceptForm.evidenceReference) }}</div>
                                        <div class="col-12" data-ui--quotation-response-target="screenshot" hidden>{{ form_row(acceptForm.responseScreenshot) }}</div>
                                        <div class="col-12">
                                            <section class="quotation-action__optional-group">
                                                <div class="quotation-action__optional-heading">
                                                    <div>
                                                        <h3>Orden de compra del cliente</h3>
                                                        <p>Registra el folio y adjunta el PDF si el cliente la proporcionó.</p>
                                                    </div>
                                                    <span>Opcional</span>
                                                </div>
                                                <div class="row g-3 quotation-action__optional-fields">
                                                    <div class="col-md-6">{{ form_row(acceptForm.purchaseOrderNumber) }}</div>
                                                    <div class="col-md-6">{{ form_row(acceptForm.purchaseOrderFile) }}</div>
                                                </div>
                                            </section>
                                        </div>
                                    </div>
                                    <button type="submit" class="btn pf-button pf-button--primary mt-3">Confirmar aceptación</button>
                                {{ form_end(acceptForm) }}
                            </div>
                        </details>

                        <details class="quotation-action quotation-action--reject"{% if rejectForm.vars.submitted or (decisionErrors is not empty and decisionErrorPanel == '.quotation-action--reject') %} open{% endif %}>
                            <summary class="quotation-action__summary">
                                <span class="quotation-action__icon" aria-hidden="true"><i class="bi bi-x-circle"></i></span>
                                <span class="quotation-action__copy"><strong>Registrar rechazo</strong><span>Conserva el motivo y la evidencia de la respuesta.</span></span>
                                <span class="quotation-action__toggle">Registrar <i class="bi bi-chevron-down" aria-hidden="true"></i></span>
                            </summary>
                            <div class="quotation-action__content">
                                {{ form_start(rejectForm, {action: path('admin_quotations_reject', {id: quotation.id}), method: 'POST', attr: {class: 'pf-form quotation-action__form', 'data-controller': 'ui--quotation-response'}}) }}
                                    {{ form_errors(rejectForm) }}
                                    <p class="text-secondary small mb-3">Para registrar el rechazo, agrega una observación, una referencia o una captura de WhatsApp.</p>
                                    <div class="row g-3">
                                        <div class="col-md-6">{{ form_row(rejectForm.channel, {attr: {'data-ui--quotation-response-target': 'channel', 'data-action': 'change->ui--quotation-response#update'}}) }}</div>
                                        <div class="col-md-6">{{ form_row(rejectForm.contact) }}</div>
                                        <div class="col-md-6">{{ form_row(rejectForm.respondedAt) }}</div>
                                        <div class="col-12">{{ form_row(rejectForm.notes) }}</div>
                                        <div class="col-12">{{ form_row(rejectForm.evidenceReference) }}</div>
                                        <div class="col-12" data-ui--quotation-response-target="screenshot" hidden>{{ form_row(rejectForm.responseScreenshot) }}</div>
                                    </div>
                                    <button type="submit" class="btn pf-button pf-button--danger mt-3">Confirmar rechazo</button>
                                {{ form_end(rejectForm) }}
                            </div>
                        </details>

                        <details class="quotation-action quotation-action--cancel"{% if cancellationForm.vars.submitted %} open{% endif %}>
                            <summary class="quotation-action__summary">
                                <span class="quotation-action__icon" aria-hidden="true"><i class="bi bi-slash-circle"></i></span>
                                <span class="quotation-action__copy"><strong>Cancelar cotización</strong><span>Acción definitiva. Indica el motivo antes de confirmar.</span></span>
                                <span class="quotation-action__toggle">Revisar acción <i class="bi bi-chevron-down" aria-hidden="true"></i></span>
                            </summary>
                            <div class="quotation-action__content">
                                {{ form_start(cancellationForm, {action: path('admin_quotations_cancel', {id: quotation.id}), method: 'POST', attr: {class: 'pf-form quotation-action__form'}}) }}
                                    {{ form_errors(cancellationForm) }}
                                    {{ form_row(cancellationForm.reason) }}
                                    <button type="submit" class="btn pf-button pf-button--danger-subtle mt-3">Cancelar cotización</button>
                                {{ form_end(cancellationForm) }}
                            </div>
                        </details>
                    {% endif %}

                    {% if can_revise %}
                        <details class="quotation-action quotation-action--revision{% if not can_receive_decision %} quotation-action--full{% endif %}"{% if revisionForm.vars.submitted %} open{% endif %}>
                            <summary class="quotation-action__summary">
                                <span class="quotation-action__icon" aria-hidden="true"><i class="bi bi-arrow-repeat"></i></span>
                                <span class="quotation-action__copy"><strong>Generar nueva revisión</strong><span>Conserva esta versión como historial y abre un nuevo borrador.</span></span>
                                <span class="quotation-action__toggle">Crear revisión <i class="bi bi-chevron-down" aria-hidden="true"></i></span>
                            </summary>
                            <div class="quotation-action__content">
                                <p class="quotation-action__notice"><i class="bi bi-info-circle" aria-hidden="true"></i>La versión actual quedará marcada como reemplazada; su folio, importes y evidencia se conservarán.</p>
                                {{ form_start(revisionForm, {action: path('admin_quotations_create_revision', {id: quotation.id}), method: 'POST', attr: {class: 'pf-form quotation-revision-form'}}) }}
                                    {{ form_errors(revisionForm) }}
                                    {{ form_row(revisionForm.reason) }}
                                    <button type="submit" class="btn pf-button pf-button--secondary">Crear nueva revisión</button>
                                {{ form_end(revisionForm) }}
                            </div>
                        </details>
                    {% endif %}
                    </div>
                </div>
            </section>
        {% endif %}

        {% if quotation.revisions is not empty %}
            <section class="pf-card mb-4">
                <header class="pf-card__header">
                    <h2 class="pf-card__title">Revisión posterior</h2>
                </header>
                <div class="pf-card__body">
                    {% for revision in quotation.revisions %}
                        <a href="{{ path('admin_quotations_show', {id: revision.id}) }}">Abrir revisión {{ revision.revisionNumber }}{% if revision.folio %} · {{ revision.folio }}{% endif %}</a>
                    {% endfor %}
                </div>
            </section>
        {% endif %}

        <section class="pf-card mb-4">
            <header class="pf-card__header">
                <h2 class="pf-card__title">Partidas e importes congelados</h2>
                <p class="pf-card__description">Los Productos, especificaciones e importes corresponden a esta versión de la cotización y se muestran desde sus snapshots históricos.</p>
            </header>
            <div class="pf-card__body quotation-detail-items">
                {% for item in presentedItems %}
                    <article class="quotation-detail-item">
                        <header class="quotation-detail-item__header">
                            <span class="quotation-detail-item__number">Partida {{ item.line_number }}</span>
                            <div class="quotation-detail-item__product">
                                <h3>{{ item.product.name }}</h3>
                                {% if item.product.code %}<span>{{ item.product.code }}</span>{% endif %}
                            </div>
                        </header>
                        {% if item.product.description %}
                            <p class="quotation-detail-item__description">{{ item.product.description }}</p>
                        {% endif %}
                        {% if item.specifications is not empty %}
                            <dl class="quotation-detail-item__specifications">
                                {% for specification in item.specifications %}
                                    <div><dt>{{ specification.label }}</dt><dd>{{ specification.value }}</dd></div>
                                {% endfor %}
                            </dl>
                        {% endif %}
                        <div class="quotation-detail-item__amounts">
                            <div><span>Cantidad</span><strong>{{ item.quantity_display }}</strong></div>
                            <div><span>Precio unitario</span><strong>${{ item.unit_price|number_format(2, '.', ',') }}</strong></div>
                            <div class="quotation-detail-item__subtotal"><span>Importe</span><strong>${{ item.line_subtotal|number_format(2, '.', ',') }}</strong></div>
                        </div>
                    </article>
                {% else %}
                    <p class="quotation-detail-items__empty">Esta versión no tiene partidas registradas.</p>
                {% endfor %}
            </div>
            <div class="pf-card__body border-top">
                <dl class="row justify-content-end mb-0">
                    <dt class="col-sm-3 text-sm-end">Subtotal</dt>
                    <dd class="col-sm-2 text-sm-end">${{ quotation.subtotal|number_format(2, '.', ',') }}</dd>
                    {% for discount in quotation.discountBreakdown %}
                        <dt class="col-sm-3 text-sm-end">{{ discount.type == 'VOLUME' ? 'Por volumen' : (discount.type == 'LOYALTY' ? 'Por lealtad' : 'Descuento adicional') }} ({{ discount.percentage|number_format(2, '.', ',') }}%)</dt>
                        <dd class="col-sm-2 text-sm-end">-${{ discount.discount_amount|number_format(2, '.', ',') }}</dd>
                    {% else %}
                        <dt class="col-sm-3 text-sm-end">Descuento</dt>
                        <dd class="col-sm-2 text-sm-end">-$0.00</dd>
                    {% endfor %}
                    <dt class="col-sm-3 text-sm-end">Descuento total</dt>
                    <dd class="col-sm-2 text-sm-end">-${{ quotation.discountAmount|number_format(2, '.', ',') }}</dd>
                    <dt class="col-sm-3 text-sm-end">IVA ({{ (quotation.taxRate * 100)|number_format(2, '.', ',') }}%)</dt>
                    <dd class="col-sm-2 text-sm-end">${{ quotation.taxAmount|number_format(2, '.', ',') }}</dd>
                    <dt class="col-sm-3 text-sm-end">Total</dt>
                    <dd class="col-sm-2 text-sm-end fw-semibold">${{ quotation.total|number_format(2, '.', ',') }} {{ quotation.currency }}</dd>
                </dl>
            <div class="pf-card__body border-top quotation-detail-totals">
                <div class="quotation-detail-totals__metric"><span>Subtotal</span><strong>${{ quotation.subtotal|number_format(2, '.', ',') }}</strong></div>
                <div class="quotation-detail-totals__metric"><span>Descuento ({{ quotation.discountPercent|number_format(2, '.', ',') }}%)</span><strong>−${{ quotation.discountAmount|number_format(2, '.', ',') }}</strong></div>
                <div class="quotation-detail-totals__metric"><span>IVA ({{ (quotation.taxRate * 100)|number_format(2, '.', ',') }}%)</span><strong>${{ quotation.taxAmount|number_format(2, '.', ',') }}</strong></div>
                <div class="quotation-detail-totals__metric quotation-detail-totals__metric--grand"><span>Total</span><strong>${{ quotation.total|number_format(2, '.', ',') }} <small>{{ quotation.currency }}</small></strong></div>
            </div>
        </section>

        <section class="pf-card">
            <header class="pf-card__header">
                <h2 class="pf-card__title">Historial de envíos por correo</h2>
                <p class="pf-card__description">Solo aparecen correos aceptados por el transporte SMTP.</p>
            </header>
            <div class="pf-card__body">
                {% for dispatch in quotation.emailDispatches %}
                    <article class="border-bottom pb-3 mb-3">
                        <strong>{{ dispatch.recipientEmail }}</strong>{% if dispatch.recipientName %} · {{ dispatch.recipientName }}{% endif %}
                        <span class="d-block text-muted small">{{ dispatch.sentAt|date('d/m/Y H:i', 'America/Mexico_City') }} · {{ dispatch.sentBy.fullName }}</span>
                        {% if dispatch.copyEmail %}<span class="d-block text-muted small">Copia: {{ dispatch.copyEmail }}</span>{% endif %}
                        {% if dispatch.messageNote %}<span class="d-block mt-2" style="white-space: pre-line;">{{ dispatch.messageNote }}</span>{% endif %}
                    </article>
                {% else %}
                    <p class="mb-0 text-muted">Aún no hay envíos de correo registrados.</p>
                {% endfor %}
            </div>
        </section>
    </section>
{% endblock %}
