{% extends 'layouts/app.html.twig' %}

{% block title %}Cotizaciones | PrintFlow{% endblock %}

{% block app_navigation_active %}quotations{% endblock %}

{% block app_breadcrumb %}Comercial / Cotizaciones{% endblock %}

{% block app_content %}
    {% set status_labels = {
        'REQUEST': 'Solicitud',
        'IN_REVIEW': 'En revisión',
        'DRAFT': 'Borrador',
        'ISSUED': 'Emitida',
        'SENT': 'Enviada',
        'ACCEPTED': 'Aceptada',
        'ACCEPTED_WITH_CHANGES': 'Aceptada con cambios — requiere revisión',
        'REJECTED': 'Rechazada',
        'EXPIRED': 'Vencida',
        'CANCELLED': 'Cancelada',
        'SUPERSEDED': 'Reemplazada'
    } %}

    {% set status_tones = {
        'REQUEST': 'pf-status-badge--info',
        'IN_REVIEW': 'pf-status-badge--warning',
        'DRAFT': 'pf-status-badge--warning',
        'ISSUED': 'pf-status-badge--info',
        'SENT': 'pf-status-badge--info',
        'ACCEPTED': 'pf-status-badge--success',
        'ACCEPTED_WITH_CHANGES': 'pf-status-badge--warning',
        'REJECTED': 'pf-status-badge--danger',
        'EXPIRED': 'pf-status-badge--warning',
        'CANCELLED': 'pf-status-badge--neutral',
        'SUPERSEDED': 'pf-status-badge--neutral'
    } %}

    <section class="pf-page__content">
        <header class="pf-page-header">
            <div class="pf-page-header__content">
                <p class="pf-page-header__eyebrow">Comercial</p>
                <h1 class="pf-page-header__title">Cotizaciones</h1>
                <p class="pf-page-header__description">
                    Consulta y administra los borradores comerciales registrados en PrintFlow.
                </p>
            </div>

            {% if is_granted('quotations.create') %}
                <a
                    href="{{ path('admin_quotations_new') }}"
                    class="btn pf-button pf-button--primary"
                >
                    <i class="bi bi-file-earmark-plus" aria-hidden="true"></i>
                    Nueva cotización
                </a>
            {% endif %}
        </header>

        <section class="pf-card pf-card--padding-none">
            <div class="pf-table-responsive pf-table-responsive--flat">
                <table class="pf-table">
                    <thead>
                        <tr>
                            <th>Folio</th>
                            <th>Cliente</th>
                            <th>Estado</th>
                            <th>Vigencia</th>
                            <th class="pf-table__cell--right">Total</th>
                            <th>Última actualización</th>
                            <th class="pf-table__actions-cell">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        {% for quotation in quotations %}
                            {% set status = quotation.status.value %}

                            <tr>
                                <td>
                                    <strong class="pf-table__primary">{{ quotation.folio ?? quotation.requestReference ?? 'Borrador' }}</strong>

                                    {% if quotation.folio is null and quotation.requestReference is null %}
                                        <span class="d-block text-muted small">
                                            Registro #{{ quotation.id }}
                                        </span>
                                    {% endif %}
                                </td>

                                <td>
                                    <strong class="d-block pf-table__primary">
                                        {{ quotation.clientSnapshot.business_name ?? 'Cliente no disponible' }}
                                    </strong>

                                    {% if quotation.clientSnapshot.tax_id ?? false %}
                                        <span class="d-block text-muted small">
                                            {{ quotation.clientSnapshot.tax_id }}
                                        </span>
                                    {% endif %}
                                </td>

                                <td>
                                    <span class="pf-status-badge {{ status_tones[status]|default('pf-status-badge--neutral') }}">
                                        {{ status_labels[status]|default(status) }}
                                    </span>
                                </td>

                                <td>
                                    <time datetime="{{ quotation.expiresAt|date('c') }}">
                                        {{ quotation.expiresAt|date('d/m/Y') }}
                                    </time>
                                </td>

                                <td class="pf-table__cell--right pf-table__cell--nowrap fw-semibold">
                                    ${{ quotation.total|number_format(2, '.', ',') }}
                                </td>

                                <td>
                                    <time datetime="{{ quotation.updatedAt|date('c') }}">
                                        {{ quotation.updatedAt|date('d/m/Y') }}
                                        <span class="d-block text-muted small">
                                            {{ quotation.updatedAt|date('H:i') }}
                                        </span>
                                    </time>
                                </td>

                                <td class="pf-table__actions-cell">
                                    {% set can_edit = quotation.editable and is_granted('quotations.update') %}
                                    {% set can_download = quotation.hasBeenIssued and is_granted('quotations.download_pdf') %}

                                    <div class="pf-table__actions">
                                        {% if can_edit %}
                                            <a
                                                href="{{ path('admin_quotations_edit', {id: quotation.id}) }}"
                                                class="btn pf-button pf-button--secondary pf-button--sm"
                                            >
                                                <i class="bi bi-pencil-square" aria-hidden="true"></i>
                                                Editar
                                            </a>
                                        {% endif %}

                                        <a
                                            href="{{ path('admin_quotations_show', {id: quotation.id}) }}"
                                            class="btn pf-button pf-button--secondary pf-button--sm"
                                        >
                                            <i class="bi bi-eye" aria-hidden="true"></i>
                                            Ver
                                        </a>

                                        {% if can_download %}
                                            <a
                                                href="{{ path('admin_quotations_pdf', {id: quotation.id}) }}"
                                                class="btn pf-button pf-button--subtle pf-button--sm"
                                            >
                                                <i class="bi bi-filetype-pdf" aria-hidden="true"></i>
                                                PDF
                                            </a>
                                        {% endif %}

                                        {% if not can_edit and not can_download and not is_granted('quotations.view') %}
                                            <span class="text-muted small">Sin acciones disponibles</span>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="7" class="pf-table__empty">
                                    <div class="pf-table__empty-content">
                                        <i class="bi bi-file-earmark-text pf-table__empty-icon" aria-hidden="true"></i>
                                        <strong class="pf-table__empty-title">Aún no hay cotizaciones registradas.</strong>
                                        <span class="pf-table__empty-description">
                                            Crea el primer borrador para comenzar a cotizar.
                                        </span>

                                        {% if is_granted('quotations.create') %}
                                            <a
                                                href="{{ path('admin_quotations_new') }}"
                                                class="btn pf-button pf-button--primary"
                                            >
                                                <i class="bi bi-file-earmark-plus" aria-hidden="true"></i>
                                                Crear cotización
                                            </a>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>
    </section>
{% endblock %}
