{{ form_start(form, {
    attr: {
        class: 'pf-form',
        'data-controller': 'ui--quotation-form',
        'data-ui--quotation-form-prototype-value': form_widget(form.items.vars.prototype)|e('html_attr')
    }
}) }}
    {{ form_errors(form) }}

    <div class="row g-4">
        <div class="col-12 col-xl-8">
            <section class="pf-card h-100">
                <header class="pf-card__header">
                    <h2 class="pf-card__title">Información general</h2>
                    <p class="pf-card__description">
                        Define el cliente, vigencia y condiciones del borrador.
                    </p>
                </header>

                <div class="pf-card__body">
                    <div class="row g-3">
                        <div class="col-12 pf-form-field">
                            {{ form_row(form.client) }}
                        </div>

                        <div class="col-md-6 pf-form-field">
                            {{ form_row(form.expiresAt) }}
                        </div>

                        <div class="col-md-6 pf-form-field">
                            {{ form_row(form.discountPercent) }}
                        </div>

                        <div class="col-12 pf-form-field">
                            {{ form_row(form.notes) }}
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <div class="col-12 col-xl-4">
            <aside class="pf-card h-100">
                <div class="pf-card__body">
                    <div class="d-flex align-items-start gap-3">
                        <i class="bi bi-calculator fs-4 text-success" aria-hidden="true"></i>

                        <div>
                            <h2 class="pf-card__title">Cálculo protegido</h2>
                            <p class="pf-card__description">
                                Al guardar, PrintFlow resuelve el precio vigente por rango,
                                descuentos, IVA y total final.
                            </p>
                            <small class="text-muted">
                                Los importes se determinan exclusivamente en el servidor.
                            </small>
                        </div>
                    </div>
                </div>
            </aside>
        </div>

        <div class="col-12">
            <section class="pf-card">
                <header class="pf-card__header d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                    <div>
                        <h2 class="pf-card__title">Partidas</h2>
                        <p class="pf-card__description">
                            Agrega los conceptos comerciales y la cantidad correspondiente.
                        </p>
                    </div>

                    <button
                        type="button"
                        class="btn pf-button pf-button--secondary"
                        data-action="ui--quotation-form#addItem"
                    >
                        <i class="bi bi-plus-lg" aria-hidden="true"></i>
                        Agregar partida
                    </button>
                </header>

                <div class="pf-card__body">
                    {{ form_errors(form.items) }}

                    <div
                        class="d-grid gap-3"
                        data-ui--quotation-form-target="items"
                    >
                        {% for itemForm in form.items %}
                            <article
                                class="pf-card p-4"
                                data-ui--quotation-form-item
                            >
                                <header class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 mb-4 pb-3 border-bottom">
                                    <div>
                                        <span class="text-muted small">Partida</span>
                                        <strong class="ms-1" data-ui--quotation-form-line-number>
                                            {{ loop.index }}
                                        </strong>
                                    </div>

                                    <button
                                        type="button"
                                        class="btn pf-button pf-button--danger pf-button--sm"
                                        data-action="ui--quotation-form#removeItem"
                                    >
                                        <i class="bi bi-trash3" aria-hidden="true"></i>
                                        Eliminar
                                    </button>
                                </header>

                                <div class="row g-3">
                                    <div class="col-12 col-lg-8 pf-form-field">
                                        {{ form_row(itemForm.commercialItem) }}
                                    </div>

                                    <div class="col-12 col-lg-4 pf-form-field">
                                        {{ form_row(itemForm.quantity) }}
                                    </div>
                                </div>
                            </article>
                        {% endfor %}
                    </div>

                    <div
                        class="d-none pf-table__empty-content"
                        data-ui--quotation-form-target="emptyState"
                    >
                        <i class="bi bi-list-check pf-table__empty-icon" aria-hidden="true"></i>
                        No hay partidas. Agrega al menos una para continuar.
                    </div>
                </div>
            </section>
        </div>
    </div>

    {{ form_rest(form) }}

    <footer class="pf-form-actions">
        <a
            href="{{ path('admin_quotations_index') }}"
            class="btn pf-button pf-button--secondary"
        >
            Cancelar
        </a>

        <button type="submit" class="btn pf-button pf-button--primary">
            <i class="bi bi-check-lg" aria-hidden="true"></i>
            {{ submit_label }}
        </button>
    </footer>
{{ form_end(form, {render_rest: false}) }}