{% extends 'layouts/app.html.twig' %}
{% block title %}{{ is_protected ? 'Consultar rol' : 'Editar rol' }} | OoxCorp{% endblock %}
{% block app_navigation_active %}roles{% endblock %}
{% block app_breadcrumb %}Administración / Roles y permisos / {{ is_protected ? 'Consultar' : 'Editar' }}{% endblock %}
{% block app_content %}
<section class="pf-roles-page pf-access-page">
    <header class="pf-roles-heading pf-roles-heading--form"><div><a href="{{ path('admin_roles_index') }}" class="pf-roles-back-link"><i class="bi bi-arrow-left" aria-hidden="true"></i> Volver a roles</a><p class="pf-roles-heading__eyebrow">Administración</p><h1>{{ is_protected ? 'Consultar rol protegido' : 'Editar rol' }}</h1><p>Código técnico: <code class="pf-role-code">{{ role.code }}</code></p></div></header>
    {% if is_protected %}
        <div class="pf-access-notice"><strong>Rol protegido con acceso completo.</strong> Concede todos los permisos reconocidos, incluso los que se incorporen después; las asignaciones registradas no limitan ese acceso. No puede modificarse.</div>
        <section class="pf-role-form__card"><h2>{{ role.name }}</h2><p>{{ role.description ?: 'Sin descripción registrada.' }}</p>{% if is_granted('role.view') %}<a href="{{ path('admin_roles_show', {id: role.id}) }}">Consultar permisos registrados</a>{% endif %}</section>
    {% else %}
        {{ form_start(form, {attr: {class: 'pf-role-form'}}) }}
            {{ form_errors(form) }}
            {% set inactive_permissions = role.permissions|filter(p => not p.active) %}
            {% if inactive_permissions|length %}<div class="pf-access-notice">Este rol conserva {{ inactive_permissions|length }} permiso(s) inactivo(s), que no conceden acceso y no aparecen en el selector.</div>{% endif %}
            <div class="pf-role-form__grid">
                <section class="pf-role-form__card"><header class="pf-role-form__section-header"><span class="pf-role-form__section-icon"><i class="bi bi-shield-check" aria-hidden="true"></i></span><div><h2>Información del rol</h2><p>Actualiza el nombre y la descripción visibles para administración.</p></div></header><div class="pf-role-form__fields">{{ form_row(form.name) }}{{ form_row(form.description) }}</div></section>
                <section class="pf-role-form__card">{% include 'admin/access/roles/_permissions.html.twig' %}</section>
            </div>
            {{ form_rest(form) }}
            <footer class="pf-role-form__footer"><a href="{{ path('admin_roles_index') }}" class="btn pf-button pf-button--secondary">Cancelar</a><button type="submit" class="btn pf-button pf-button--primary"><i class="bi bi-check-lg" aria-hidden="true"></i> Guardar cambios</button></footer>
        {{ form_end(form, {render_rest: false}) }}
    {% endif %}
</section>
{% endblock %}
