{% extends 'base.html.twig' %}

{% block title %}Restablecer contraseña | PrintFlow{% endblock %}

{% block body %}
    <main>
        <h1>Restablecer contraseña</h1>
        <p>
            La cuenta de {{ managed_user.fullName }} deberá cambiar esta contraseña
            temporal al iniciar sesión.
        </p>

        {{ form_start(form) }}
            {{ form_widget(form) }}
            <button type="submit">Restablecer contraseña</button>
        {{ form_end(form) }}

        <p><a href="{{ path('admin_users_index') }}">Cancelar</a></p>
    </main>
{% endblock %}