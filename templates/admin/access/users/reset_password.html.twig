{% extends 'layouts/app.html.twig' %}

{% block title %}Restablecer contraseña | PrintFlow{% endblock %}

{% block app_navigation_active %}users{% endblock %}

{% block app_breadcrumb %}Administración / Usuarios / Contraseña{% endblock %}

{% block app_content %}
    <section class="pf-users-page">
        <header class="pf-users-heading pf-users-heading--form">
            <div>
                <a href="{{ path('admin_users_index') }}" class="pf-users-back-link">
                    <i class="bi bi-arrow-left" aria-hidden="true"></i>
                    Volver a usuarios
                </a>

                <p class="pf-users-heading__eyebrow">Administración</p>
                <h1>Restablecer contraseña</h1>
                <p>Genera un nuevo acceso temporal para <strong>{{ managed_user.fullName }}</strong>.</p>
            </div>
        </header>

        {{ form_start(form, {attr: {class: 'pf-user-form pf-user-reset-form'}}) }}
            {{ form_errors(form) }}

            <section class="pf-user-form__card">
                <header class="pf-user-form__section-header">
                    <div class="pf-user-form__section-icon">
                        <i class="bi bi-key" aria-hidden="true"></i>
                    </div>

                    <div>
                        <h2>Nueva contraseña temporal</h2>
                        <p>La persona deberá cambiarla obligatoriamente en su siguiente inicio de sesión.</p>
                    </div>
                </header>

                <div class="pf-user-form__fields">
                    {{ form_row(form.temporaryPassword.first) }}
                    {{ form_row(form.temporaryPassword.second) }}
                </div>
            </section>

            {{ form_rest(form) }}

            <footer class="pf-user-form__footer">
                <a
                    href="{{ path('admin_users_index') }}"
                    class="btn pf-button pf-button--secondary"
                >
                    Cancelar
                </a>

                <button type="submit" class="btn btn-primary pf-button">
                    <i class="bi bi-key-fill" aria-hidden="true"></i>
                    Restablecer contraseña
                </button>
            </footer>
        {{ form_end(form, {render_rest: false}) }}
    </section>
{% endblock %}