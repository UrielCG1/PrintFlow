{% extends 'layouts/app.html.twig' %}

{% block title %}{{ pageTitle }} | PrintFlow{% endblock %}

{% block app_navigation_active %}clients{% endblock %}

{% block app_breadcrumb %}{{ pageTitle }}{% endblock %}

{% block app_content %}
    <div class="pf-page__content">
        <div class="pf-page-header">
            <div class="pf-page-header__content">
                <h1 class="pf-page-header__title">{{ pageTitle }}</h1>
                <p class="pf-page-header__description">
                    La información registrada estará disponible para futuras cotizaciones y órdenes.
                </p>
            </div>

            {% if client %}
                <div class="pf-page-header__actions">
                    {% if is_granted('clients.contacts.view') %}
                        <a
                            href="{{ path('admin_client_contacts_index', { clientId: client.id }) }}"
                            class="btn pf-button pf-button--secondary"
                        >
                            <i class="bi bi-person-vcard" aria-hidden="true"></i>
                            Administrar contactos
                        </a>
                    {% endif %}

                    {% if is_granted('clients.addresses.view') %}
                        <a
                            href="{{ path('admin_client_addresses_index', { clientId: client.id }) }}"
                            class="btn pf-button pf-button--secondary"
                        >
                            <i class="bi bi-geo-alt" aria-hidden="true"></i>
                            Administrar direcciones
                        </a>
                    {% endif %}
                </div>
            {% endif %}
        </div>

        <div class="pf-card pf-clients-form-card pf-clients-form-card--wide">
            {% form_theme form 'form/printflow_theme.html.twig' %}

            {{ form_start(form, { attr: { class: 'pf-form pf-card__body' } }) }}
                <div class="pf-clients-form-section">
                    <div class="pf-clients-form-section__heading">
                        <h2>Información general</h2>
                        <p>Identifica al cliente y su clasificación comercial.</p>
                    </div>

                    <div class="pf-clients-form-grid">
                        {{ form_row(form.clientType) }}
                        {{ form_row(form.businessName) }}
                        {{ form_row(form.category) }}
                    </div>

                    <div class="pf-clients-form-grid">
                        {{ form_row(form.email) }}
                        {{ form_row(form.phone) }}
                    </div>
                </div>

                <div class="pf-clients-form-section">
                    <div class="pf-clients-form-section__heading">
                        <h2>Facturación</h2>
                        <p>Estos datos se conservarán independientes de los domicilios de entrega.</p>
                    </div>

                    {{ form_row(form.legalName) }}

                    <div class="pf-clients-form-grid">
                        {{ form_row(form.businessActivity) }}
                        {{ form_row(form.website) }}
                    </div>
                    {{ form_row(form.birthDate) }}

                    <div class="pf-clients-form-grid">
                        {{ form_row(form.taxId) }}
                        {{ form_row(form.taxRegimeCode) }}
                    </div>

                    <div class="pf-clients-form-grid">
                        {{ form_row(form.fiscalPostalCode) }}
                        {{ form_row(form.defaultCfdiUseCode) }}
                    </div>

                    {{ form_row(form.billingEmail) }}
                </div>

                <div class="pf-clients-form-section">
                    <div class="pf-clients-form-section__heading">
                        <h2>Condiciones comerciales</h2>
                        <p>El descuento se usará como propuesta inicial en cotizaciones futuras.</p>
                    </div>

                    <div class="pf-clients-form-grid">
                        {{ form_row(form.defaultDiscountPercent) }}
                    </div>
                </div>

                <div class="pf-clients-form-section">
                    <div class="pf-clients-form-section__heading">
                        <h2>Notas internas</h2>
                        <p>Información operativa que no aparecerá en documentos del cliente.</p>
                    </div>

                    {{ form_row(form.notes) }}
                </div>

                <div class="pf-form-actions">
                    <a
                        href="{{ path('admin_clients_index') }}"
                        class="btn pf-button pf-button--secondary"
                    >
                        Cancelar
                    </a>

                    <button
                        type="submit"
                        class="btn pf-button pf-button--primary"
                    >
                        <i class="bi bi-check-lg" aria-hidden="true"></i>
                        {{ client ? 'Guardar cambios' : 'Registrar cliente' }}
                    </button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
