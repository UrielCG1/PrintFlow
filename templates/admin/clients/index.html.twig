{% extends 'layouts/app.html.twig' %}

{% block app_navigation_active %}clients{% endblock %}

{% block app_breadcrumb %}Clientes{% endblock %}

{% block app_content %}
    <div class="pf-page__content">
        <div class="pf-page-header">
            <div class="pf-page-header__content">
                <h1 class="pf-page-header__title">Clientes</h1>
                <p class="pf-page-header__description">
                    Administra los clientes disponibles para cotizaciones y órdenes.
                </p>
            </div>

            {% if is_granted('clients.create') %}
                <a
                    href="{{ path('admin_clients_new') }}"
                    class="btn pf-button pf-button--primary"
                >
                    <i class="bi bi-person-plus" aria-hidden="true"></i>
                    Nuevo cliente
                </a>
            {% endif %}
        </div>

        <div class="pf-card pf-card--padding-none overflow-hidden">
            <form
                class="pf-clients-filters pf-form pf-card__body p-4 mb-0"
                method="get"
            >
                <div class="pf-form-field">
                    <label class="form-label" for="clients-search">Buscar</label>

                    <input
                        id="clients-search"
                        class="form-control"
                        type="search"
                        name="q"
                        value="{{ search }}"
                        placeholder="Nombre, RFC, correo o teléfono"
                    >
                </div>

                <div class="pf-form-field">
                    <label class="form-label" for="clients-status">Estado</label>

                    <select
                        id="clients-status"
                        class="form-select"
                        name="status"
                    >
                        <option value="active" {{ status == 'active' ? 'selected' }}>Activos</option>
                        <option value="inactive" {{ status == 'inactive' ? 'selected' }}>Inactivos</option>
                        <option value="all" {{ status == 'all' ? 'selected' }}>Todos</option>
                    </select>
                </div>

                <div class="pf-clients-filters__actions pt-2">
                    <button
                        type="submit"
                        class="btn pf-button pf-button--primary"
                    >
                        <i class="bi bi-search" aria-hidden="true"></i>
                        Buscar
                    </button>
                </div>
            </form>

            <div class="pf-table-responsive pf-table-responsive--flat mt-3">
                <table class="pf-table">
                    <thead>
                        <tr>
                            <th>Cliente</th>
                            <th>RFC</th>
                            <th>Contacto</th>
                            <th>Estado</th>
                            <th class="pf-table__actions-cell">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        {% for client in page.items %}
                            <tr>
                                <td>
                                    <strong class="pf-table__primary">
                                        {{ client.businessName }}
                                    </strong>
                                </td>

                                <td>{{ client.taxId ?: '—' }}</td>

                                <td>
                                    {% if client.email %}
                                        <div>{{ client.email }}</div>
                                    {% endif %}

                                    {% if client.phone %}
                                        <div>{{ client.phone }}</div>
                                    {% endif %}

                                    {% if not client.email and not client.phone %}
                                        —
                                    {% endif %}
                                </td>

                                <td>
                                    <span class="pf-status-badge {{ client.active ? 'pf-status-badge--success' : 'pf-status-badge--warning' }}">
                                        {{ client.active ? 'Activo' : 'Inactivo' }}
                                    </span>
                                </td>

                                <td class="pf-table__actions-cell">
                                    <div class="pf-table__actions">
                                        {% if is_granted('clients.update') %}
                                            <a
                                                href="{{ path('admin_clients_edit', { id: client.id }) }}"
                                                class="btn pf-button pf-button--secondary pf-button--sm"
                                            >
                                                Editar
                                            </a>
                                        {% endif %}

                                        {% if is_granted('clients.toggle_status') %}
                                            <form
                                                method="post"
                                                action="{{ path('admin_clients_status', { id: client.id }) }}"
                                                data-controller="ui--confirm-action"
                                                data-action="submit->ui--confirm-action#submit"
                                                data-ui--confirm-action-title-value="{{ client.isActive ? '¿Desactivar cliente?' : '¿Reactivar cliente?' }}"
                                                data-ui--confirm-action-text-value="{{ client.isActive
                                                    ? 'El cliente dejará de estar disponible para nuevos registros.'
                                                    : 'El cliente volverá a estar disponible para operar.' }}"
                                                data-ui--confirm-action-confirm-button-text-value="{{ client.isActive ? 'Sí, desactivar' : 'Sí, reactivar' }}"
                                                data-ui--confirm-action-cancel-button-text-value="Cancelar"
                                                data-ui--confirm-action-icon-value="warning"
                                            >
                                                <input
                                                    type="hidden"
                                                    name="_token"
                                                    value="{{ csrf_token('client_status_' ~ client.id) }}"
                                                >

                                                <button
                                                    type="submit"
                                                    class="btn pf-button pf-button--sm {{ client.active ? 'pf-button--danger' : 'pf-button--success' }}"
                                                >
                                                    {{ client.active ? 'Desactivar' : 'Reactivar' }}
                                                </button>
                                            </form>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="pf-table__empty py-5">
                                    No se encontraron clientes con los filtros seleccionados.
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            {% if page.pageCount > 1 %}
                <nav
                    class="pf-clients-pagination pf-table-footer"
                    aria-label="Paginación de clientes"
                >
                    {% for number in 1..page.pageCount %}
                        <a
                            href="{{ path('admin_clients_index', {
                                q: search,
                                status: status,
                                page: number
                            }) }}"
                            class="btn pf-button pf-button--sm {{ number == page.currentPage ? 'pf-button--primary' : 'pf-button--secondary' }}"
                        >
                            {{ number }}
                        </a>
                    {% endfor %}
                </nav>
            {% endif %}
        </div>
    </div>
{% endblock %}