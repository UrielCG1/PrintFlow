{% extends 'layouts/app.html.twig' %}

{% block title %}Diseño | OoxCorp{% endblock %}
{% block app_navigation_active %}design{% endblock %}
{% block app_breadcrumb %}Operación / Diseño{% endblock %}

{% block app_content %}
    <section class="pf-page__content design-page" data-controller="admin--design-queue">
        <header class="pf-page-header design-page__header">
            <div class="pf-page-header__content">
                <p class="pf-page-header__eyebrow">Primera etapa de producción</p>
                <h1 class="pf-page-header__title">Diseño</h1>
                <p class="pf-page-header__description">Prepara, revisa y libera el arte que guiará la impresión de cada partida.</p>
            </div>
        </header>

        <section class="design-metrics" aria-label="Resumen de partidas en Diseño">
            <article class="design-metric design-metric--pending">
                <span class="design-metric__icon" aria-hidden="true"><i class="bi bi-clock-history"></i></span>
                <div>
                    <h2>Pendientes</h2>
                    <strong>{{ designSummary['PENDING_REVIEW'] }}</strong>
                    <p>partidas por revisar</p>
                </div>
            </article>
            <article class="design-metric design-metric--review">
                <span class="design-metric__icon" aria-hidden="true"><i class="bi bi-palette"></i></span>
                <div>
                    <h2>En revisión</h2>
                    <strong>{{ designSummary['IN_REVIEW'] }}</strong>
                    <p>partidas en proceso</p>
                </div>
            </article>
            <article class="design-metric design-metric--blocked">
                <span class="design-metric__icon" aria-hidden="true"><i class="bi bi-exclamation-triangle"></i></span>
                <div>
                    <h2>Bloqueadas</h2>
                    <strong>{{ designSummary['BLOCKED'] }}</strong>
                    <p>requieren atención</p>
                </div>
            </article>
        </section>

        <section class="pf-card design-filter-card" aria-label="Filtros de partidas de Diseño">
            <div class="design-filters">
                <label class="design-search">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <span class="visually-hidden">Buscar orden, producto o partida</span>
                    <input
                        type="search"
                        placeholder="Orden, producto o partida..."
                        autocomplete="off"
                        data-admin--design-queue-target="search"
                        data-action="input->admin--design-queue#filter"
                    >
                </label>
                <label class="design-filter">
                    <span>Estado de diseño</span>
                    <select data-admin--design-queue-target="status" data-action="change->admin--design-queue#filter">
                        <option value="">Todos</option>
                        <option value="PENDING_REVIEW">Pendiente de Diseño</option>
                        <option value="IN_REVIEW">En revisión de Diseño</option>
                        <option value="BLOCKED">Bloqueada en Diseño</option>
                    </select>
                </label>
                <label class="design-filter">
                    <span>Archivo del cliente</span>
                    <select data-admin--design-queue-target="source" data-action="change->admin--design-queue#filter">
                        <option value="">Todos</option>
                        <option value="received">Recibido</option>
                        <option value="preparation">Requiere preparación</option>
                    </select>
                </label>
                <label class="design-filter">
                    <span>Prioridad</span>
                    <select data-admin--design-queue-target="priority" data-action="change->admin--design-queue#filter">
                        <option value="">Todas</option>
                        <option value="urgent">Urgente</option>
                        <option value="high">Alta</option>
                        <option value="normal">Normal</option>
                    </select>
                </label>
                <button class="design-clear" type="button" data-action="click->admin--design-queue#clear">Limpiar</button>
            </div>
        </section>

        <section class="pf-card design-table-card" aria-labelledby="design-queue-title">
            <div class="design-table-card__header">
                <h2 class="design-table-card__title" id="design-queue-title">
                    Partidas en cola (<span data-admin--design-queue-target="count">{{ items|length }}</span>)
                </h2>
            </div>
            <div class="design-table-scroll" role="region" aria-label="Partidas en cola" tabindex="0">
                <table class="design-table">
                    <colgroup>
                        <col class="design-table__column--order">
                        <col class="design-table__column--product">
                        <col class="design-table__column--priority">
                        <col class="design-table__column--source">
                        <col class="design-table__column--status">
                        <col class="design-table__column--action">
                    </colgroup>
                    <thead>
                        <tr>
                            <th scope="col">Orden / partida</th>
                            <th scope="col">Producto</th>
                            <th scope="col">Prioridad</th>
                            <th scope="col">Archivo del cliente</th>
                            <th scope="col">Estado de Diseño</th>
                            <th scope="col"><span class="visually-hidden">Acción</span></th>
                        </tr>
                    </thead>
                    <tbody data-admin--design-queue-target="rows">
                        {% for item in items %}
                            {% set source = item.sourceFileSnapshot ?? {} %}
                            {% set hasClientFile = source.path is defined and source.path is not empty %}
                            {% set productName = item.commercialItemSnapshot.name ?? item.commercialItem.name %}
                            {% set orderPriority = orderPriorities[item.serviceOrder.id] %}
                            {% set priorityIcon = orderPriority.value == 'urgent' ? 'bi-lightning-charge-fill' : (orderPriority.value == 'high' ? 'bi-arrow-up-circle-fill' : 'bi-dash-circle') %}
                            {% set priorityTone = orderPriority.value == 'urgent' ? 'danger' : (orderPriority.value == 'high' ? 'warning' : 'info') %}
                            <tr
                                data-design-row
                                data-status="{{ item.designStatus.value }}"
                                data-source="{{ hasClientFile ? 'received' : 'preparation' }}"
                                data-priority="{{ orderPriority.value }}"
                                data-search="{{ (item.serviceOrder.folio ~ ' ' ~ item.serviceOrder.sourceQuotationFolio ~ ' ' ~ item.trackingCode ~ ' ' ~ item.displayLineNumber ~ ' ' ~ productName)|lower }}"
                            >
                                <td data-label="Orden / partida">
                                    <div class="design-order">
                                        <strong>{{ item.serviceOrder.folio }}</strong>
                                        <span>{{ item.trackingCode }} · Partida {{ item.displayLineNumber }}</span>
                                        <span class="design-order__dates">
                                            <span><i class="bi bi-calendar3" aria-hidden="true"></i> Cotización {{ item.serviceOrder.sourceQuotation.createdAt|date('d/m/Y', 'America/Mexico_City') }}</span>
                                            <span>Orden {{ item.serviceOrder.createdAt|date('d/m/Y', 'America/Mexico_City') }}</span>
                                        </span>
                                    </div>
                                </td>
                                <td data-label="Producto"><span class="design-product" title="{{ productName }}">{{ productName }}</span></td>
                                <td data-label="Prioridad">
                                    <span class="pf-status-badge pf-status-badge--{{ priorityTone }} design-priority">
                                        <i class="bi {{ priorityIcon }}" aria-hidden="true"></i>{{ orderPriority.label }}
                                    </span>
                                </td>
                                <td data-label="Archivo del cliente">
                                    {% if hasClientFile %}
                                        <span class="design-file-status design-file-status--received"><span aria-hidden="true"></span>Recibido</span>
                                    {% else %}
                                        <span class="design-file-status design-file-status--preparation"><span aria-hidden="true"></span>Requiere preparación</span>
                                    {% endif %}
                                </td>
                                <td data-label="Estado de Diseño">
                                    <span class="design-status design-status--{{ item.designStatus.badgeTone }}">
                                        <span aria-hidden="true"></span>{{ item.designStatus.label }}
                                    </span>
                                </td>
                                <td class="design-table__action-cell" data-label="Acción">
                                    <a
                                        class="btn pf-button pf-button--secondary pf-button--sm design-review-button"
                                        href="{{ path('admin_design_show', {id: item.id}) }}"
                                        aria-label="Revisar {{ item.serviceOrder.folio }}, partida {{ item.displayLineNumber }}"
                                    >
                                        Revisar <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                    </a>
                                </td>
                            </tr>
                        {% else %}
                            <tr class="design-table__empty">
                                <td colspan="6">
                                    <span class="design-table__empty-icon" aria-hidden="true"><i class="bi bi-palette"></i></span>
                                    <strong>No hay partidas pendientes de Diseño.</strong>
                                    <span>Las partidas liberadas para Impresión ya no aparecen en esta cola.</span>
                                </td>
                            </tr>
                        {% endfor %}
                        <tr class="design-table__empty design-table__no-results" hidden data-admin--design-queue-target="noResults">
                            <td colspan="6">
                                <span class="design-table__empty-icon" aria-hidden="true"><i class="bi bi-search"></i></span>
                                <strong>No hay partidas que coincidan con los filtros.</strong>
                                <span>Prueba con otro término o limpia los filtros.</span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>
    </section>
{% endblock %}
