{% extends 'layouts/app.html.twig' %}
{% block title %}Descuentos y costeo · OoxCorp{% endblock %}
{% block app_navigation_active %}discounts{% endblock %}
{% block app_breadcrumb %}Administración / Descuentos y costeo{% endblock %}
{% block app_content %}
<div class="pf-page__content container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1">Descuentos y costeo</h1><p class="text-muted mb-0">Configura clases de cliente y tramos por línea de negocio.</p></div></div>
    {% for message in app.flashes('success') %}<div class="alert alert-success">{{ message }}</div>{% endfor %}{% for message in app.flashes('warning') %}<div class="alert alert-warning">{{ message }}</div>{% endfor %}
    <section class="card shadow-sm mb-4"><div class="card-header"><h2 class="h5 mb-0">Clases y descuento por lealtad</h2></div><div class="card-body"><div class="row g-3">{% for class in classes %}<div class="col-12 col-lg-4"><form method="post" action="{{ path('admin_discounts_class_update', {id: class.id}) }}" class="border rounded p-3"><input type="hidden" name="_token" value="{{ csrf_token('discount-class-' ~ class.id) }}"><label class="form-label">Clase {{ class.code }}</label><input class="form-control mb-2" name="name" value="{{ class.name }}" maxlength="100" required><label class="form-label">Porcentaje de lealtad</label><div class="input-group"><input class="form-control" name="percentage" type="number" min="0" max="100" step="0.0001" value="{{ class.loyaltyDiscountPercent }}" required><span class="input-group-text">%</span></div>{% if is_granted('discounts.client_classes.manage') %}<button class="btn btn-primary mt-3" type="submit">Guardar clase</button>{% endif %}</form></div>{% endfor %}</div></div></section>
    {% if is_granted('discounts.costing_profiles.manage') %}<section class="card shadow-sm mb-4"><div class="card-header"><h2 class="h5 mb-0">Crear perfil de costeo</h2></div><div class="card-body"><p class="text-muted">Crea un perfil por línea de negocio antes de registrar sus tramos de volumen.</p><form method="post" action="{{ path('admin_discounts_profile_create') }}" class="row g-3"><input type="hidden" name="_token" value="{{ csrf_token('discount-profile-create') }}"><div class="col-md-4"><label class="form-label" for="profile_category">Línea de negocio</label><select class="form-select" id="profile_category" name="commercial_category_id" required><option value="">Selecciona una categoría</option>{% for category in categories %}<option value="{{ category.id }}">{{ category.name }} ({{ category.code }})</option>{% endfor %}</select></div><div class="col-md-4"><label class="form-label" for="profile_unit">Unidad de costeo</label><select class="form-select" id="profile_unit" name="costing_unit_id" required><option value="">Selecciona una unidad</option>{% for unit in units %}<option value="{{ unit.id }}">{{ unit.name }} ({{ unit.symbol }})</option>{% endfor %}</select></div><div class="col-md-4"><label class="form-label" for="profile_method">Método de cálculo</label><select class="form-select" id="profile_method" name="calculation_method" required><option value="DIGITAL_AREA">Digital: largo × ancho × piezas</option><option value="OFFSET_SHEET_COLOR_THOUSAND">Offset: carta × colores × millar</option><option value="PROMOTIONAL_PIECE_PERSONALIZATION">Promocionales: piezas + personalización</option><option value="SCREEN_SIZE_HUNDRED_INK">Serigrafía: tamaño × cientos × tintas</option></select></div><div class="col-12"><button class="btn btn-primary" type="submit">Crear perfil</button></div></form></div></section>{% endif %}
    <section class="card shadow-sm"><div class="card-header"><h2 class="h5 mb-0">Reglas de volumen</h2></div><div class="card-body">{% if is_granted('discounts.volume_rules.manage') %}<form method="post" action="{{ path('admin_discounts_rule_create') }}" class="row g-2 align-items-end border rounded p-3 mb-4"><input type="hidden" name="_token" value="{{ csrf_token('discount-rule-create') }}"><div class="col-md-4"><label class="form-label">Perfil de costeo</label><select class="form-select" name="profile_id" required><option value="">Selecciona un perfil</option>{% for profile in profiles %}<option value="{{ profile.id }}">{{ profile.commercialCategory.name }} · {{ profile.costingUnit.symbol }}</option>{% endfor %}</select></div><div class="col-md-3"><label class="form-label">Volumen mínimo</label><input class="form-control" name="min_volume" type="number" min="0.000001" step="0.000001" required></div><div class="col-md-3"><label class="form-label">Descuento</label><div class="input-group"><input class="form-control" name="percentage" type="number" min="0" max="100" step="0.0001" required><span class="input-group-text">%</span></div></div><div class="col-md-2"><button class="btn btn-primary w-100" type="submit">Agregar</button></div></form>{% endif %}{% if rules is empty %}<div class="alert alert-info mb-0">No hay reglas configuradas. Crea primero un perfil de costeo para una línea de negocio.</div>{% else %}<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Línea</th><th>Mínimo</th><th>Descuento</th><th>Estado</th><th></th></tr></thead><tbody>{% for rule in rules %}<tr><td>{{ rule.profile.commercialCategory.name }}</td><td colspan="4"><form method="post" action="{{ path('admin_discounts_rule_update', {id: rule.id}) }}" class="row g-2 align-items-center"><input type="hidden" name="_token" value="{{ csrf_token('discount-rule-' ~ rule.id) }}"><div class="col-md-3"><input class="form-control" name="min_volume" type="number" min="0.000001" step="0.000001" value="{{ rule.minVolume }}" required></div><div class="col-md-3"><div class="input-group"><input class="form-control" name="percentage" type="number" min="0" max="100" step="0.0001" value="{{ rule.discountPercent }}" required><span class="input-group-text">%</span></div></div><div class="col-md-3"><div class="form-check"><input class="form-check-input" name="is_active" value="1" type="checkbox" {{ rule.isActive ? 'checked' }}><label class="form-check-label">Activa</label></div></div><div class="col-md-3 text-end"><button class="btn btn-outline-primary" type="submit">Guardar regla</button></div></form></td></tr>{% endfor %}</tbody></table></div>{% endif %}</div></section>
</div>
{% endblock %}
