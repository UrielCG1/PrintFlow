{% extends 'layouts/app.html.twig' %}
{% block title %}Descuentos y costeo · OoxCorp{% endblock %}
{% block app_navigation_active %}discounts{% endblock %}
{% block app_breadcrumb %}Administración / Descuentos y costeo{% endblock %}
{% block app_content %}
<div class="pf-page__content container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1">Descuentos y costeo</h1><p class="text-muted mb-0">Configura clases de cliente y tramos por línea de negocio.</p></div></div>
    {% for message in app.flashes('success') %}<div class="alert alert-success">{{ message }}</div>{% endfor %}{% for message in app.flashes('warning') %}<div class="alert alert-warning">{{ message }}</div>{% endfor %}
    <section class="card shadow-sm mb-4"><div class="card-header"><h2 class="h5 mb-0">Clases y descuento por lealtad</h2></div><div class="card-body"><div class="row g-3">{% for class in classes %}<div class="col-12 col-lg-4"><form method="post" action="{{ path('admin_discounts_class_update', {id: class.id}) }}" class="border rounded p-3"><input type="hidden" name="_token" value="{{ csrf_token('discount-class-' ~ class.id) }}"><label class="form-label">Clase {{ class.code }}</label><input class="form-control mb-2" name="name" value="{{ class.name }}" maxlength="100" required><label class="form-label">Porcentaje de lealtad</label><div class="input-group"><input class="form-control" name="percentage" type="number" min="0" max="100" step="0.0001" value="{{ class.loyaltyDiscountPercent }}" required><span class="input-group-text">%</span></div>{% if is_granted('discounts.client_classes.manage') %}<button class="btn btn-primary mt-3" type="submit">Guardar clase</button>{% endif %}</form></div>{% endfor %}</div></div></section>
    <section class="card shadow-sm"><div class="card-header"><h2 class="h5 mb-0">Reglas de volumen</h2></div><div class="card-body">{% if rules is empty %}<div class="alert alert-info mb-0">No hay reglas configuradas. Crea primero un perfil de costeo para una línea de negocio.</div>{% else %}<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Línea</th><th>Mínimo</th><th>Descuento</th><th>Estado</th><th></th></tr></thead><tbody>{% for rule in rules %}<tr><td>{{ rule.profile.commercialCategory.name }}</td><td colspan="4"><form method="post" action="{{ path('admin_discounts_rule_update', {id: rule.id}) }}" class="row g-2 align-items-center"><input type="hidden" name="_token" value="{{ csrf_token('discount-rule-' ~ rule.id) }}"><div class="col-md-3"><input class="form-control" name="min_volume" type="number" min="0.000001" step="0.000001" value="{{ rule.minVolume }}" required></div><div class="col-md-3"><div class="input-group"><input class="form-control" name="percentage" type="number" min="0" max="100" step="0.0001" value="{{ rule.discountPercent }}" required><span class="input-group-text">%</span></div></div><div class="col-md-3"><div class="form-check"><input class="form-check-input" name="is_active" value="1" type="checkbox" {{ rule.isActive ? 'checked' }}><label class="form-check-label">Activa</label></div></div><div class="col-md-3 text-end"><button class="btn btn-outline-primary" type="submit">Guardar regla</button></div></form></td></tr>{% endfor %}</tbody></table></div>{% endif %}</div></section>
</div>
{% endblock %}
