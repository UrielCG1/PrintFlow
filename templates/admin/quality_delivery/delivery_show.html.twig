{% extends 'layouts/app.html.twig' %}

{% block title %}Entrega · {{ order.folio }} | OoxCorp{% endblock %}
{% block app_navigation_active %}delivery{% endblock %}
{% block app_breadcrumb %}Operación / Entregas / {{ order.folio }}{% endblock %}

{% block app_content %}
    <section class="pf-page__content">
        <header class="pf-page-header"><div class="pf-page-header__content"><p class="pf-page-header__eyebrow">Entrega de orden liberada</p><h1 class="pf-page-header__title">{{ order.folio }}</h1><p class="pf-page-header__description">{{ order.clientSnapshot.business_name|default(order.clientSnapshot.legal_name|default('Cliente')) }} · Producción: {{ order.productionStatus.label }} · Entrega: {{ order.deliveryStatus.label }}</p></div><div class="pf-page-header__actions"><a class="btn pf-button pf-button--secondary" href="{{ path('admin_production_quality_delivery_delivery_index') }}">Volver a Entregas</a></div></header>

        <section class="pf-card mb-4"><div class="pf-card__header"><h2 class="pf-card__title">Partidas que se entregan</h2></div><div class="pf-card__body"><div class="table-responsive"><table class="pf-table"><thead><tr><th>Partida</th><th>Producto</th><th>Cantidad</th><th>Operaciones</th></tr></thead><tbody>{% for item in order.items %}<tr><td>{{ item.displayLineNumber }} · {{ item.trackingCode }}</td><td>{{ item.commercialItemSnapshot.name|default(item.commercialItem.name) }}</td><td>{{ item.quantity }}</td><td>{% for plan in item.activeOperationPlans %}{{ plan.operationSnapshot.name|default(plan.operation.name) }}{% if not loop.last %}, {% endif %}{% else %}Sin operaciones{% endfor %}</td></tr>{% endfor %}</tbody></table></div></div></section>

        <section class="pf-card mb-4"><div class="pf-card__header"><h2 class="pf-card__title">Siguiente acción</h2></div><div class="pf-card__body">
            {% if order.productionStatus.value != 'PRODUCTION_COMPLETED' %}<p class="mb-0">Calidad debe liberar Producción antes de preparar la entrega.</p>
            {% elseif order.deliveryStatus.value == 'DELIVERED' %}<p class="text-success mb-0">La entrega está confirmada.</p>
            {% elseif order.fulfillmentMethod.value == 'undefined' and canSetMethod %}
                <p>Ventas debe confirmar si el cliente recogerá en sucursal o recibirá un envío.</p>
                <form method="post" action="{{ path('admin_production_quality_delivery_set_fulfillment', {id: order.id}) }}" class="pf-form row g-3 align-items-end"><input type="hidden" name="_token" value="{{ csrf_token('delivery-method-' ~ order.id) }}"><input type="hidden" name="expected_order_version" value="{{ order.traceabilityVersion }}"><input type="hidden" name="command_id" value="{{ methodCommandId }}"><div class="col-md-5"><label class="form-label" for="fulfillment">Modalidad</label><select id="fulfillment" class="form-select" name="fulfillment_method" required><option value="">Selecciona</option><option value="pickup">Recoger en sucursal</option><option value="shipping">Envío a domicilio</option></select></div><div class="col-md-5"><label class="form-label" for="method-note">Nota de confirmación (opcional)</label><input id="method-note" class="form-control" name="note" maxlength="500"></div><div class="col-md-2"><button class="btn pf-button pf-button--primary" type="submit">Confirmar modalidad</button></div></form>
            {% elseif order.deliveryStatus.value == 'READY_FOR_SHIPMENT' and canShip %}
                <p>Registra quién envía el pedido y, si existe, el número de guía.</p>
                <form method="post" action="{{ path('admin_production_quality_delivery_ship', {id: order.id}) }}" class="pf-form row g-3 align-items-end"><input type="hidden" name="_token" value="{{ csrf_token('delivery-ship-' ~ order.id) }}"><input type="hidden" name="expected_order_version" value="{{ order.traceabilityVersion }}"><input type="hidden" name="command_id" value="{{ shipCommandId }}"><div class="col-md-4"><label class="form-label" for="carrier">Paquetería o responsable</label><input id="carrier" class="form-control" name="carrier" minlength="2" maxlength="100" required></div><div class="col-md-4"><label class="form-label" for="tracking">Número de guía (opcional)</label><input id="tracking" class="form-control" name="tracking_code" maxlength="120"></div><div class="col-md-3"><label class="form-label" for="ship-note">Nota (opcional)</label><input id="ship-note" class="form-control" name="note" maxlength="500"></div><div class="col-md-1"><button class="btn pf-button pf-button--primary" type="submit">Registrar</button></div></form>
            {% elseif order.deliveryStatus.value in ['READY_FOR_PICKUP', 'SHIPPED'] and canConfirm %}
                <p>{% if order.deliveryStatus.value == 'SHIPPED' %}Ventas puede confirmar la recepción del envío.{% else %}Ventas puede confirmar que el cliente recibió el pedido en sucursal.{% endif %}</p>
                <form method="post" action="{{ path('admin_production_quality_delivery_confirm_delivery', {id: order.id}) }}" class="pf-form row g-3 align-items-end"><input type="hidden" name="_token" value="{{ csrf_token('delivery-confirm-' ~ order.id) }}"><input type="hidden" name="expected_order_version" value="{{ order.traceabilityVersion }}"><input type="hidden" name="command_id" value="{{ confirmCommandId }}"><div class="col-md-5"><label class="form-label" for="recipient">Recibió (opcional)</label><input id="recipient" class="form-control" name="recipient" maxlength="160"></div><div class="col-md-5"><label class="form-label" for="confirm-note">Evidencia o nota (opcional)</label><input id="confirm-note" class="form-control" name="note" maxlength="500"></div><div class="col-md-2"><button class="btn pf-button pf-button--primary" type="submit">Confirmar entrega</button></div></form>
            {% else %}<p class="mb-0">Modalidad: {{ order.fulfillmentMethod.label }} · Estado: {{ order.deliveryStatus.label }}</p>{% endif %}
            {% if order.deliveryPreparationIssue %}<p class="alert alert-warning mt-3 mb-0">{{ order.deliveryPreparationIssue }}</p>{% endif %}
        </div></section>

        <section class="pf-card"><div class="pf-card__header"><h2 class="pf-card__title">Trazabilidad de entrega</h2></div><div class="pf-card__body"><ol class="mb-0">{% for event in events %}<li class="mb-2"><strong>{{ event.eventType }}</strong> · {{ event.occurredAt|date('d/m/Y H:i', 'America/Mexico_City') }}{% if event.actor %} · {{ event.actor.fullName }}{% endif %}{% if event.reason %}<span class="d-block small">{{ event.reason }}</span>{% endif %}{% if event.context.carrier|default(null) %}<span class="d-block small">{{ event.context.carrier }}{% if event.context.tracking_code|default(null) %} · Guía {{ event.context.tracking_code }}{% endif %}</span>{% endif %}{% if event.context.recipient|default(null) %}<span class="d-block small">Recibió: {{ event.context.recipient }}</span>{% endif %}</li>{% else %}<li>Sin eventos registrados.</li>{% endfor %}</ol></div></section>
    </section>
{% endblock %}
