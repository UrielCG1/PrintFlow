{% extends 'layouts/app.html.twig' %}

{% block title %}Ejecución de producción | OoxCorp{% endblock %}
{% block app_navigation_active %}production_execution{% endblock %}
{% block app_breadcrumb %}Operación / Trabajo diario / Ejecución{% endblock %}
{% block app_page_class %}pf-page--full{% endblock %}
{% block app_footer_class %}execution-footer{% endblock %}

{% block app_content %}
    {% set queueCount = stats.in_progress + stats.ready + stats.paused_blocked %}
    {% set featuredPlan = null %}
    {% for plan in plans %}
        {% if plan.id == featuredPlanId %}{% set featuredPlan = plan %}{% endif %}
    {% endfor %}
    <section class="pf-page__content production-execution" data-controller="admin--production-execution-queue">
        <header class="pf-page-header production-execution__header">
            <div class="pf-page-header__content">
                <p class="pf-page-header__eyebrow">Trabajo diario</p>
                <h1 class="pf-page-header__title">Ejecución de producción</h1>
                <p class="pf-page-header__description">
                    {% if isQueueManager %}
                        Operaciones activas ordenadas por prioridad y fecha compromiso.
                    {% else %}
                        Tus operaciones asignadas, ordenadas por prioridad y listas para avanzar.
                    {% endif %}
                </p>
            </div>
        </header>

        <div class="execution-workspace" data-admin--production-execution-queue-target="rows">
            <div class="execution-overview{{ featuredPlan ? '' : ' is-route-hidden' }}">
                <div class="execution-overview__main">
                    <section class="execution-metrics" aria-label="Resumen de operaciones">
                        <article class="execution-metric execution-metric--blue">
                            <span class="execution-metric__icon"><i class="bi bi-clock-history" aria-hidden="true"></i></span>
                            <div><h2>En curso</h2><strong>{{ stats.in_progress }}</strong><p>operación activa</p></div>
                        </article>
                        <article class="execution-metric execution-metric--green">
                            <span class="execution-metric__icon"><i class="bi bi-play-circle" aria-hidden="true"></i></span>
                            <div><h2>Listas para iniciar</h2><strong>{{ stats.ready }}</strong><p>en {{ isQueueManager ? 'la cola' : 'tu cola' }}</p></div>
                        </article>
                        <article class="execution-metric execution-metric--orange">
                            <span class="execution-metric__icon"><i class="bi bi-pause-circle" aria-hidden="true"></i></span>
                            <div><h2>Pausadas o bloqueadas</h2><strong>{{ stats.paused_blocked }}</strong><p>requieren seguimiento</p></div>
                        </article>
                    </section>

                    <section class="pf-card execution-filter-card" aria-label="Filtros de operaciones">
                        <div class="execution-filters">
                            <label class="execution-search">
                                <i class="bi bi-search" aria-hidden="true"></i>
                                <span class="visually-hidden">Buscar operación</span>
                                <input type="search" placeholder="Orden, producto u operación…" autocomplete="off" data-admin--production-execution-queue-target="search" data-action="input->admin--production-execution-queue#filter">
                            </label>
                            <label class="execution-filter"><span>Estado</span>
                                <select data-admin--production-execution-queue-target="status" data-action="change->admin--production-execution-queue#selectStatus">
                                    <option value="">Todos</option><option value="in_progress">En curso</option><option value="ready">Lista para iniciar</option><option value="paused">Pausada</option><option value="blocked">Bloqueada</option><option value="completed">Completada hoy</option>
                                </select>
                            </label>
                            <label class="execution-filter"><span>Prioridad</span>
                                <select data-admin--production-execution-queue-target="priority" data-action="change->admin--production-execution-queue#filter">
                                    <option value="">Todas</option><option value="urgent">Urgente</option><option value="high">Alta</option><option value="normal">Normal</option>
                                </select>
                            </label>
                            <label class="execution-filter"><span>Equipo</span>
                                <select data-admin--production-execution-queue-target="equipment" data-action="change->admin--production-execution-queue#filter">
                                    <option value="">Todos</option>
                                    {% for equipmentId, equipmentName in equipmentOptions %}<option value="{{ equipmentId }}">{{ equipmentName }}</option>{% endfor %}
                                </select>
                            </label>
                            <button class="execution-clear" type="button" data-action="click->admin--production-execution-queue#clear">Limpiar</button>
                        </div>
                    </section>

                    <nav class="execution-tabs" role="group" aria-label="Filtrar cola de ejecución">
                        <button class="is-active" type="button" aria-pressed="true" data-filter="queue" data-action="click->admin--production-execution-queue#selectTab">{{ isQueueManager ? 'Cola de producción' : 'Mi cola' }} <span>({{ queueCount }})</span></button>
                        <button type="button" aria-pressed="false" data-filter="in_progress" data-action="click->admin--production-execution-queue#selectTab">En curso <span>({{ stats.in_progress }})</span></button>
                        <button type="button" aria-pressed="false" data-filter="ready" data-action="click->admin--production-execution-queue#selectTab">Por iniciar <span>({{ stats.ready }})</span></button>
                        <button type="button" aria-pressed="false" data-filter="paused_blocked" data-action="click->admin--production-execution-queue#selectTab">Pausadas / bloqueadas <span>({{ stats.paused_blocked }})</span></button>
                        <button type="button" aria-pressed="false" data-filter="completed" data-action="click->admin--production-execution-queue#selectTab">Completadas hoy <span>({{ stats.completed_today }})</span></button>
                    </nav>

                    {% if featuredPlan %}
                        {% include 'admin/production_execution/_task.html.twig' with {plan: featuredPlan, isFeatured: true} %}
                    {% endif %}
                </div>

                {% if featuredPlan %}
                    <aside class="execution-route-panel" data-admin--production-execution-queue-target="routePanel" aria-label="Ruta de esta partida">
                        <h2>Ruta de esta partida</h2>
                        <ol>
                            {% for routePlan in routePlansByPlanId[featuredPlan.id]|default([]) %}
                                {% set routeLatest = routePlan.latestExecution %}
                                {% set routeIsCurrent = routePlan.id == featuredPlan.id %}
                                {% set routeState = routeIsCurrent ? taskStates[featuredPlan.id] : (routeLatest and routeLatest.status.value == 'COMPLETED' ? 'completed' : 'next') %}
                                <li class="execution-route-panel__step execution-route-panel__step--{{ routeState }}">
                                    <span class="execution-route-panel__mark"><i class="bi {{ routeState == 'completed' ? 'bi-check-lg' : (routeState == 'blocked' ? 'bi-lock-fill' : (routeState == 'in_progress' ? 'bi-play-fill' : 'bi-circle-fill')) }}" aria-hidden="true"></i></span>
                                    <span class="execution-route-panel__copy">
                                        <strong>{{ routePlan.operationSnapshot.name|default(routePlan.operation.name) }}</strong>
                                        <span>{{ routeState == 'completed' ? 'Completado' : (routeState == 'in_progress' ? 'En curso' : (routeState == 'ready' ? 'Listo para iniciar' : (routeState == 'blocked' ? 'Bloqueado' : (routeState == 'paused' ? 'Pausado' : 'Siguiente')))) }}</span>
                                        {% if routeIsCurrent and routePlan.equipment %}<small>{{ routePlan.equipmentSnapshot.name|default(routePlan.equipment.name) }}</small>{% endif %}
                                    </span>
                                </li>
                            {% endfor %}
                        </ol>
                    </aside>
                {% endif %}
            </div>

            {% if plans is empty %}
                <section class="pf-card execution-empty">
                    <span class="execution-empty__icon"><i class="bi bi-inboxes" aria-hidden="true"></i></span>
                    <h2>{{ isQueueManager ? 'No hay operaciones activas' : 'Tu cola está al día' }}</h2>
                    <p>{% if isQueueManager %}Las operaciones aparecerán cuando haya producción planificada pendiente.{% else %}Aquí aparecerán las operaciones que Producción te asigne. Si esperabas una tarea, consulta a tu supervisor.{% endif %}</p>
                </section>
            {% else %}
                <section class="execution-following" data-admin--production-execution-queue-target="following" aria-label="Siguientes operaciones">
                    <header class="execution-following__header">
                        <h2>Siguientes operaciones</h2>
                        <p>La más urgente aparece primero.</p>
                    </header>
                    <div class="execution-following__notice"><i class="bi bi-exclamation-circle-fill" aria-hidden="true"></i>Una operación bloqueada se habilita al terminar el paso anterior o al resolver su incidencia.</div>
                    <div class="execution-following__list">
                        {% for plan in plans %}
                            {% if plan.id != featuredPlanId %}
                                {% include 'admin/production_execution/_task.html.twig' with {plan: plan, isFeatured: false} %}
                            {% endif %}
                        {% endfor %}
                    </div>
                </section>
                <div class="pf-card execution-no-results" hidden data-admin--production-execution-queue-target="empty"><i class="bi bi-search" aria-hidden="true"></i><strong>No hay operaciones con esos filtros.</strong><span>Ajusta la búsqueda o limpia los filtros.</span></div>
            {% endif %}
        </div>
    </section>
{% endblock %}
