{% extends 'layouts/app.html.twig' %}

{% block title %}Productos y servicios | PrintFlow{% endblock %}
{% block app_navigation_active %}catalog_items{% endblock %}
{% block app_breadcrumb %}Catálogos / Productos y servicios{% endblock %}

{% set canSeeActions =
    is_granted('catalog.items.update')
    or is_granted('catalog.items.update_price')
    or is_granted('catalog.items.toggle_status')
    or is_granted('catalog.items.configure_characteristics')
%}

{% block app_content %}
    <div class="pf-page__content">
        {% include 'admin/catalog/_workspace_nav.html.twig' with {catalog_section: 'items'} %}

        <header class="pf-page-header pf-catalog-page-header">
            <div class="pf-page-header__content">
                <h1 class="pf-page-header__title">Productos y servicios</h1>
                <p class="pf-page-header__description">
                    Configura lo que PrintFlow puede vender: clasificación, unidad, precio y datos solicitados al cotizar.
                </p>
            </div>

            <div class="pf-page-header__actions">
                {% if is_granted('catalog.items.create') %}
                    <a href="{{ path('admin_catalog_items_new') }}" class="btn pf-button pf-button--primary">
                        <i class="bi bi-plus-lg" aria-hidden="true"></i>
                        <span>Nuevo producto o servicio</span>
                    </a>
                {% endif %}
            </div>
        </header>

        <form
            method="get"
            action="{{ path('admin_catalog_items_index') }}"
            class="pf-card pf-form pf-catalog-filters"
            aria-label="Filtros de productos y servicios"
        >
            <div class="pf-card__body">
                <div class="row g-3 align-items-end">
                    <div class="col-lg-4 pf-form-field">
                        <label for="catalog-item-search" class="form-label">Buscar</label>
                        <input
                            id="catalog-item-search"
                            type="search"
                            name="q"
                            value="{{ search }}"
                            class="form-control"
                            placeholder="Nombre, código, categoría o unidad"
                        >
                    </div>

                    <div class="col-sm-6 col-lg-2 pf-form-field">
                        <label for="catalog-item-type" class="form-label">Tipo</label>
                        <select id="catalog-item-type" name="type" class="form-select">
                            <option value="all" {{ type == 'all' ? 'selected' : '' }}>Todos</option>
                            <option value="product" {{ type == 'product' ? 'selected' : '' }}>Productos</option>
                            <option value="service" {{ type == 'service' ? 'selected' : '' }}>Servicios</option>
                        </select>
                    </div>

                    <div class="col-sm-6 col-lg-2 pf-form-field">
                        <label for="catalog-item-category" class="form-label">Categoría</label>
                        <select id="catalog-item-category" name="category" class="form-select">
                            <option value="0">Todas</option>
                            {% for category in categories %}
                                <option value="{{ category.id }}" {{ categoryId == category.id ? 'selected' : '' }}>
                                    {{ category.name }}{{ category.isActive ? '' : ' · Inactiva' }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="col-sm-6 col-lg-2 pf-form-field">
                        <label for="catalog-item-unit" class="form-label">Unidad</label>
                        <select id="catalog-item-unit" name="unit" class="form-select">
                            <option value="0">Todas</option>
                            {% for unit in measurementUnits %}
                                <option value="{{ unit.id }}" {{ measurementUnitId == unit.id ? 'selected' : '' }}>
                                    {{ unit.name }}{{ unit.isActive ? '' : ' · Inactiva' }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="col-sm-6 col-lg-2 pf-form-field">
                        <label for="catalog-item-status" class="form-label">Estado</label>
                        <select id="catalog-item-status" name="status" class="form-select">
                            <option value="active" {{ status == 'active' ? 'selected' : '' }}>Activos</option>
                            <option value="inactive" {{ status == 'inactive' ? 'selected' : '' }}>Inactivos</option>
                            <option value="all" {{ status == 'all' ? 'selected' : '' }}>Todos</option>
                        </select>
                    </div>
                </div>

                <div class="pf-catalog-filters__footer">
                    <p class="pf-catalog-filters__hint">
                        <i class="bi bi-funnel" aria-hidden="true"></i>
                        Combina filtros para localizar rápidamente una configuración comercial.
                    </p>
                    <div class="pf-catalog-filters__actions">
                        <button type="submit" class="btn pf-button pf-button--primary">
                            <i class="bi bi-search" aria-hidden="true"></i>
                            <span>Filtrar</span>
                        </button>
                        <a href="{{ path('admin_catalog_items_index') }}" class="btn pf-button pf-button--secondary">
                            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
                            <span>Limpiar</span>
                        </a>
                    </div>
                </div>
            </div>
        </form>

        <section class="pf-card pf-card--padding-none" aria-label="Listado de productos y servicios">
            <div class="pf-catalog-list-meta">
                <p class="pf-catalog-list-meta__summary">
                    {{ page.totalItems }} {{ page.totalItems == 1 ? 'registro' : 'registros' }}
                </p>
                <p class="pf-catalog-list-meta__hint">
                    <i class="bi bi-info-circle" aria-hidden="true"></i>
                    Cada fila resume su configuración; entra a Configurar para administrar el registro completo.
                </p>
            </div>

            <div class="pf-table-responsive pf-table-responsive--flat">
                <table class="pf-table pf-catalog-items-table">
                    <thead>
                        <tr>
                            <th>Producto / servicio</th>
                            <th>Configuración comercial</th>
                            <th>Precio</th>
                            <th>Características</th>
                            <th>Estado</th>
                            {% if canSeeActions %}<th class="pf-table__actions-cell">Acciones</th>{% endif %}
                        </tr>
                    </thead>

                    <tbody>
                        {% for item in page.items %}
                            {% set pricing = priceRuleSummary[item.id]|default({total: 0, active: 0}) %}
                            {% set characteristicCount = characteristicCounts[item.id]|default(0) %}
                            {% set canConfigureItem =
                                is_granted('catalog.items.update')
                                or is_granted('catalog.items.update_price')
                                or (item.type.value == 'PRODUCT' and is_granted('catalog.items.configure_characteristics'))
                            %}
                            {% set blocksReactivation = not item.isActive and (not item.category.isActive or not item.measurementUnit.isActive) %}
                            <tr>
                                <td>
                                    <div class="pf-catalog-item-cell">
                                        <div class="pf-catalog-item-cell__title-row">
                                            <span class="pf-table__primary">{{ item.name }}</span>
                                            <span class="pf-catalog-tag">{{ item.type.label }}</span>
                                        </div>
                                        <code class="pf-table__code">{{ item.code }}</code>
                                    </div>
                                </td>

                                <td>
                                    <div class="pf-catalog-stack">
                                        <span class="pf-catalog-stack__primary">{{ item.category.name }}</span>
                                        <span class="pf-catalog-stack__secondary">
                                            <i class="bi bi-rulers" aria-hidden="true"></i>
                                            {{ item.measurementUnit.name }}
                                        </span>
                                    </div>
                                </td>

                                <td>
                                    <div class="pf-catalog-stack">
                                        <span class="pf-catalog-stack__primary pf-catalog-price">MXN ${{ item.basePrice|number_format(2, '.', ',') }}</span>
                                        <span class="pf-catalog-stack__secondary">
                                            {{ pricing.active }} {{ pricing.active == 1 ? 'rango activo' : 'rangos activos' }}
                                            {% if pricing.total > pricing.active %}
                                                · {{ pricing.total - pricing.active }} {{ (pricing.total - pricing.active) == 1 ? 'inactivo' : 'inactivos' }}
                                            {% endif %}
                                        </span>
                                    </div>
                                </td>

                                <td>
                                    {% if item.type.value == 'PRODUCT' %}
                                        <div class="pf-catalog-stack">
                                            <span class="pf-catalog-stack__primary">{{ characteristicCount }} configuradas</span>
                                            <span class="pf-catalog-stack__secondary">
                                                {{ characteristicCount > 0 ? 'Datos solicitados al cotizar' : 'Sin configuración adicional' }}
                                            </span>
                                        </div>
                                    {% else %}
                                        <span class="pf-catalog-muted"><i class="bi bi-dash-circle" aria-hidden="true"></i> No aplica</span>
                                    {% endif %}
                                </td>

                                <td>
                                    <span class="pf-status-badge {{ item.isActive ? 'pf-status-badge--success' : 'pf-status-badge--warning' }}">
                                        <span class="pf-status-badge__dot" aria-hidden="true"></span>
                                        {{ item.isActive ? 'Activo' : 'Inactivo' }}
                                    </span>
                                </td>

                                {% if canSeeActions %}
                                    <td class="pf-table__actions-cell">
                                        <div class="pf-catalog-row-actions">
                                            {% if canConfigureItem %}
                                                <a href="{{ path('admin_catalog_items_configure', {id: item.id}) }}" class="btn pf-button pf-button--secondary pf-button--sm">
                                                    <i class="bi bi-sliders" aria-hidden="true"></i>
                                                    <span>Configurar</span>
                                                </a>
                                            {% endif %}

                                            {% if is_granted('catalog.items.toggle_status') %}
                                                <details class="pf-catalog-row-menu">
                                                    <summary class="pf-catalog-row-menu__trigger" aria-label="Más acciones para {{ item.name }}">
                                                        <i class="bi bi-three-dots-vertical" aria-hidden="true"></i>
                                                    </summary>
                                                    <div class="pf-catalog-row-menu__panel">
                                                        {% if blocksReactivation %}
                                                            <span class="pf-catalog-row-menu__action is-disabled" title="Activa primero la categoría comercial y la unidad de medida relacionadas.">
                                                                <i class="bi bi-lock" aria-hidden="true"></i>
                                                                Dependencias inactivas
                                                            </span>
                                                        {% else %}
                                                        <form
                                                            method="post"
                                                            action="{{ path('admin_catalog_items_status', {
                                                                id: item.id,
                                                                q: search,
                                                                type: type,
                                                                category: categoryId,
                                                                unit: measurementUnitId,
                                                                status: status,
                                                                page: page.currentPage
                                                            }) }}"
                                                            data-controller="ui--confirm-action"
                                                            data-action="submit->ui--confirm-action#submit"
                                                            data-ui--confirm-action-title-value="{{ item.isActive ? '¿Desactivar producto o servicio?' : '¿Reactivar producto o servicio?' }}"
                                                            data-ui--confirm-action-text-value="{{ item.isActive ? 'Dejará de estar disponible para nuevas cotizaciones.' : 'Volverá a estar disponible para nuevas cotizaciones si sus dependencias están activas.' }}"
                                                            data-ui--confirm-action-confirm-button-text-value="{{ item.isActive ? 'Sí, desactivar' : 'Sí, reactivar' }}"
                                                            data-ui--confirm-action-cancel-button-text-value="Cancelar"
                                                            data-ui--confirm-action-icon-value="warning"
                                                        >
                                                            <input type="hidden" name="_token" value="{{ csrf_token('catalog_item_status_' ~ item.id) }}">
                                                            <button type="submit" class="pf-catalog-row-menu__action {{ item.isActive ? 'is-danger' : 'is-success' }}">
                                                                <i class="bi {{ item.isActive ? 'bi-pause-circle' : 'bi-check-circle' }}" aria-hidden="true"></i>
                                                                <span>{{ item.isActive ? 'Desactivar' : 'Reactivar' }}</span>
                                                            </button>
                                                        </form>
                                                        {% endif %}
                                                    </div>
                                                </details>
                                            {% endif %}
                                        </div>
                                    </td>
                                {% endif %}
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="{{ canSeeActions ? 6 : 5 }}" class="pf-table__empty">
                                    <div class="pf-table__empty-content">
                                        <span class="pf-table__empty-icon" aria-hidden="true"><i class="bi bi-inbox"></i></span>
                                        <p class="pf-table__empty-title">No se encontraron productos o servicios</p>
                                        <p class="pf-table__empty-description">Modifica los filtros o registra un nuevo producto o servicio.</p>
                                        {% if is_granted('catalog.items.create') %}
                                            <div class="pf-catalog-empty__actions">
                                                <a href="{{ path('admin_catalog_items_new') }}" class="btn pf-button pf-button--primary pf-button--sm">
                                                    <i class="bi bi-plus-lg" aria-hidden="true"></i>
                                                    <span>Nuevo producto o servicio</span>
                                                </a>
                                            </div>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            {% if page.totalPages > 1 %}
                <footer class="pf-table-footer">
                    <p class="pf-table-footer__summary">Página <strong>{{ page.currentPage }}</strong> de <strong>{{ page.totalPages }}</strong></p>
                    <nav class="pf-table-footer__pagination" aria-label="Paginación de productos y servicios">
                        {% set paginationParams = {
                            q: search,
                            type: type,
                            category: categoryId,
                            unit: measurementUnitId,
                            status: status
                        } %}

                        {% if page.currentPage > 1 %}
                            <a class="btn pf-button pf-button--secondary pf-button--sm" href="{{ path('admin_catalog_items_index', paginationParams|merge({page: page.currentPage - 1})) }}">
                                <i class="bi bi-chevron-left" aria-hidden="true"></i><span>Anterior</span>
                            </a>
                        {% else %}
                            <span class="pf-button pf-button--secondary pf-button--sm disabled" aria-disabled="true"><i class="bi bi-chevron-left" aria-hidden="true"></i><span>Anterior</span></span>
                        {% endif %}

                        {% if page.currentPage < page.totalPages %}
                            <a class="btn pf-button pf-button--secondary pf-button--sm" href="{{ path('admin_catalog_items_index', paginationParams|merge({page: page.currentPage + 1})) }}">
                                <span>Siguiente</span><i class="bi bi-chevron-right" aria-hidden="true"></i>
                            </a>
                        {% else %}
                            <span class="pf-button pf-button--secondary pf-button--sm disabled" aria-disabled="true"><span>Siguiente</span><i class="bi bi-chevron-right" aria-hidden="true"></i></span>
                        {% endif %}
                    </nav>
                </footer>
            {% endif %}
        </section>
    </div>
{% endblock %}
