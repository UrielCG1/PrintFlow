{% extends 'layouts/app.html.twig' %}

{% block title %}{{ pageTitle }} | OoxCorp{% endblock %}
{% block app_navigation_active %}catalog_characteristics{% endblock %}
{% block app_breadcrumb %}Catálogos / Características de producto / {{ characteristic.name }} / {{ pageTitle }}{% endblock %}

{% block app_content %}
<div class="pf-page__content">
    {% include 'admin/catalog/_workspace_nav.html.twig' with {catalog_section: 'characteristics'} %}
    {% include 'admin/catalog/characteristics/_configuration_nav.html.twig' with {characteristic: characteristic, characteristic_configuration_section: 'options'} %}

    <header class="pf-page-header pf-catalog-page-header">
        <div class="pf-page-header__content"><h1 class="pf-page-header__title">{{ option ? pageTitle : 'Agregar opciones' }}</h1><p class="pf-page-header__description">{{ option ? 'Define un valor controlado para ' ~ characteristic.name ~ '.' : 'Captura todas las opciones de ' ~ characteristic.name ~ ' y guárdalas juntas.' }}</p></div>
    </header>

    {% if optionCodeLocked %}
        <div class="pf-catalog-technical-contract" role="note">
            <i class="bi bi-link-45deg" aria-hidden="true"></i>
            <div><strong>Código técnico en uso</strong><p>Esta opción ya está permitida en uno o más Productos. Puedes cambiar su nombre visible, pero el código queda protegido para conservar las configuraciones existentes.</p></div>
        </div>
    {% endif %}

    <div class="pf-card">
        {{ form_start(form, {attr: {class: 'pf-form pf-card__body', novalidate: 'novalidate'}}) }}
            {{ form_errors(form) }}
            {% if option %}
                <div class="row g-3"><div class="col-lg-7">{{ form_row(form.name) }}</div><div class="col-lg-5">{{ form_row(form.code) }}</div></div>
            {% else %}
                <div data-controller="ui--characteristic-options-batch">
                    {{ form_errors(form.options) }}
                    <div class="pf-catalog-option-entries" data-ui--characteristic-options-batch-target="items">
                        {% for entry in form.options %}
                            {% include 'admin/catalog/characteristics/_option_batch_row.html.twig' with {entry: entry, number: loop.index} only %}
                        {% endfor %}
                    </div>
                    <template data-ui--characteristic-options-batch-target="template">
                        {% include 'admin/catalog/characteristics/_option_batch_row.html.twig' with {entry: form.options.vars.prototype, number: '__number__'} only %}
                    </template>
                    <button type="button" class="btn pf-button pf-button--secondary pf-catalog-option-add" data-action="ui--characteristic-options-batch#add"><i class="bi bi-plus-lg" aria-hidden="true"></i><span>Agregar otra opción</span></button>
                </div>
            {% endif %}
            <div class="pf-catalog-form-note" role="note"><i class="bi bi-arrow-down-up" aria-hidden="true"></i><div><strong>Orden administrado desde la lista</strong><p>Las posiciones se ajustan con “Ordenar opciones”; no necesitas capturar números manualmente.</p></div></div>
            <div class="pf-form-actions"><a href="{{ path('admin_catalog_characteristics_options', {id: characteristic.id}) }}" class="btn pf-button pf-button--secondary">Cancelar</a><button type="submit" class="btn pf-button pf-button--primary"><i class="bi bi-check-lg" aria-hidden="true"></i><span>{{ option ? 'Guardar cambios' : 'Guardar opciones' }}</span></button></div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
