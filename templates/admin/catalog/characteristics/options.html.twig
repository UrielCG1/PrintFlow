{% extends 'layouts/app.html.twig' %}

{% block title %}Opciones de {{ characteristic.name }} | PrintFlow{% endblock %}
{% block app_navigation_active %}catalog_characteristics{% endblock %}
{% block app_breadcrumb %}Catálogo / Características de producto / {{ characteristic.name }} / Opciones{% endblock %}

{% block app_content %}
    <div class="pf-page__content">
        <header class="pf-page-header">
            <div class="pf-page-header__content">
                <h1 class="pf-page-header__title">Opciones: {{ characteristic.name }}</h1>
                <p class="pf-page-header__description">Valores controlados disponibles para esta característica de lista.</p>
            </div>
            <div class="pf-page-header__actions">
                <a href="{{ path('admin_catalog_characteristics_index') }}" class="btn pf-button pf-button--secondary">Características</a>
                {% if is_granted('catalog.characteristics.manage') %}
                    <a href="{{ path('admin_catalog_characteristics_option_new', {id: characteristic.id}) }}" class="btn pf-button pf-button--primary"><i class="bi bi-plus-lg" aria-hidden="true"></i><span>Nueva opción</span></a>
                {% endif %}
            </div>
        </header>

        <section class="pf-card pf-card--padding-none" aria-label="Opciones de característica">
            <div class="pf-table-responsive pf-table-responsive--flat">
                <table class="pf-table">
                    <thead><tr><th>Código</th><th>Opción</th><th>Orden</th><th>Estado</th>{% if is_granted('catalog.characteristics.manage') %}<th class="pf-table__actions-cell">Acciones</th>{% endif %}</tr></thead>
                    <tbody>
                        {% for option in options %}
                            <tr>
                                <td><code class="pf-table__code">{{ option.code }}</code></td>
                                <td><span class="pf-table__primary">{{ option.name }}</span></td>
                                <td>{{ option.displayOrder }}</td>
                                <td><span class="pf-status-badge {{ option.isActive ? 'pf-status-badge--success' : 'pf-status-badge--warning' }}"><span class="pf-status-badge__dot" aria-hidden="true"></span>{{ option.isActive ? 'Activa' : 'Inactiva' }}</span></td>
                                {% if is_granted('catalog.characteristics.manage') %}
                                    <td class="pf-table__actions-cell"><div class="pf-table__actions">
                                        <a href="{{ path('admin_catalog_characteristics_option_edit', {id: characteristic.id, option: option.id}) }}" class="btn pf-button pf-button--secondary pf-button--sm"><i class="bi bi-pencil-square" aria-hidden="true"></i><span>Editar</span></a>
                                        <form method="post" action="{{ path('admin_catalog_characteristics_option_status', {id: characteristic.id, option: option.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('catalog_characteristic_option_status_' ~ option.id) }}">
                                            <button type="submit" class="btn pf-button pf-button--sm {{ option.isActive ? 'pf-button--danger' : 'pf-button--success' }}"><span>{{ option.isActive ? 'Desactivar' : 'Reactivar' }}</span></button>
                                        </form>
                                    </div></td>
                                {% endif %}
                            </tr>
                        {% else %}
                            <tr><td colspan="{{ is_granted('catalog.characteristics.manage') ? 5 : 4 }}" class="pf-table__empty">Aún no hay opciones registradas.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>
    </div>
{% endblock %}
