{% extends 'layouts/app.html.twig' %}

{% block title %}Ordenar características | PrintFlow{% endblock %}
{% block app_navigation_active %}catalog_characteristics{% endblock %}
{% block app_breadcrumb %}Catálogos / Características de producto / Ordenar{% endblock %}

{% block app_content %}
<div class="pf-page__content">
    {% include 'admin/catalog/_workspace_nav.html.twig' with {catalog_section: 'characteristics'} %}
    <header class="pf-page-header pf-catalog-page-header">
        <div class="pf-page-header__content"><h1 class="pf-page-header__title">Ordenar características</h1><p class="pf-page-header__description">Define el orden general con el que se presentan las características reutilizables dentro del catálogo.</p></div>
        <div class="pf-page-header__actions"><a href="{{ path('admin_catalog_characteristics_index') }}" class="btn pf-button pf-button--primary"><i class="bi bi-check-lg" aria-hidden="true"></i><span>Terminar</span></a></div>
    </header>

    <div class="pf-catalog-order-note" role="note"><i class="bi bi-info-circle" aria-hidden="true"></i><div><strong>Modo de ordenamiento</strong><p>Los cambios se guardan automáticamente al soltar cada fila. Las características inactivas no participan en este orden.</p></div></div>

    <section class="pf-card pf-card--padding-none">
        <div class="pf-table-responsive pf-table-responsive--flat">
            <table class="pf-table pf-catalog-order-table">
                <thead><tr><th class="pf-table__cell--center" aria-label="Reordenar"></th><th>Característica</th><th>Captura</th></tr></thead>
                <tbody data-controller="ui--sortable" data-ui--sortable-url-value="{{ path('admin_catalog_characteristics_reorder') }}" data-ui--sortable-token-value="{{ csrf_token('catalog_characteristic_reorder') }}">
                    {% for characteristic in characteristics %}
                        <tr data-id="{{ characteristic.id }}" data-sortable-id="{{ characteristic.id }}">
                            <td class="pf-table__cell--center"><button type="button" class="pf-sortable__handle" title="Arrastrar para reordenar" aria-label="Arrastrar {{ characteristic.name }} para reordenar"><i class="bi bi-grip-vertical" aria-hidden="true"></i></button></td>
                            <td><div class="pf-catalog-item-cell"><span class="pf-table__primary">{{ characteristic.name }}</span><code class="pf-table__code">{{ characteristic.code }}</code></div></td>
                            <td><div class="pf-catalog-stack"><span class="pf-catalog-stack__primary">{{ characteristic.inputType.label }}</span><span class="pf-catalog-stack__secondary">{{ characteristic.unitLabel ?: 'Sin unidad visible' }}</span></div></td>
                        </tr>
                    {% else %}<tr><td colspan="3" class="pf-table__empty">No hay características activas para ordenar.</td></tr>{% endfor %}
                </tbody>
            </table>
        </div>
    </section>
</div>
{% endblock %}
