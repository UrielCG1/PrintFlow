{% extends 'layouts/app.html.twig' %}
{% block title %}{{ pageTitle }} | PrintFlow{% endblock %}
{% block app_navigation_active %}catalog_items{% endblock %}
{% block app_breadcrumb %}Catálogos / Productos y servicios / {{ item.name }} / Características / {{ pageTitle }}{% endblock %}
{% block app_content %}
<div class="pf-page__content">
    {% include 'admin/catalog/_workspace_nav.html.twig' with {catalog_section: 'items'} %}
    {% include 'admin/catalog/items/_configuration_nav.html.twig' with {item: item, item_configuration_section: 'characteristics'} %}

    <header class="pf-page-header pf-catalog-page-header">
        <div class="pf-page-header__content"><h1 class="pf-page-header__title">{{ pageTitle }}</h1><p class="pf-page-header__description">{{ characteristic.name }}{{ characteristic.unitLabel ? ' · ' ~ characteristic.unitLabel : '' }} · {{ characteristic.inputType.label }}</p></div>
    </header>

    <div class="pf-card">
        {{ form_start(form, {attr: {class: 'pf-form pf-card__body', novalidate: 'novalidate'}}) }}
            <section class="pf-form-section">
                <div class="pf-form-section__header"><h2 class="pf-form-section__title">Comportamiento en este Producto</h2><p class="pf-form-section__description">Esta configuración no modifica la definición global de la característica.</p></div>
                {{ form_row(form.isRequired) }}
            </section>

            {% if form.allowedOptions is defined %}
                <section class="pf-form-section">
                    <div class="pf-form-section__header"><h2 class="pf-form-section__title">Opciones permitidas</h2><p class="pf-form-section__description">Restringe el catálogo global a los valores que realmente puede ofrecer {{ item.name }}.</p></div>
                    {{ form_row(form.allowedOptions) }}
                </section>
            {% endif %}

            <div class="pf-catalog-form-note" role="note"><i class="bi bi-arrow-down-up" aria-hidden="true"></i><div><strong>Orden administrado desde el Producto</strong><p>El orden de captura se ajusta desde “Ordenar captura” en la lista de características del Producto.</p></div></div>

            <div class="pf-form-actions"><a href="{{ path('admin_catalog_item_characteristics_index', {item: item.id}) }}" class="btn pf-button pf-button--secondary">Cancelar</a><button type="submit" class="btn pf-button pf-button--primary"><i class="bi bi-check-lg" aria-hidden="true"></i><span>{{ configuration ? 'Guardar configuración' : 'Configurar característica' }}</span></button></div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
