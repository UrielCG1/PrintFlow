{% extends 'layouts/app.html.twig' %}

{% block title %}{{ pageTitle }} | PrintFlow{% endblock %}
{% block app_navigation_active %}material_categories{% endblock %}
{% block app_breadcrumb %}Operación / Materiales / Categorías / {{ pageTitle }}{% endblock %}

{% block app_content %}
    <div class="pf-page">
        <div class="pf-page-header">
            <div>
                <h1 class="pf-page-header__title">{{ pageTitle }}</h1>
                <p class="pf-page-header__subtitle">
                    Define una clasificación reutilizable para los materiales operativos.
                </p>
            </div>
        </div>

        <div class="pf-card">
            {% form_theme form 'form/printflow_theme.html.twig' %}

            {{ form_start(form, { attr: { class: 'pf-form', novalidate: 'novalidate' } }) }}
                {{ form_errors(form) }}

                <div class="row g-3">
                    <div class="col-md-4">
                        {{ form_row(form.code) }}
                    </div>

                    <div class="col-md-8">
                        {{ form_row(form.name) }}
                    </div>

                    <div class="col-12">
                        {{ form_row(form.description) }}
                    </div>
                </div>

                <div class="pf-form-actions mt-4">
                    <a href="{{ path('admin_material_categories_index') }}" class="btn pf-button pf-button--secondary">
                        Cancelar
                    </a>

                    <button type="submit" class="btn pf-button pf-button--primary">
                        <i class="bi bi-check-lg" aria-hidden="true"></i>
                        <span>{{ category ? 'Guardar cambios' : 'Crear categoría' }}</span>
                    </button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}