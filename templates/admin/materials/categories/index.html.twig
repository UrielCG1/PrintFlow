{% extends 'layouts/app.html.twig' %}

{% block title %}Categorías de materiales | PrintFlow{% endblock %}
{% block app_navigation_active %}material_categories{% endblock %}
{% block app_breadcrumb %}Operación / Materiales / Categorías{% endblock %}

{% block app_content %}
    <div class="pf-page">
        <div class="pf-page-header">
            <div>
                <h1 class="pf-page-header__title">Categorías de materiales</h1>
                <p class="pf-page-header__subtitle">
                    Clasifica los insumos operativos sin mezclar este catálogo con los conceptos comerciales.
                </p>
            </div>

            <div class="d-flex flex-wrap gap-2">
                {% if is_granted('materials.view') %}
                    <a href="{{ path('admin_materials_index') }}" class="btn pf-button pf-button--secondary">
                        <i class="bi bi-box-seam" aria-hidden="true"></i>
                        <span>Materiales</span>
                    </a>
                {% endif %}

                {% if is_granted('material_categories.create') %}
                    <a href="{{ path('admin_material_categories_new') }}" class="btn pf-button pf-button--primary">
                        <i class="bi bi-plus-lg" aria-hidden="true"></i>
                        <span>Nueva categoría</span>
                    </a>
                {% endif %}
            </div>
        </div>

        <form method="get" class="pf-card mb-4">
            <div class="row g-3 align-items-end">
                <div class="col-md-6">
                    <label for="material-category-search" class="form-label">Buscar</label>
                    <input
                        id="material-category-search"
                        type="search"
                        name="q"
                        value="{{ search }}"
                        class="form-control"
                        placeholder="Código, nombre o descripción"
                    >
                </div>

                <div class="col-md-3">
                    <label for="material-category-status" class="form-label">Estado</label>
                    <select id="material-category-status" name="status" class="form-select">
                        <option value="active" {{ status == 'active' ? 'selected' : '' }}>Activas</option>
                        <option value="inactive" {{ status == 'inactive' ? 'selected' : '' }}>Inactivas</option>
                        <option value="all" {{ status == 'all' ? 'selected' : '' }}>Todas</option>
                    </select>
                </div>

                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn pf-button pf-button--primary">
                        <i class="bi bi-search" aria-hidden="true"></i>
                        <span>Filtrar</span>
                    </button>

                    <a href="{{ path('admin_material_categories_index') }}" class="btn pf-button pf-button--secondary">
                        Limpiar
                    </a>
                </div>
            </div>
        </form>

        {% set canManage = is_granted('material_categories.update') or is_granted('material_categories.toggle_status') %}

        <div class="pf-card">
            <div class="pf-table-responsive">
                <table class="pf-table">
                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>Nombre</th>
                            <th>Descripción</th>
                            <th>Estado</th>
                            {% if canManage %}
                                <th class="text-end">Acciones</th>
                            {% endif %}
                        </tr>
                    </thead>
                    <tbody>
                        {% for category in page.items %}
                            <tr>
                                <td><code>{{ category.code }}</code></td>
                                <td><strong>{{ category.name }}</strong></td>
                                <td>{{ category.description ?: '—' }}</td>
                                <td>
                                    <span class="pf-status-badge {{ category.isActive ? 'pf-status-badge--success' : 'pf-status-badge--neutral' }}">
                                        {{ category.isActive ? 'Activa' : 'Inactiva' }}
                                    </span>
                                </td>

                                {% if canManage %}
                                    <td>
                                        <div class="pf-table__actions justify-content-end">
                                            {% if is_granted('material_categories.update') %}
                                                <a
                                                    href="{{ path('admin_material_categories_edit', { id: category.id }) }}"
                                                    class="btn pf-button pf-button--secondary pf-button--sm"
                                                >
                                                    <i class="bi bi-pencil-square" aria-hidden="true"></i>
                                                    <span>Editar</span>
                                                </a>
                                            {% endif %}

                                            {% if is_granted('material_categories.toggle_status') %}
                                                <form
                                                    method="post"
                                                    action="{{ path('admin_material_categories_status', {
                                                        id: category.id,
                                                        q: search,
                                                        status: status,
                                                        page: page.currentPage
                                                    }) }}"
                                                    data-controller="ui--confirm-action"
                                                    data-action="submit->ui--confirm-action#submit"
                                                    data-ui--confirm-action-title-value="{{ category.isActive ? '¿Desactivar categoría?' : '¿Reactivar categoría?' }}"
                                                    data-ui--confirm-action-text-value="{{ category.isActive
                                                        ? 'No podrás desactivarla mientras tenga materiales activos vinculados.'
                                                        : 'La categoría volverá a estar disponible para nuevos materiales.' }}"
                                                    data-ui--confirm-action-confirm-button-text-value="{{ category.isActive ? 'Sí, desactivar' : 'Sí, reactivar' }}"
                                                    data-ui--confirm-action-cancel-button-text-value="Cancelar"
                                                    data-ui--confirm-action-icon-value="warning"
                                                >
                                                    <input
                                                        type="hidden"
                                                        name="_token"
                                                        value="{{ csrf_token('material_category_status_' ~ category.id) }}"
                                                    >

                                                    <button
                                                        type="submit"
                                                        class="btn pf-button pf-button--sm {{ category.isActive ? 'pf-button--danger' : 'pf-button--success' }}"
                                                    >
                                                        <i class="bi {{ category.isActive ? 'bi-pause-circle' : 'bi-check-circle' }}" aria-hidden="true"></i>
                                                        <span>{{ category.isActive ? 'Desactivar' : 'Reactivar' }}</span>
                                                    </button>
                                                </form>
                                            {% endif %}
                                        </div>
                                    </td>
                                {% endif %}
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="{{ canManage ? 5 : 4 }}" class="text-center py-4">
                                    No se encontraron categorías con los filtros seleccionados.
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            {% if page.pageCount > 1 %}
                <nav class="mt-4" aria-label="Paginación de categorías de materiales">
                    <ul class="pagination mb-0">
                        <li class="page-item {{ page.currentPage == 1 ? 'disabled' : '' }}">
                            <a class="page-link" href="{{ path('admin_material_categories_index', {
                                q: search,
                                status: status,
                                page: page.currentPage - 1
                            }) }}">
                                Anterior
                            </a>
                        </li>

                        <li class="page-item disabled">
                            <span class="page-link">
                                Página {{ page.currentPage }} de {{ page.pageCount }}
                            </span>
                        </li>

                        <li class="page-item {{ page.currentPage == page.pageCount ? 'disabled' : '' }}">
                            <a class="page-link" href="{{ path('admin_material_categories_index', {
                                q: search,
                                status: status,
                                page: page.currentPage + 1
                            }) }}">
                                Siguiente
                            </a>
                        </li>
                    </ul>
                </nav>
            {% endif %}
        </div>
    </div>
{% endblock %}