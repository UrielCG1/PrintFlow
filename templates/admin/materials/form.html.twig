{% extends 'layouts/app.html.twig' %}

{% block title %}{{ pageTitle }} | OoxCorp{% endblock %}
{% block app_navigation_active %}materials{% endblock %}
{% block app_breadcrumb %}Operación / Materiales / {{ pageTitle }}{% endblock %}

{% block app_content %}
    <div class="pf-page__content">
        <div class="pf-page-header">
            <div class="pf-page-header__content">
                <h1 class="pf-page-header__title">{{ pageTitle }}</h1>
                <p class="pf-page-header__description">
                    {{ material ? 'Edita el tipo de material del catálogo.' : 'Crea un tipo de material en el catálogo.' }} Aquí no se registra la longitud de un rollo ni su existencia.
                </p>
            </div>
        </div>

        {% if not material and (is_granted('inventory.receive') or is_granted('inventory.adjust_stock')) %}
            <div class="alert alert-info" role="note">
                ¿El material ya está en el catálogo y quieres dar de alta un rollo? Ve a <a href="{{ path('admin_inventory_receipts_new') }}" class="alert-link">Inventario → Recibir material</a>: selecciona el material y su ancho, y captura los metros que contiene ese rollo.
            </div>
        {% endif %}

        <div class="pf-card">
            {% form_theme form 'form/printflow_theme.html.twig' %}

            {{ form_start(form, { attr: { class: 'pf-form pf-card__body', novalidate: 'novalidate' } }) }}
                {{ form_errors(form) }}

                <section class="pf-form-section">
                    <h2 class="pf-form-section__title">Identificación</h2>
                    <p class="pf-form-section__description">
                        El código identifica al material dentro de OoxCorp y no se reutiliza.
                    </p>

                    <div class="row g-3">
                        <div class="col-md-4 pf-form-field">
                            {{ form_row(form.code) }}
                        </div>

                        <div class="col-md-8 pf-form-field">
                            {{ form_row(form.name) }}
                        </div>

                        <div class="col-12 pf-form-field">
                            {{ form_row(form.description) }}
                        </div>
                    </div>
                </section>

                <section class="pf-form-section">
                    <h2 class="pf-form-section__title">Clasificación y unidad</h2>
                    <p class="pf-form-section__description">
                        Solo se pueden guardar relaciones activas para mantener el catálogo operativo consistente.
                    </p>

                    <div class="row g-3">
                        <div class="col-md-6 pf-form-field">
                            {{ form_row(form.category) }}
                        </div>

                        <div class="col-md-6 pf-form-field">
                            {{ form_row(form.measurementUnit) }}
                        </div>
                    </div>
                </section>

                <section class="pf-form-section">
                    <h2 class="pf-form-section__title">Parámetros operativos</h2>
                    <p class="pf-form-section__description">
                        El costo es de referencia y el stock mínimo es únicamente un umbral para alertas futuras.
                    </p>

                    <div class="row g-3">
                        <div class="col-md-6 pf-form-field">
                            {{ form_row(form.referenceCost) }}
                        </div>

                        <div class="col-md-6 pf-form-field">
                            {{ form_row(form.minimumStock) }}
                        </div>
                    </div>
                </section>

                <section class="pf-form-section">
                    <h2 class="pf-form-section__title">Abastecimiento</h2>
                    <p class="pf-form-section__description">
                        El proveedor principal es opcional y no crea órdenes de compra ni condiciones comerciales.
                    </p>

                    <div class="row g-3">
                        <div class="col-md-6 pf-form-field">
                            {{ form_row(form.primarySupplier) }}
                        </div>

                        <div class="col-12 pf-form-field">
                            {{ form_row(form.notes) }}
                        </div>
                    </div>
                </section>

                <div class="pf-form-actions">
                    <a
                        href="{{ path('admin_materials_index') }}"
                        class="btn pf-button pf-button--secondary"
                    >
                        Cancelar
                    </a>

                    <button
                        type="submit"
                        class="btn pf-button pf-button--primary"
                    >
                        <i class="bi bi-check-lg" aria-hidden="true"></i>
                        <span>{{ material ? 'Guardar cambios' : 'Registrar material' }}</span>
                    </button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
