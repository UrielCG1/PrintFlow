{% extends 'layouts/app.html.twig' %}

{% block title %}Rutas de producción | OoxCorp{% endblock %}
{% block app_navigation_active %}production_routes{% endblock %}
{% block app_breadcrumb %}Operación / Producción / Rutas{% endblock %}

{% block app_content %}
<div class="pf-page__content">
    <header class="pf-page-header">
        <div class="pf-page-header__content">
            <p class="pf-page-header__eyebrow">Operación / Producción</p>
            <h1 class="pf-page-header__title">Rutas de producción</h1>
            <p class="pf-page-header__description">Define rutas base reutilizables y publica una versión independiente por Producto. Las órdenes existentes conservan su snapshot.</p>
        </div>
        <div class="pf-page-header__actions">
            <a class="btn pf-button pf-button--primary" href="{{ path('admin_production_routes_new') }}"><i class="bi bi-plus-lg" aria-hidden="true"></i><span>Nueva ruta base</span></a>
        </div>
    </header>

    <section class="pf-card mb-4" aria-labelledby="route-products-heading">
        <header class="pf-card__header"><h2 class="pf-card__title" id="route-products-heading">Productos fabricados</h2><p class="pf-card__description">Configurar ruta permite elegir una plantilla, ajustar sus pasos para ese Producto y publicar una nueva versión.</p></header>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th>Producto</th><th>Ruta publicada</th><th>Versión</th><th class="text-end">Acción</th></tr></thead>
                <tbody>
                {% for item in products %}
                    <tr>
                        <td><strong>{{ item.name }}</strong><span class="d-block text-muted small">{{ item.code }}</span></td>
                        <td>{{ item.currentRouteVersion ? item.currentRouteVersion.nameSnapshot : 'Sin ruta publicada' }}</td>
                        <td>{{ item.currentRouteVersion ? 'v' ~ item.currentRouteVersion.versionNumber : '—' }}</td>
                        <td class="text-end"><a class="btn pf-button pf-button--secondary pf-button--sm" href="{{ path('admin_production_routes_product', {id: item.id}) }}">{{ item.currentRouteVersion ? 'Editar y publicar versión' : 'Configurar ruta' }}</a></td>
                    </tr>
                {% else %}
                    <tr><td colspan="4" class="text-muted">No hay Productos activos en el catálogo del cotizador.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </section>

    <section class="pf-card">
        <header class="pf-card__header"><h2 class="pf-card__title">Rutas base reutilizables</h2><p class="pf-card__description">Al publicarse para un Producto, los pasos se copian como una versión propia. Cambiar la plantilla no altera versiones publicadas.</p></header>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th>Código</th><th>Nombre</th><th>Pasos</th><th>Estado</th><th class="text-end">Acción</th></tr></thead>
                <tbody>
                {% for template in templates %}
                    <tr>
                        <td><code>{{ template.code }}</code></td><td>{{ template.name }}</td><td>{{ template.steps|length }}</td>
                        <td>{{ template.isActive ? 'Activa' : 'Inactiva' }}</td>
                        <td class="text-end"><a class="btn pf-button pf-button--secondary pf-button--sm" href="{{ path('admin_production_routes_edit', {id: template.id}) }}">Editar</a></td>
                    </tr>
                {% else %}
                    <tr><td colspan="5" class="text-muted">Aún no hay rutas base configuradas.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
</div>
{% endblock %}
