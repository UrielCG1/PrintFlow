{% extends 'layouts/app.html.twig' %}

{% block title %}Operaciones | PrintFlow{% endblock %}
{% block app_navigation_active %}operations{% endblock %}
{% block app_breadcrumb %}Operación / Operaciones{% endblock %}

{% set canManage = is_granted('operations.update') or is_granted('operations.toggle_status') %}
{% set canReorder = is_granted('operations.reorder') and status == 'active' and search is empty and selectedArea is not null and selectedArea.isActive %}

{% block app_content %}
    <div class="pf-page">
        <div class="pf-page-header">
            <div>
                <h1 class="pf-page-header__title">Operaciones</h1>
                <p class="pf-page-header__subtitle">
                    Administra las etapas reutilizables del taller. Su orden es sugerido por área y no impone el flujo de una orden futura.
                </p>
            </div>

            <div class="d-flex flex-wrap gap-2">
                {% if is_granted('operation_areas.view') %}
                    <a href="{{ path('admin_operation_areas_index') }}" class="btn pf-button pf-button--secondary">
                        <i class="bi bi-diagram-2" aria-hidden="true"></i>
                        <span>Áreas operativas</span>
                    </a>
                {% endif %}
                {% if is_granted('operations.create') %}
                    <a href="{{ path('admin_operations_new') }}" class="btn pf-button pf-button--primary">
                        <i class="bi bi-plus-lg" aria-hidden="true"></i>
                        <span>Nueva operación</span>
                    </a>
                {% endif %}
            </div>
        </div>

        <form method="get" class="pf-card mb-4">
            <div class="row g-3 align-items-end">
                <div class="col-lg-4">
                    <label for="operation-search" class="form-label">Buscar</label>
                    <input
                        id="operation-search"
                        type="search"
                        name="q"
                        value="{{ search }}"
                        class="form-control"
                        placeholder="Código o nombre"
                    >
                </div>

                <div class="col-md-4 col-lg-3">
                    <label for="operation-area" class="form-label">Área operativa</label>
                    <select id="operation-area" name="area" class="form-select">
                        <option value="">Todas las áreas</option>
                        {% for operationArea in operationAreas %}
                            <option value="{{ operationArea.id }}" {{ selectedArea and selectedArea.id == operationArea.id ? 'selected' : '' }}>
                                {{ operationArea.code }} — {{ operationArea.name }}{{ operationArea.isActive ? '' : ' (inactiva)' }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="col-md-4 col-lg-2">
                    <label for="operation-status" class="form-label">Estado</label>
                    <select id="operation-status" name="status" class="form-select">
                        <option value="active" {{ status == 'active' ? 'selected' : '' }}>Activas</option>
                        <option value="inactive" {{ status == 'inactive' ? 'selected' : '' }}>Inactivas</option>
                        <option value="all" {{ status == 'all' ? 'selected' : '' }}>Todas</option>
                    </select>
                </div>

                <div class="col-md-8 col-lg-3 d-flex gap-2">
                    <button type="submit" class="btn pf-button pf-button--primary">
                        <i class="bi bi-search" aria-hidden="true"></i>
                        <span>Filtrar</span>
                    </button>
                    <a href="{{ path('admin_operations_index') }}" class="btn pf-button pf-button--secondary">Limpiar</a>
                </div>
            </div>
        </form>

        <div class="pf-card">
            {% if canReorder %}
                <p class="small text-body-secondary mb-3">
                    Arrastra las operaciones activas dentro de <strong>{{ selectedArea.name }}</strong> para cambiar el orden sugerido de esta área.
                </p>
            {% elseif is_granted('operations.reorder') and status == 'active' and search is empty %}
                <p class="small text-body-secondary mb-3">
                    Selecciona una sola área activa para habilitar el reordenamiento. No se permiten movimientos entre áreas por arrastre.
                </p>
            {% endif %}

            <div class="pf-table-responsive">
                <table class="pf-table">
                    <thead>
                        <tr>
                            {% if canReorder %}<th class="text-center" aria-label="Reordenar"></th>{% endif %}
                            <th>Código</th>
                            <th>Operación</th>
                            <th>Área</th>
                            <th>Descripción</th>
                            <th>Orden en área</th>
                            <th>Estado</th>
                            {% if canManage %}<th class="text-end">Acciones</th>{% endif %}
                        </tr>
                    </thead>
                    <tbody
                        {% if canReorder %}
                            data-controller="ui--sortable"
                            data-ui--sortable-url-value="{{ path('admin_operations_reorder', {id: selectedArea.id}) }}"
                            data-ui--sortable-token-value="{{ csrf_token('operation_reorder_' ~ selectedArea.id) }}"
                        {% endif %}
                    >
                        {% for operation in page.items %}
                            <tr data-id="{{ operation.id }}" data-sortable-id="{{ operation.id }}">
                                {% if canReorder %}
                                    <td class="text-center">
                                        <button
                                            type="button"
                                            class="pf-sortable__handle"
                                            title="Arrastrar para reordenar"
                                            aria-label="Arrastrar {{ operation.name }} para reordenar"
                                        >
                                            <i class="bi bi-grip-vertical" aria-hidden="true"></i>
                                        </button>
                                    </td>
                                {% endif %}
                                <td><code>{{ operation.code }}</code></td>
                                <td>{{ operation.name }}</td>
                                <td>{{ operation.operationArea.name }}</td>
                                <td>{{ operation.description ?: '—' }}</td>
                                <td>{{ operation.displayOrder }}</td>
                                <td>
                                    <span class="pf-status-badge {{ operation.isActive ? 'pf-status-badge--success' : 'pf-status-badge--neutral' }}">
                                        {{ operation.isActive ? 'Activa' : 'Inactiva' }}
                                    </span>
                                </td>
                                {% if canManage %}
                                    <td>
                                        <div class="pf-table__actions justify-content-end">
                                            {% if is_granted('operations.update') %}
                                                <a href="{{ path('admin_operations_edit', {id: operation.id}) }}" class="btn pf-button pf-button--secondary pf-button--sm">
                                                    <i class="bi bi-pencil-square" aria-hidden="true"></i>
                                                    <span>Editar</span>
                                                </a>
                                            {% endif %}
                                            {% if is_granted('operations.toggle_status') %}
                                                <form
                                                    method="post"
                                                    action="{{ path('admin_operations_status', {id: operation.id, q: search, area: selectedArea ? selectedArea.id : null, status: status, page: page.currentPage}) }}"
                                                    data-controller="ui--confirm-action"
                                                    data-action="submit->ui--confirm-action#submit"
                                                    data-ui--confirm-action-title-value="{{ operation.isActive ? '¿Desactivar operación?' : '¿Reactivar operación?' }}"
                                                    data-ui--confirm-action-text-value="{{ operation.isActive
                                                        ? 'La operación dejará de estar disponible para órdenes futuras y conservará su historial.'
                                                        : 'La operación volverá a estar disponible si su área está activa.' }}"
                                                    data-ui--confirm-action-confirm-button-text-value="{{ operation.isActive ? 'Sí, desactivar' : 'Sí, reactivar' }}"
                                                    data-ui--confirm-action-cancel-button-text-value="Cancelar"
                                                    data-ui--confirm-action-icon-value="warning"
                                                >
                                                    <input type="hidden" name="_token" value="{{ csrf_token('operation_status_' ~ operation.id) }}">
                                                    <button type="submit" class="btn pf-button pf-button--sm {{ operation.isActive ? 'pf-button--danger' : 'pf-button--success' }}">
                                                        <i class="bi {{ operation.isActive ? 'bi-pause-circle' : 'bi-check-circle' }}" aria-hidden="true"></i>
                                                        <span>{{ operation.isActive ? 'Desactivar' : 'Reactivar' }}</span>
                                                    </button>
                                                </form>
                                            {% endif %}
                                        </div>
                                    </td>
                                {% endif %}
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="{{ canManage ? (canReorder ? 8 : 7) : (canReorder ? 7 : 6) }}" class="text-center py-4">
                                    No se encontraron operaciones con los filtros seleccionados.
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            {% if page.totalPages > 1 %}
                <nav class="mt-4" aria-label="Paginación de operaciones">
                    <ul class="pagination mb-0">
                        <li class="page-item {{ page.currentPage == 1 ? 'disabled' : '' }}">
                            <a class="page-link" href="{{ path('admin_operations_index', {q: search, area: selectedArea ? selectedArea.id : null, status: status, page: page.currentPage - 1}) }}">Anterior</a>
                        </li>
                        <li class="page-item disabled"><span class="page-link">Página {{ page.currentPage }} de {{ page.totalPages }}</span></li>
                        <li class="page-item {{ page.currentPage == page.totalPages ? 'disabled' : '' }}">
                            <a class="page-link" href="{{ path('admin_operations_index', {q: search, area: selectedArea ? selectedArea.id : null, status: status, page: page.currentPage + 1}) }}">Siguiente</a>
                        </li>
                    </ul>
                </nav>
            {% endif %}
        </div>
    </div>
{% endblock %}
