{% extends 'layouts/app.html.twig' %}

{% block title %}{{ pageTitle }} | PrintFlow{% endblock %}
{% block app_navigation_active %}operations{% endblock %}
{% block app_breadcrumb %}Operación / {{ pageTitle }}{% endblock %}

{% block app_content %}
    <div class="pf-page__content">
        <div class="pf-page-header">
            <div class="pf-page-header__content">
                <h1 class="pf-page-header__title">{{ pageTitle }}</h1>
                <p class="pf-page-header__description">
                    Define un área reutilizable para agrupar las operaciones reales del taller.
                </p>
            </div>
        </div>

        <div class="pf-card">
            {% form_theme form 'form/printflow_theme.html.twig' %}

            {{ form_start(form, {attr: {class: 'pf-form pf-card__body', novalidate: 'novalidate'}}) }}
                <section class="pf-form-section">
                    <h2 class="pf-form-section__title">Clasificación e identificación</h2>
                    <p class="pf-form-section__description">
                        Una operación pertenece a un área. Si se cambia de área al editarla, se colocará al final del orden sugerido del área destino.
                    </p>

                    <div class="row g-3">
                        <div class="col-md-6 pf-form-field">{{ form_row(form.operationArea) }}</div>
                        <div class="col-md-6 pf-form-field">{{ form_row(form.code) }}</div>
                        <div class="col-12 pf-form-field">{{ form_row(form.name) }}</div>
                    </div>
                </section>

                <section class="pf-form-section">
                    <h2 class="pf-form-section__title">Alcance</h2>
                    <p class="pf-form-section__description">
                        El orden se administra desde el listado. La capacidad y el tiempo estimado se modelarán después.
                    </p>

                    {{ form_row(form.description) }}
                </section>

                <div class="pf-form-actions">
                    <a
                        href="{{ path('admin_operation_areas_index') }}"
                        class="btn pf-button pf-button--secondary"
                    >
                        Cancelar
                    </a>

                    <button
                        type="submit"
                        class="btn pf-button pf-button--primary"
                    >
                        <i class="bi bi-check-lg" aria-hidden="true"></i>
                        <span>{{ operation ? 'Guardar cambios' : 'Crear operación' }}</span>
                    </button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}