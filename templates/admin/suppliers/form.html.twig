{% extends 'layouts/app.html.twig' %}

{% block title %}{{ pageTitle }} | PrintFlow{% endblock %}
{% block app_navigation_active %}suppliers{% endblock %}
{% block app_breadcrumb %}Operación / Proveedores / {{ pageTitle }}{% endblock %}

{% block app_content %}
    <div class="pf-page__content">
        <div class="pf-page-header">
            <div class="pf-page-header__content">
                <h1 class="pf-page-header__title">{{ pageTitle }}</h1>
                <p class="pf-page-header__description">
                    Registra la información de identificación y contacto del proveedor.
                </p>
            </div>
        </div>

        <div class="pf-card">
            {% form_theme form 'form/printflow_theme.html.twig' 'form/client_collections_theme.html.twig' %}

            {{ form_start(form, { attr: { class: 'pf-form pf-card__body', novalidate: 'novalidate' } }) }}
                <section class="pf-form-section">
                    <h2 class="pf-form-section__title">Identificación</h2>
                    <p class="pf-form-section__description">
                        El código identifica al proveedor dentro de PrintFlow y no se reutiliza.
                    </p>

                    <div class="row g-3">
                        <div class="col-md-4 pf-form-field">
                            {{ form_row(form.code) }}
                        </div>

                        <div class="col-md-8 pf-form-field">
                            {{ form_row(form.businessName) }}
                        </div>

                        <div class="col-md-8 pf-form-field">
                            {{ form_row(form.legalName) }}
                        </div>

                        <div class="col-md-4 pf-form-field">
                            {{ form_row(form.taxId) }}
                        </div>
                        <div class="col-md-4 pf-form-field">{{ form_row(form.taxRegimeCode) }}</div>
                        <div class="col-md-4 pf-form-field">{{ form_row(form.defaultCfdiUseCode) }}</div>
                        <div class="col-md-4 pf-form-field">{{ form_row(form.billingEmail) }}</div>
                        <div class="col-md-6 pf-form-field">{{ form_row(form.businessActivity) }}</div>
                        <div class="col-md-6 pf-form-field">{{ form_row(form.website) }}</div>
                    </div>
                </section>

                <section class="pf-form-section">
                    <h2 class="pf-form-section__title">Contacto general</h2>
                    <p class="pf-form-section__description">
                        Estos datos no sustituyen contactos ni direcciones; esos catálogos se evaluarán en una subfase posterior.
                    </p>

                    <div class="row g-3">
                        <div class="col-md-6 pf-form-field">
                            {{ form_row(form.email) }}
                        </div>

                    </div>
                    {{ form_widget(form.phones) }}
                </section>

                <section class="pf-form-section">
                    <h2 class="pf-form-section__title">Sucursales, domicilios y contactos</h2>
                    <p class="pf-form-section__description">Agrega establecimientos, domicilios fiscales, comerciales o de entrega, teléfonos, fax y personas de contacto.</p>
                    {{ form_widget(form.branches) }}
                </section>

                <section class="pf-form-section">
                    <h2 class="pf-form-section__title">Notas internas</h2>
                    <p class="pf-form-section__description">
                        Usa este campo solo para observaciones operativas; no crea condiciones de compra ni vínculos con materiales.
                    </p>

                    {{ form_row(form.notes) }}
                </section>

                <div class="pf-form-actions">
                    <a
                        href="{{ path('admin_suppliers_index') }}"
                        class="btn pf-button pf-button--secondary"
                    >
                        Cancelar
                    </a>

                    <button
                        type="submit"
                        class="btn pf-button pf-button--primary"
                    >
                        <i class="bi bi-check-lg" aria-hidden="true"></i>
                        <span>{{ supplier ? 'Guardar cambios' : 'Registrar proveedor' }}</span>
                    </button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
