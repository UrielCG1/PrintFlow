{% extends 'layouts/app.html.twig' %}

{% block title %}Inventario | OoxCorp{% endblock %}
{% block app_navigation_active %}inventory{% endblock %}
{% block app_breadcrumb %}Operación / Inventario{% endblock %}

{% block app_content %}
    <div class="pf-page__content">
        <div class="pf-page-header pf-inventory-page-header">
            <div class="pf-page-header__content">
                <h1 class="pf-page-header__title">Inventario físico</h1>
                <p class="pf-page-header__description">Consulta cada rollo, envase, paquete o sobrante por su código, saldo y ubicación.</p>
            </div>
            {% if is_granted('inventory.receive') %}
                <div class="pf-page-header__actions">
                    <a href="{{ path('admin_inventory_receipts_new') }}" class="btn pf-button pf-button--primary">
                        <i class="bi bi-plus-lg" aria-hidden="true"></i>
                        <span>Recibir material</span>
                    </a>
                    {% if is_granted('inventory.count') %}
                        <a href="{{ path('admin_inventory_cycle_counts_index') }}" class="btn pf-button pf-button--secondary">
                            <i class="bi bi-upc-scan" aria-hidden="true"></i>
                            <span>Conteo cíclico</span>
                        </a>
                    {% endif %}
                    {% if is_granted('inventory.adjust_stock') %}
                        <a href="{{ path('admin_inventory_stock_unit_operations_index') }}" class="btn pf-button pf-button--secondary">
                            <i class="bi bi-shield-check" aria-hidden="true"></i>
                            <span>Operaciones de bodega</span>
                        </a>
                    {% endif %}
                    {% if is_granted('inventory.configure') %}
                        <a href="{{ path('admin_inventory_variants_new') }}" class="btn pf-button pf-button--secondary"><i class="bi bi-box-seam" aria-hidden="true"></i><span>Nueva presentación</span></a>
                        <a href="{{ path('admin_inventory_roll_variants_new') }}" class="btn pf-button pf-button--secondary"><i class="bi bi-rulers" aria-hidden="true"></i><span>Configurar anchos</span></a>
                        <a href="{{ path('admin_inventory_receipts_minimums') }}" class="btn pf-button pf-button--secondary"><i class="bi bi-sliders" aria-hidden="true"></i><span>Configurar mínimos</span></a>
                        <a href="{{ path('admin_inventory_replenishment_index') }}" class="btn pf-button pf-button--secondary"><i class="bi bi-cart-plus" aria-hidden="true"></i><span>Sugerencias de compra</span></a>
                        <a href="{{ path('admin_inventory_indicators_index') }}" class="btn pf-button pf-button--secondary"><i class="bi bi-graph-up" aria-hidden="true"></i><span>Indicadores</span></a>
                    {% endif %}
                </div>
            {% elseif is_granted('inventory.adjust_stock') %}
                <div class="pf-page-header__actions"><a href="{{ path('admin_inventory_receipts_new', {origin: 'INITIAL_COUNT'}) }}" class="btn pf-button pf-button--primary"><i class="bi bi-plus-lg" aria-hidden="true"></i><span>Recibir material</span></a><a href="{{ path('admin_inventory_stock_unit_operations_index') }}" class="btn pf-button pf-button--secondary"><i class="bi bi-shield-check" aria-hidden="true"></i><span>Operaciones de bodega</span></a></div>
            {% elseif is_granted('inventory.count') %}
                <div class="pf-page-header__actions"><a href="{{ path('admin_inventory_cycle_counts_index') }}" class="btn pf-button pf-button--primary"><i class="bi bi-upc-scan" aria-hidden="true"></i><span>Conteo cíclico</span></a></div>
            {% endif %}
        </div>

        <section class="pf-card mb-4" aria-labelledby="inventory-qr-lookup-title">
            <div class="pf-card__body">
                <h2 id="inventory-qr-lookup-title" class="h5 mb-2">Consultar unidad por QR</h2>
                <p class="text-body-secondary small mb-3">Escanea la etiqueta para ver el material, saldo y ubicación. Esta consulta no registra un conteo ni modifica existencias.</p>
                <form method="post" action="{{ path('admin_inventory_receipts_qr_lookup') }}" class="pf-form row g-3 align-items-end" data-controller="ui--qr-scanner" data-ui--qr-scanner-src-value="{{ asset('vendor/zxing-browser/zxing-browser.min.js') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('inventory_qr_lookup') }}">
                    <div class="col-lg-8 pf-form-field">
                        <label for="inventory-qr-lookup" class="form-label">Etiqueta QR del material</label>
                        <div class="input-group pf-qr-scan-input">
                            <input id="inventory-qr-lookup" name="qr_payload" class="form-control" autocomplete="off" required placeholder="Escanea el QR de la unidad" data-ui--qr-scanner-target="input">
                            <button class="btn pf-button pf-button--secondary" type="button" data-action="ui--qr-scanner#scan" aria-controls="inventory-qr-preview"><i class="bi bi-camera" aria-hidden="true"></i> Usar cámara</button>
                        </div>
                    </div>
                    <div class="col-lg-4"><button type="submit" class="btn pf-button pf-button--primary w-100">Consultar unidad</button></div>
                    <div id="inventory-qr-preview" class="col-12 pf-qr-scan-preview" data-ui--qr-scanner-target="panel" hidden>
                        <video autoplay muted playsinline data-ui--qr-scanner-target="video" aria-label="Vista de la cámara para escanear QR"></video>
                        <button class="btn pf-button pf-button--secondary pf-button--sm mt-2" type="button" data-action="ui--qr-scanner#stop">Cerrar cámara</button>
                    </div>
                    <p class="col-12 small mb-0" data-ui--qr-scanner-target="message" role="status" aria-live="polite"></p>
                </form>
            </div>
        </section>

        <form method="get" class="pf-card pf-form mb-4">
            <div class="pf-card__body row g-3 align-items-end">
                <div class="col-xl-6 col-lg-5 col-md-6 pf-form-field">
                    <label for="inventory-search" class="form-label">Buscar</label>
                    <input id="inventory-search" type="search" name="q" value="{{ search }}" class="form-control" placeholder="Código QR, material, presentación, lote o ubicación">
                </div>
                <div class="col-xl-3 col-lg-3 col-md-6 pf-form-field">
                    <label for="inventory-status" class="form-label">Estado</label>
                    <select id="inventory-status" name="status" class="form-select">
                        <option value="">Todos</option>
                        {% for itemStatus in statuses %}
                            <option value="{{ itemStatus.value }}" {{ status == itemStatus.value ? 'selected' : '' }}>{{ itemStatus.label }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-xl-3 col-lg-4 col-12 d-flex flex-wrap gap-2 pf-inventory-filter-actions">
                    <button type="submit" class="btn pf-button pf-button--primary">Filtrar</button>
                    <a href="{{ path('admin_inventory_receipts_index') }}" class="btn pf-button pf-button--secondary">Limpiar</a>
                </div>
            </div>
        </form>

        <div class="pf-card">
            <div class="pf-card__body p-0">
                <p class="pf-inventory-table-hint">Desliza la tabla para ver todas las columnas.</p>
                <div class="table-responsive" role="region" aria-label="Unidades físicas de inventario" tabindex="0">
                    <table class="table pf-table mb-0">
                        <thead>
                            <tr>
                                <th>Unidad física</th>
                                <th>Material</th>
                                <th>Saldo</th>
                                <th>Ubicación</th>
                                <th>Registro</th>
                                <th>Estado</th>
                                <th class="pf-table__actions-cell">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for stockUnit in page.items %}
                                {% set statusClass = {
                                    'AVAILABLE': 'success',
                                    'BLOCKED': 'warning',
                                    'EXHAUSTED': 'secondary',
                                    'DISPOSED': 'danger'
                                }[stockUnit.status.value] %}
                                <tr>
                                    <td>
                                        <code class="pf-table__code">{{ stockUnit.unitCode }}</code>
                                        {% if stockUnit.physicalAttributes.physical_form|default(false) or stockUnit.variant.specifications.physical_form|default(false) %}<div class="small text-body-secondary">{{ stockUnit.physicalAttributes.physical_form|default(stockUnit.variant.specifications.physical_form)|lower|capitalize }}</div>{% endif %}
                                        {% if stockUnit.lot %}<div class="small text-body-secondary">Lote {{ stockUnit.lot.internalLotNumber }}</div>{% endif %}
                                    </td>
                                    <td>
                                        <strong class="pf-table__primary">{{ stockUnit.variant.material.name }}</strong>
                                        <div class="small text-body-secondary">{{ stockUnit.variant.material.code }} · {{ stockUnit.variant.code }}</div>
                                        {% if stockUnit.variant.specifications.width_m|default(false) %}<div class="small text-body-secondary">Ancho {{ stockUnit.variant.specifications.width_m|number_format(2, '.', '') }} m</div>{% endif %}
                                    </td>
                                    <td class="pf-table__cell--right pf-table__cell--nowrap">
                                        {{ stockUnit.remainingQuantity|number_format(6, '.', ',') }} {{ stockUnit.variant.inventoryUnit.symbol }}
                                        <div class="small text-body-secondary">de {{ stockUnit.initialQuantity|number_format(6, '.', ',') }}</div>
                                    </td>
                                    <td>{{ stockUnit.storageLocation ?: 'Sin asignar' }}</td>
                                    <td class="pf-table__cell--nowrap">{{ stockUnit.receivedAt|date('d/m/Y H:i', 'America/Mexico_City') }}</td>
                                    <td><span class="pf-status-badge pf-status-badge--{{ statusClass }}">{{ stockUnit.status.label }}</span></td>
                                    <td class="pf-table__actions-cell">
                                        {% if is_granted('inventory.labels.print') %}
                                            <a href="{{ path('admin_inventory_receipts_stock_unit_label', { id: stockUnit.id }) }}" class="btn pf-button pf-button--secondary pf-button--sm">
                                                <i class="bi bi-printer" aria-hidden="true"></i>
                                                <span>Etiqueta</span>
                                            </a>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% else %}
                                <tr><td colspan="7" class="pf-table__empty">No hay unidades físicas que coincidan con los filtros.</td></tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
            {% if page.pageCount > 1 %}
                <div class="pf-card__footer d-flex justify-content-between align-items-center pf-inventory-pagination">
                    <a class="btn pf-button pf-button--secondary pf-button--sm {{ page.currentPage == 1 ? 'disabled' : '' }}" href="{{ path('admin_inventory_receipts_index', { q: search, status: status, page: page.currentPage - 1 }) }}">Anterior</a>
                    <span class="pf-table-footer__summary">Página {{ page.currentPage }} de {{ page.pageCount }} · {{ page.total }} unidades</span>
                    <a class="btn pf-button pf-button--secondary pf-button--sm {{ page.currentPage == page.pageCount ? 'disabled' : '' }}" href="{{ path('admin_inventory_receipts_index', { q: search, status: status, page: page.currentPage + 1 }) }}">Siguiente</a>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
