{% extends 'layouts/app.html.twig' %}

{% block title %}Configurar ancho de rollo | OoxCorp{% endblock %}
{% block app_navigation_active %}inventory{% endblock %}
{% block app_breadcrumb %}Operación / Inventario / Configurar ancho de rollo{% endblock %}

{% block app_content %}
    <div class="pf-page__content">
        <div class="pf-page-header">
            <div class="pf-page-header__content">
                <h1 class="pf-page-header__title">Configurar ancho de rollo</h1>
                <p class="pf-page-header__description">Cada ancho es una presentación distinta. La longitud variable se mide al registrar cada rollo físico.</p>
            </div>
        </div>

        <form method="post" class="pf-card pf-form" novalidate>
            <div class="pf-card__body row g-3">
                <input type="hidden" name="_token" value="{{ csrf_token('inventory_roll_variant_new') }}">
                <div class="col-12 pf-form-field">
                    <label for="roll-material" class="form-label">Material</label>
                    <select id="roll-material" name="material_id" class="form-select" required>
                        <option value="">Selecciona el material</option>
                        {% for material in materials %}
                            <option value="{{ material.id }}" {{ formData.material_id == material.id ? 'selected' : '' }}>{{ material.name }} · {{ material.code }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-6 pf-form-field">
                    <label for="roll-width" class="form-label">Ancho del rollo</label>
                    <div class="input-group">
                        <input id="roll-width" name="width_m" value="{{ formData.width_m }}" class="form-control" inputmode="decimal" placeholder="Ej. 1.52" required>
                        <span class="input-group-text">m</span>
                    </div>
                    <div class="form-text">Ej. 1.52 m. Un rollo de 20 m lineales de este ancho equivale a 30.4 m².</div>
                </div>
                <div class="col-12">
                    <div class="alert alert-info mb-0">Se creará una presentación con saldo en metros lineales y consumo en metros cuadrados. Cada rollo recibirá su propio QR y su longitud medida. Si el proveedor factura por rollo, conserva ese dato en la referencia de compra; la cantidad física se registra en metros.</div>
                </div>
            </div>
            <div class="pf-card__footer d-flex justify-content-end gap-2">
                <a href="{{ path('admin_inventory_receipts_new') }}" class="btn pf-button pf-button--secondary">Volver</a>
                <button class="btn pf-button pf-button--primary" type="submit">Guardar presentación</button>
            </div>
        </form>
    </div>
{% endblock %}
