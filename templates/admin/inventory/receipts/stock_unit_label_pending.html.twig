{% extends 'layouts/app.html.twig' %}

{% block title %}Etiqueta pendiente | OoxCorp{% endblock %}
{% block app_navigation_active %}inventory{% endblock %}
{% block app_breadcrumb %}Operación / Inventario / Etiqueta pendiente{% endblock %}

{% block app_content %}
    <div class="pf-page__content">
        <div class="pf-page-header"><div class="pf-page-header__content"><h1 class="pf-page-header__title">Etiqueta pendiente de generar</h1><p class="pf-page-header__description">La unidad {{ stockUnit.unitCode }} ya está registrada. Reintentar no modificará su saldo.</p></div></div>
        <div class="alert alert-warning" role="alert">El servicio de generación QR aún no está disponible en este ambiente. Conserva la unidad identificada con su código hasta imprimir la etiqueta.</div>
        <div class="d-flex flex-wrap gap-2">
            <a href="{{ path('admin_inventory_receipts_stock_unit_label', { id: stockUnit.id }) }}" class="btn pf-button pf-button--primary"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i><span>Reintentar etiqueta</span></a>
            <a href="{{ path('admin_inventory_receipts_index') }}" class="btn pf-button pf-button--secondary"><span>Volver al inventario</span></a>
        </div>
    </div>
{% endblock %}
