{% extends 'layouts/app.html.twig' %}
{% block title %}Sustituciones de material | OoxCorp{% endblock %}
{% block app_navigation_active %}inventory{% endblock %}
{% block app_breadcrumb %}Operación / Inventario / Sustituciones{% endblock %}
{% block app_content %}
<div class="pf-page__content">
    <div class="pf-page-header"><div class="pf-page-header__content"><h1 class="pf-page-header__title">Sustituciones de material</h1><p class="pf-page-header__description">Define equivalencias técnicas aprobadas antes de que un faltante requiera atención.</p></div></div>
    <div class="alert alert-info">La equivalencia indica cuántas unidades de inventario del sustituto cubren una unidad faltante del material original. Al aplicar una regla se vuelve a validar el saldo real.</div>
    <section class="pf-card mb-4"><div class="pf-card__body"><form method="post" class="row g-3 align-items-end"><input type="hidden" name="_token" value="{{ csrf_token('inventory_substitution_rule_new') }}"><div class="col-lg-4"><label class="form-label">Material original<select class="form-select" name="original_variant_id" required><option value="">Selecciona variante</option>{% for variant in variants %}<option value="{{ variant.id }}">{{ variant.material.name }} · {{ variant.code }} · {{ variant.inventoryUnit.symbol }}</option>{% endfor %}</select></label></div><div class="col-lg-4"><label class="form-label">Sustituto viable<select class="form-select" name="substitute_variant_id" required><option value="">Selecciona variante</option>{% for variant in variants %}<option value="{{ variant.id }}">{{ variant.material.name }} · {{ variant.code }} · {{ variant.inventoryUnit.symbol }}</option>{% endfor %}</select></label></div><div class="col-lg-2"><label class="form-label">Factor<input class="form-control" name="substitute_per_original" inputmode="decimal" value="1" required></label></div><div class="col-lg-2"><button class="btn pf-button pf-button--primary" type="submit">Agregar regla</button></div><div class="col-12"><label class="form-label">Notas técnicas<textarea class="form-control" name="notes" rows="2" maxlength="2000" placeholder="Condiciones, acabado, equipo o limitaciones de uso"></textarea></label></div></form></div></section>
    <section class="pf-card"><div class="pf-card__body p-0"><div class="table-responsive"><table class="table pf-table mb-0"><thead><tr><th>Original</th><th>Sustituto</th><th>Equivalencia</th><th>Notas</th><th>Estado</th></tr></thead><tbody>{% for rule in rules %}<tr><td>{{ rule.originalVariant.material.name }}<div class="small text-body-secondary">{{ rule.originalVariant.code }}</div></td><td>{{ rule.substituteVariant.material.name }}<div class="small text-body-secondary">{{ rule.substituteVariant.code }}</div></td><td>1 {{ rule.originalVariant.inventoryUnit.symbol }} = {{ rule.substitutePerOriginal }} {{ rule.substituteVariant.inventoryUnit.symbol }}</td><td>{{ rule.notes ?: '—' }}</td><td><form method="post" action="{{ path('admin_inventory_substitutions_toggle', {id: rule.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('inventory_substitution_rule_toggle_' ~ rule.id) }}"><button class="btn pf-button pf-button--secondary pf-button--sm" type="submit">{{ rule.isActive ? 'Activa' : 'Inactiva' }}</button></form></td></tr>{% else %}<tr><td colspan="5" class="pf-table__empty">No hay reglas de sustitución configuradas.</td></tr>{% endfor %}</tbody></table></div></div></section>
</div>
{% endblock %}
