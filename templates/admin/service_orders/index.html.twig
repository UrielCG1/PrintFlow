{% extends 'layouts/app.html.twig' %}

{% block title %}Órdenes de servicio | PrintFlow{% endblock %}

{% block app_navigation_active %}service_orders{% endblock %}

{% block app_breadcrumb %}Comercial / Órdenes de servicio{% endblock %}

{% block app_content %}
    <section class="pf-page__content">
        <header class="pf-page-header">
            <div class="pf-page-header__content">
                <p class="pf-page-header__eyebrow">Comercial</p>
                <h1 class="pf-page-header__title">Órdenes de servicio</h1>
                <p class="pf-page-header__description">
                    Órdenes creadas desde cotizaciones aceptadas. Sus partidas e importes permanecen congelados.
                </p>
            </div>
        </header>

        <section class="pf-card pf-card--padding-none">
            <div class="pf-table-responsive pf-table-responsive--flat">
                <table class="pf-table">
                    <thead>
                        <tr>
                            <th>Folio</th>
                            <th>Cliente</th>
                            <th>Cotización origen</th>
                            <th>Estado</th>
                            <th class="pf-table__cell--right">Total</th>
                            <th>Fecha compromiso</th>
                            <th>Creada</th>
                            <th class="pf-table__actions-cell">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for serviceOrder in serviceOrders %}
                            <tr>
                                <td><strong class="pf-table__primary">{{ serviceOrder.folio }}</strong></td>
                                <td>
                                    <strong class="d-block pf-table__primary">{{ serviceOrder.clientSnapshot.business_name ?? 'Cliente no disponible' }}</strong>
                                    {% if serviceOrder.clientSnapshot.tax_id ?? false %}
                                        <span class="d-block text-muted small">{{ serviceOrder.clientSnapshot.tax_id }}</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <a href="{{ path('admin_quotations_show', {id: serviceOrder.sourceQuotation.id}) }}">{{ serviceOrder.sourceQuotationFolio }}</a>
                                </td>
                                <td><span class="pf-status-badge pf-status-badge--{{ serviceOrder.status.badgeTone }}">{{ serviceOrder.status.label }}</span></td>
                                <td class="pf-table__cell--right pf-table__cell--nowrap fw-semibold">${{ serviceOrder.total|number_format(2, '.', ',') }} {{ serviceOrder.currency }}</td>
                                <td>
                                    {% if serviceOrder.commitmentDate %}
                                        {{ serviceOrder.commitmentDate|date('d/m/Y') }}
                                    {% else %}
                                        <span class="text-muted">Por asignar</span>
                                    {% endif %}
                                </td>
                                <td>{{ serviceOrder.createdAt|date('d/m/Y H:i', 'America/Mexico_City') }}</td>
                                <td class="pf-table__actions-cell">
                                    <a href="{{ path('admin_service_orders_show', {id: serviceOrder.id}) }}" class="btn pf-button pf-button--secondary pf-button--sm">
                                        <i class="bi bi-eye" aria-hidden="true"></i>
                                        Ver
                                    </a>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="8" class="pf-table__empty">
                                    <div class="pf-table__empty-content">
                                        <i class="bi bi-clipboard-check pf-table__empty-icon" aria-hidden="true"></i>
                                        <strong class="pf-table__empty-title">Aún no hay órdenes de servicio.</strong>
                                        <span class="pf-table__empty-description">Se crean desde el detalle de una cotización aceptada.</span>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>
    </section>
{% endblock %}
