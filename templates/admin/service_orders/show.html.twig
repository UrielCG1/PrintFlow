{% extends 'layouts/app.html.twig' %}

{% block title %}{{ serviceOrder.folio }} | OoxCorp{% endblock %}

{% block app_navigation_active %}service_orders{% endblock %}

{% block app_breadcrumb %}Operación / Órdenes de servicio / Detalle{% endblock %}

{% block app_content %}
    <section class="pf-page__content service-order-page" data-controller="ui--scroll-position" data-action="submit->ui--scroll-position#remember">
        <header class="pf-page-header">
            <div class="pf-page-header__content">
                <p class="pf-page-header__eyebrow">Operación / Órdenes de servicio</p>
                <h1 class="pf-page-header__title">{{ serviceOrder.folio }}</h1>
                <p class="pf-page-header__description">
                    {% if is_granted('service_orders.view_commercial') %}
                        Creada desde la cotización
                        {% if is_granted('quotations.view') %}
                            <a href="{{ path('admin_quotations_show', {id: serviceOrder.sourceQuotation.id}) }}">{{ serviceOrder.sourceQuotationFolio }}</a>.
                        {% else %}
                            {{ serviceOrder.sourceQuotationFolio }}.
                        {% endif %}
                    {% else %}
                        Seguimiento operativo de los trabajos de esta orden.
                    {% endif %}
                </p>
            </div>
            <div class="pf-page-header__actions">
                <div class="service-order-header-fact">
                    <i class="bi bi-calendar3" aria-hidden="true"></i>
                    <span><small>Fecha compromiso</small><strong>{{ serviceOrder.commitmentDate ? serviceOrder.commitmentDate|date('d/m/Y') : 'Por confirmar' }}</strong></span>
                </div>
                <div class="service-order-header-fact service-order-header-fact--{{ productionForecast.order.risk_tone }}">
                    <i class="bi {{ productionForecast.order.risk.value == 'late' ? 'bi-exclamation-triangle' : (productionForecast.order.risk.value == 'on_track' ? 'bi-clock' : 'bi-exclamation-circle') }}" aria-hidden="true"></i>
                    <span><small>Pronóstico</small><strong>{{ productionForecast.order.risk_label }}</strong></span>
                </div>
                {% if is_granted('service_orders.view_commercial') %}
                    <div class="service-order-header-fact service-order-header-fact--amount">
                        <i class="bi bi-receipt" aria-hidden="true"></i>
                        <span><small>Total contratado</small><strong>${{ serviceOrder.total|number_format(2, '.', ',') }} {{ serviceOrder.currency }}</strong></span>
                    </div>
                {% endif %}
                <a href="{{ path('admin_service_orders_index') }}" class="btn pf-button pf-button--secondary">
                    <i class="bi bi-arrow-left" aria-hidden="true"></i>
                    Volver
                </a>
            </div>
        </header>

        {% if canCancelProduction %}
            <details class="service-order-disclosure service-order-disclosure--action mb-4">
                <summary>
                    <span class="service-order-disclosure__label"><i class="bi bi-x-octagon" aria-hidden="true"></i> Cancelar producción</span>
                    <span class="service-order-disclosure__hint">Libera solo el material no consumido y retira la agenda pendiente</span>
                </summary>
                <form method="post" action="{{ path('admin_service_orders_cancel_production', {id: serviceOrder.id}) }}" class="pf-form mt-3" data-controller="ui--confirm-action" data-action="submit->ui--confirm-action#submit" data-ui--confirm-action-title-value="¿Cancelar producción?" data-ui--confirm-action-text-value="Los consumos ya registrados se conservan. Se liberará el material pendiente y se cerrarán los intentos abiertos." data-ui--confirm-action-confirm-button-text-value="Sí, cancelar" data-ui--confirm-action-cancel-button-text-value="Volver" data-ui--confirm-action-icon-value="warning">
                    <input type="hidden" name="_token" value="{{ csrf_token('service-order-cancel-production-' ~ serviceOrder.id) }}">
                    <label class="form-label" for="cancel-production-reason">Motivo de cancelación</label>
                    <textarea id="cancel-production-reason" class="form-control mb-3" name="reason" rows="3" minlength="5" maxlength="500" required placeholder="Explica por qué se cancela la orden"></textarea>
                    <button type="submit" class="btn pf-button pf-button--danger">Cancelar producción</button>
                </form>
            </details>
        {% endif %}

        {% set orderStages = [
            {key: 'planning', label: 'Planificación'},
            {key: 'design', label: 'Diseño'},
            {key: 'production', label: 'Producción'},
            {key: 'quality', label: 'Calidad'},
            {key: 'delivery', label: 'Entrega'}
        ] %}
        <section class="pf-card service-order-journey mb-4" aria-labelledby="service-order-journey-title">
            <div class="pf-card__body">
                <div class="service-order-journey__heading">
                    <h2 id="service-order-journey-title" class="service-order-journey__title">Progreso de la orden</h2>
                    <span class="visually-hidden">{{ orderProgress.percent }}% completado</span>
                </div>

                {% set journeyLine = orderProgress.current_stage == 'planning' ? 0 : (orderProgress.current_stage == 'design' ? 20 : (orderProgress.current_stage == 'production' ? 40 : (orderProgress.current_stage == 'quality' ? 60 : 80))) %}
                <ol class="service-order-journey__steps" style="--journey-progress: {{ journeyLine }}%" aria-label="Etapas de la orden">
                    {% for stage in orderStages %}
                        {% set stageComplete = orderProgress.stages[stage.key] %}
                        {% set stageCurrent = orderProgress.current_stage == stage.key %}
                        {% set stageClass = stageComplete ? 'is-complete' : (stageCurrent ? 'is-current' : 'is-pending') %}
                        <li class="service-order-journey__step {{ stageClass }}"{% if stageCurrent %} aria-current="step"{% endif %}>
                            <span class="service-order-journey__icon">{{ stageComplete ? '✓' : loop.index }}</span>
                            <span class="service-order-journey__copy">
                                <strong>{{ stage.label }}</strong>
                                <span>{{ stage.key == 'design' and not orderProgress.design_required ? 'No requerida' : (stageComplete ? 'Completada' : (stageCurrent ? (stage.key == 'production' and orderProgress.total_operations > 0 ? orderProgress.completed_operations ~ '/' ~ orderProgress.total_operations ~ ' operaciones' : 'En curso') : 'Pendiente')) }}</span>
                            </span>
                        </li>
                    {% endfor %}
                </ol>

                <div class="service-order-journey__status">
                    <i class="bi bi-file-earmark-text" aria-hidden="true"></i>
                    {% if orderProgress.current_stage == 'planning' %}
                        <strong>{{ serviceOrder.commitmentDate ? 'Preparación de planificación' : 'Fecha y agenda pendientes' }}</strong>
                        <span>· {{ planningProgress.ready }}/{{ planningProgress.operations }} operaciones listas</span>
                    {% elseif orderProgress.current_stage == 'production' %}
                        <strong>Producción en proceso</strong>
                        <span>· {{ orderProgress.completed_operations }} de {{ orderProgress.total_operations }} operaciones completadas</span>
                    {% else %}
                        <strong>{{ serviceOrder.productionStatus.label }}</strong>
                        <span>· {{ orderProgress.completed_operations }} de {{ orderProgress.total_operations }} operaciones completadas</span>
                    {% endif %}
                </div>

                <div class="service-order-journey__next">
                    <i class="bi bi-lightning-charge service-order-journey__next-icon" aria-hidden="true"></i>
                    <div>
                        <span class="service-order-journey__eyebrow">Siguiente acción</span>
                        {% if orderProgress.current_stage == 'planning' %}
                            <strong>Completar planificación</strong>
                            <p>Faltan datos o agenda en {{ planningProgress.operations - planningProgress.ready }} operación(es).</p>
                        {% elseif orderProgress.current_stage == 'design' %}
                            <strong>Revisar y liberar el diseño</strong>
                            <p>{{ orderProgress.design_pending_items }} partida(s) todavía requieren atención de Diseño.</p>
                        {% elseif orderProgress.current_stage == 'production' %}
                            <strong>Continuar producción</strong>
                            <p>{{ orderProgress.completed_operations }}/{{ orderProgress.total_operations }} operaciones completadas. Registra el avance del trabajo actual.</p>
                        {% elseif orderProgress.current_stage == 'quality' %}
                            <strong>{{ serviceOrder.productionStatus.value == 'QUALITY_REWORK' ? 'Atender el retrabajo' : 'Inspeccionar el producto' }}</strong>
                            <p>{{ serviceOrder.productionStatus.value == 'QUALITY_REWORK' ? 'Calidad solicitó una corrección antes de liberar la orden.' : 'Calidad debe revisar y liberar los trabajos terminados.' }}</p>
                        {% elseif orderProgress.current_stage == 'delivery' %}
                            <strong>Preparar y confirmar la entrega</strong>
                            <p>Revisar la modalidad de entrega y registrar su avance.</p>
                        {% elseif orderProgress.current_stage == 'cancelled' %}
                            <strong>Producción cancelada</strong>
                            <p>El seguimiento del trabajo se detuvo al cancelar la orden.</p>
                        {% else %}
                            <strong>Orden entregada</strong>
                            <p>El recorrido de producción y entrega está completo.</p>
                        {% endif %}
                    </div>
                    <div class="service-order-journey__action">
                        {% if orderProgress.current_stage == 'planning' %}
                            {% if canPlan %}
                                <a href="#planning-section" class="btn pf-button pf-button--primary">Completar planificación <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                            {% elseif canManageCommitment and not serviceOrder.commitmentDate %}
                                <a href="#commitment-date-control" class="btn pf-button pf-button--primary">Confirmar fecha <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                            {% elseif canManageCommitment %}
                                <a href="#commitment-date-control" class="btn pf-button pf-button--secondary">Revisar fecha</a>
                            {% else %}
                                <span class="service-order-journey__owner">Siguiente responsable: Ventas y Producción</span>
                            {% endif %}
                        {% elseif orderProgress.current_stage == 'design' %}
                            {% if is_granted('production.view') and is_granted('production.design.review') %}
                                <a href="{{ path('admin_design_index') }}" class="btn pf-button pf-button--primary">Abrir Diseño <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                            {% else %}
                                <span class="service-order-journey__owner">Siguiente responsable: Diseño</span>
                            {% endif %}
                        {% elseif orderProgress.current_stage == 'production' %}
                            {% if is_granted('production.view') and is_granted('production.execute') %}
                                <a href="{{ path('admin_production_execution_index') }}" class="btn pf-button pf-button--primary">Abrir operación <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                            {% else %}
                                <span class="service-order-journey__owner">Siguiente responsable: Producción</span>
                            {% endif %}
                        {% elseif orderProgress.current_stage == 'quality' %}
                            {% if is_granted('quality.review') %}
                                <a href="{{ path('admin_production_quality_delivery_quality_index') }}" class="btn pf-button pf-button--secondary">Abrir Calidad</a>
                            {% else %}
                                <span class="service-order-journey__owner">Siguiente responsable: Calidad</span>
                            {% endif %}
                        {% elseif orderProgress.current_stage == 'delivery' %}
                            {% if is_granted('delivery.confirm') or is_granted('delivery.ship') %}
                                <a href="{{ path('admin_production_quality_delivery_delivery_index') }}" class="btn pf-button pf-button--secondary">Abrir Entregas</a>
                            {% else %}
                                <span class="service-order-journey__owner">Siguiente responsable: Ventas y Entregas</span>
                            {% endif %}
                        {% endif %}
                    </div>
                </div>
                <div class="service-order-overview">
                    <div class="service-order-overview__fact"><small>Cliente</small><strong>{{ serviceOrder.clientSnapshot.legal_name ?? serviceOrder.clientSnapshot.business_name ?? 'No especificado' }}</strong>{% if is_granted('service_orders.view_commercial') and (serviceOrder.clientSnapshot.tax_id ?? false) %}<span>RFC: {{ serviceOrder.clientSnapshot.tax_id }}</span>{% endif %}</div>
                    <div class="service-order-overview__fact"><small>Modalidad de entrega</small><strong>{{ serviceOrder.fulfillmentMethod.label }}</strong>{% if serviceOrder.deliveryPreparationIssue %}<span>{{ serviceOrder.deliveryPreparationIssue }}</span>{% endif %}</div>
                    <div class="service-order-overview__fact"><small>Contacto de entrega</small><strong>{{ serviceOrder.deliveryContactSnapshot.name|default('Dato histórico no disponible') }}</strong><span>{{ serviceOrder.deliveryContactSnapshot.email|default('') }}{% if serviceOrder.deliveryContactSnapshot.email|default(null) and serviceOrder.deliveryContactSnapshot.phone|default(null) %} · {% endif %}{{ serviceOrder.deliveryContactSnapshot.phone|default('') }}</span></div>
                </div>
            </div>
        </section>

        <div class="service-order-quick-tools mb-4">
            <div class="service-order-quick-tools__forecast">
                <strong>Pronóstico de entrega</strong>
                <span>{{ productionForecast.order.risk_cause }}</span>
                {% if productionForecast.order.production_finish %}<span>Fin de producción previsto: {{ productionForecast.order.production_finish|date('d/m/Y H:i', 'America/Mexico_City') }} · Entrega sugerida: {{ productionForecast.order.suggested_delivery|date('d/m/Y') }}</span>{% endif %}
                {% if serviceOrder.plannedAt %}<span>Planificada {{ serviceOrder.plannedAt|date('d/m/Y H:i', 'America/Mexico_City') }}{% if serviceOrder.plannedBy %} por {{ serviceOrder.plannedBy.fullName }}{% endif %}</span>{% endif %}
            </div>
        </div>
        <div class="service-order-commitment">
                        {% if canManageCommitment %}
                            <details id="commitment-date-control" class="service-order-disclosure service-order-disclosure--primary mt-3">
                                <summary>
                                    <span class="service-order-disclosure__label"><i class="bi bi-calendar-check" aria-hidden="true"></i> {{ serviceOrder.commitmentDate ? 'Cambiar fecha compromiso' : 'Confirmar fecha compromiso' }}</span>
                                    <span class="service-order-disclosure__hint">Ventas define el plazo prometido</span>
                                </summary>
                                {{ form_start(planningForm, {action: path('admin_service_orders_update_planning', {id: serviceOrder.id}), method: 'POST', attr: {class: 'pf-form mt-2'}}) }}
                                    {{ form_errors(planningForm) }}
                                    {{ form_row(planningForm.commitmentDate) }}
                                    {% if serviceOrder.commitmentDate %}
                                        {{ form_row(planningForm.reason, {help: 'Obligatorio al cambiar o quitar una fecha ya acordada.'}) }}
                                    {% else %}
                                        <p class="form-text">La primera fecha se puede confirmar sin motivo. Si hay una sugerencia, aparece precargada.</p>
                                        {{ form_widget(planningForm.reason, {attr: {style: 'display:none'}}) }}
                                    {% endif %}
                                    <button type="submit" class="btn pf-button pf-button--secondary pf-button--sm">Guardar fecha</button>
                                {{ form_end(planningForm) }}
                            </details>
                        {% endif %}
        </div>

        {% if materialRequirements is not empty %}
            <section class="pf-card mb-4" aria-labelledby="material-coverage-title">
                <header class="pf-card__header d-flex flex-column flex-lg-row gap-3 justify-content-between align-items-lg-center">
                    <div>
                        <h2 id="material-coverage-title" class="pf-card__title">Cobertura de materiales</h2>
                        <p class="pf-card__subtitle">Cantidades previstas convertidas a la unidad de inventario de cada variante.</p>
                    </div>
                    {% if canCommitMaterials %}
                        <form method="post" action="{{ path('admin_service_orders_commit_materials', {id: serviceOrder.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('service-order-commit-materials-' ~ serviceOrder.id) }}">
                            <button type="submit" class="btn pf-button pf-button--primary">Apartar materiales</button>
                        </form>
                    {% endif %}
                </header>
                <div class="pf-card__body">
                    <div class="table-responsive"><table class="table pf-table mb-0"><thead><tr><th>Material</th><th>Necesidad</th><th>Apartado pendiente</th><th>Consumido</th><th>Liberado</th><th>Faltante</th><th>Estado</th></tr></thead><tbody>
                    {% for requirement in materialRequirements %}
                        <tr>
                            <td><strong>{{ requirement.variant.material.name }}</strong><div class="small text-body-secondary">{{ requirement.variant.code }} · {{ requirement.variant.inventoryUnit.symbol }}</div></td>
                            <td>{{ requirement.requiredQuantity|number_format(6, '.', ',') }}</td>
                            <td>{{ requirement.committedQuantity|number_format(6, '.', ',') }}</td>
                            <td>{{ requirement.consumedQuantity|number_format(6, '.', ',') }}</td>
                            <td>{{ requirement.releasedQuantity|number_format(6, '.', ',') }}</td>
                            <td>{{ requirement.shortageQuantity|number_format(6, '.', ',') }}</td>
                            <td>
                                {% if requirement.shortageQuantity != '0.000000' %}
                                    <span class="text-warning d-block">{{ requirement.status == 'PARTIAL' ? 'Cobertura parcial' : 'Material faltante' }}</span>
                                    {% if requirement.shortageDecision %}<span class="small text-body-secondary d-block">{{ requirement.shortageDecision.type.label }}</span>{% endif %}
                                    {% if is_granted('inventory.substitutions.manage') and requirement.commitment and requirement.substitutionRules is not empty %}
                                        <details class="mt-2"><summary class="small">Usar sustituto viable</summary>
                                            {% for rule in requirement.substitutionRules %}
                                                <form method="post" action="{{ path('admin_service_orders_substitute_material_shortage', {id: serviceOrder.id, commitment: requirement.commitment.id, rule: rule.id}) }}" class="mt-2 border-top pt-2">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('inventory-shortage-substitute-' ~ requirement.commitment.id ~ '-' ~ rule.id) }}">
                                                    <div class="small mb-2"><strong>{{ rule.substituteVariant.material.name }}</strong> · {{ rule.substituteVariant.code }}<br>1 {{ requirement.variant.inventoryUnit.symbol }} = {{ rule.substitutePerOriginal }} {{ rule.substituteVariant.inventoryUnit.symbol }}</div>
                                                    <textarea class="form-control form-control-sm mb-2" name="reason" rows="2" minlength="5" maxlength="2000" required placeholder="Motivo técnico de la sustitución"></textarea>
                                                    <button type="submit" class="btn pf-button pf-button--secondary btn-sm">Aplicar sustituto</button>
                                                </form>
                                            {% endfor %}
                                        </details>
                                    {% endif %}
                                    {% if is_granted('inventory.substitutions.manage') and requirement.commitment and requirement.substitutionRules is empty %}<a class="small d-inline-block mt-2" href="{{ path('admin_inventory_substitutions_index') }}">Configurar sustitutos viables</a>{% endif %}
                                    {% if is_granted('inventory.shortage.approve') and requirement.commitment %}
                                        <details class="mt-2"><summary class="small">Resolver faltante</summary>
                                            <form method="post" action="{{ path('admin_service_orders_resolve_material_shortage', {id: serviceOrder.id, commitment: requirement.commitment.id}) }}" class="mt-2">
                                                <input type="hidden" name="_token" value="{{ csrf_token('inventory-shortage-resolve-' ~ requirement.commitment.id) }}">
                                                <select class="form-select form-select-sm mb-2" name="decision" required>{% for type in shortageDecisionTypes %}<option value="{{ type.value }}" {{ requirement.shortageDecision and requirement.shortageDecision.type.value == type.value ? 'selected' : '' }}>{{ type.label }}</option>{% endfor %}</select>
                                                <textarea class="form-control form-control-sm mb-2" name="reason" rows="2" minlength="5" maxlength="2000" required placeholder="Motivo y alcance de la decisión">{{ requirement.shortageDecision ? requirement.shortageDecision.reason : '' }}</textarea>
                                                <button type="submit" class="btn pf-button pf-button--secondary btn-sm">Guardar decisión</button>
                                            </form>
                                        </details>
                                    {% endif %}
                                {% elseif requirement.status == 'SUBSTITUTED' %}<span class="text-success">Parte original cubierta; faltante sustituido</span>{% elseif requirement.isCommitted and requirement.committedQuantity == '0.000000' %}<span class="text-success">Conciliado</span>{% elseif requirement.isCommitted %}<span class="text-success">Apartado pendiente de uso</span>{% else %}<span class="text-body-secondary">Disponible para apartar</span>{% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody></table></div>
                    {% if not serviceOrder.isPlanned %}<p class="small text-body-secondary mt-3 mb-0">La cobertura se puede consultar desde ahora; el apartado se habilita al completar la planificación de la orden.</p>{% endif %}
                </div>
            </section>
        {% endif %}

        {% if is_granted('service_orders.view_commercial') %}
            <section class="pf-card service-order-provenance mb-4">
                <header class="pf-card__header">
                    <h2 class="pf-card__title">Origen comercial</h2>
                    <p class="pf-card__description">Evidencia copiada al momento de crear la orden.</p>
                </header>
                <div class="pf-card__body">
                    <details class="service-order-disclosure">
                        <summary>
                            <span class="service-order-disclosure__label"><i class="bi bi-file-earmark-check" aria-hidden="true"></i> Consultar evidencia de aceptación</span>
                            <span class="service-order-disclosure__hint">Cotización, canal y observaciones</span>
                        </summary>
                    <dl class="row mb-0">
                        <dt class="col-sm-3">Cotización</dt>
                        <dd class="col-sm-9">
                            {% if is_granted('quotations.view') %}
                                <a href="{{ path('admin_quotations_show', {id: serviceOrder.sourceQuotation.id}) }}">{{ serviceOrder.sourceQuotationFolio }}</a>
                            {% else %}
                                {{ serviceOrder.sourceQuotationFolio }}
                            {% endif %}
                        </dd>
                        <dt class="col-sm-3">Aceptada</dt>
                        <dd class="col-sm-9">{{ serviceOrder.quotationSnapshot.accepted_at ? serviceOrder.quotationSnapshot.accepted_at|date('d/m/Y H:i', 'America/Mexico_City') : 'Sin fecha registrada' }}</dd>
                        {% if serviceOrder.quotationSnapshot.acceptance_channel ?? false %}
                            <dt class="col-sm-3">Canal</dt>
                            <dd class="col-sm-9">{{ serviceOrder.quotationSnapshot.acceptance_channel }}</dd>
                        {% endif %}
                        {% if serviceOrder.quotationSnapshot.acceptance_contact ?? false %}
                            <dt class="col-sm-3">Contacto</dt>
                            <dd class="col-sm-9">{{ serviceOrder.quotationSnapshot.acceptance_contact }}</dd>
                        {% endif %}
                        {% if serviceOrder.quotationSnapshot.acceptance_notes ?? false %}
                            <dt class="col-sm-3">Observación</dt>
                            <dd class="col-sm-9" style="white-space: pre-line;">{{ serviceOrder.quotationSnapshot.acceptance_notes }}</dd>
                        {% endif %}
                        {% if serviceOrder.quotationSnapshot.acceptance_evidence_reference ?? false %}
                            <dt class="col-sm-3">Evidencia</dt>
                            <dd class="col-sm-9" style="white-space: pre-line;">{{ serviceOrder.quotationSnapshot.acceptance_evidence_reference }}</dd>
                        {% endif %}
                    </dl>
                    </details>
                </div>
            </section>
        {% endif %}

        <section id="planning-section" class="pf-card mb-4">
            <header class="pf-card__header">
                <div>
                    <h2 class="pf-card__title">Planificación operativa</h2>
                    <p class="pf-card__subtitle">Revisa por partida la ruta, el tiempo de trabajo y la fecha pronosticada de fin.</p>
                </div>
            </header>

            {% if canAssignProduction and assignableOperatorPlans > 0 %}
                <div class="pf-card__body border-bottom bg-light">
                    <form method="post" action="{{ path('admin_service_orders_assign_pending_operators', {id: serviceOrder.id}) }}" class="row g-2 align-items-end">
                        <input type="hidden" name="_token" value="{{ csrf_token('service-order-assign-operators-' ~ serviceOrder.id) }}">
                        <div class="col-lg-5">
                            <label class="form-label" for="bulk-operator">Responsable para operaciones sin asignar</label>
                            <select class="form-select" id="bulk-operator" name="operator_id" required>
                                <option value="">Selecciona una persona</option>
                                {% for operator in productionOperators %}<option value="{{ operator.id }}">{{ operator.fullName }}</option>{% endfor %}
                            </select>
                        </div>
                        <div class="col-lg-4 small text-muted">Se asignará a {{ assignableOperatorPlans }} operación(es) reservadas, sin responsable y aún sin iniciar. Diseño se gestiona por su perfil. Puedes ajustar responsables por paso después.</div>
                        <div class="col-lg-3"><button type="submit" class="btn pf-button pf-button--secondary">Asignar operaciones sin responsable</button></div>
                    </form>
                    {% if productionOperators is empty %}<p class="small text-warning mb-0 mt-2">No hay usuarios activos con rol Operador. Activa o asigna el rol en Usuarios para continuar.</p>{% endif %}
                </div>
            {% endif %}

            {% if canPlan and planningProgress.auto_actions > 0 %}<div class="pf-card__body border-bottom service-order-auto-action">
                <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 align-items-lg-center">
                    <div class="flex-grow-1">
                        <strong>Preparar datos automáticamente</strong>
                        <p class="mb-0 small text-muted">PrintFlow aplica las máquinas compatibles y los tiempos que puede calcular con los datos actuales.</p>
                    </div>
                        <form method="post" action="{{ path('admin_service_orders_prepare_automatically', {id: serviceOrder.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('service-order-auto-prepare-' ~ serviceOrder.id) }}">
                            <button type="submit" class="btn pf-button pf-button--primary">Aplicar {{ planningProgress.auto_actions }} sugerencia(s)</button>
                        </form>
                </div>
            </div>{% endif %}

            <div class="pf-card__body d-flex flex-column gap-4">
                {% for item in itemsForDisplay %}
                    {% set plans = operationPlansByItem[item.id]|default([]) %}
                    <article class="service-order-work-item">
                        <header class="d-flex flex-column flex-md-row justify-content-between gap-2 mb-3">
                            <div>
                                <h3 class="h6 mb-1">Partida {{ item.displayLineNumber }} · {{ item.commercialItemSnapshot.name ?? item.commercialItem.name }}</h3>
                                <span class="text-muted small">{{ item.trackingCode }}</span>
                                <span class="text-muted small">{{ item.splitPosition is not null ? 'Cantidad de esta subpartida:' : 'Cantidad contratada:' }} {{ item.quantity }}</span>
                                {% if item.productionSpecificationsSnapshot.summary|default(item.specificationsSnapshot.summary|default(null)) %}
                                    <span class="d-block text-muted small mt-1">{{ item.productionSpecificationsSnapshot.summary|default(item.specificationsSnapshot.summary) }}</span>
                                {% endif %}
                                {% if item.routeVersion %}
                                    <span class="d-block text-muted small mt-1">Ruta aplicada: {{ item.routeVersion.nameSnapshot }} v{{ item.routeVersion.versionNumber }}</span>
                                {% endif %}
                                {% set itemForecast = productionForecast.items[item.id]|default(null) %}
                                {% set itemPlanningSummary = itemPlanningSummaryById[item.id]|default(null) %}
                                <div class="d-flex flex-wrap gap-2 align-items-center mt-2">
                                    <span class="badge {{ item.priority.value == 'urgent' ? 'text-bg-primary' : (item.priority.value == 'high' ? 'text-bg-info' : 'text-bg-light text-dark border') }}"><i class="bi {{ item.priority.value == 'urgent' ? 'bi-lightning-charge-fill' : (item.priority.value == 'high' ? 'bi-arrow-up-circle-fill' : 'bi-dash-circle') }}" aria-hidden="true"></i> Prioridad {{ item.priority.label }}</span>
                                    {% if itemPlanningSummary and itemPlanningSummary.finish_type == 'projected' %}
                                        <span class="badge text-bg-info"><i class="bi bi-calendar2-week" aria-hidden="true"></i> Pronóstico preliminar</span>
                                    {% elseif itemForecast and itemPlanningSummary and itemPlanningSummary.finish_at %}
                                        {% set itemRiskIcon = itemForecast.risk.value == 'late' ? 'bi-exclamation-triangle-fill' : (itemForecast.risk.value == 'tight' ? 'bi-clock-history' : (itemForecast.risk.value == 'on_track' ? 'bi-check-circle-fill' : 'bi-question-circle')) %}
                                        <span class="badge text-bg-{{ itemForecast.risk_tone }}"><i class="bi {{ itemRiskIcon }}" aria-hidden="true"></i> {{ itemForecast.risk_label }}</span>
                                    {% elseif itemForecast %}
                                        <span class="badge text-bg-{{ itemForecast.risk_tone }}">{{ itemForecast.risk_label }}</span>
                                    {% endif %}
                                </div>
                                {% if item.sourceFileSnapshot.status|default(null) == 'CLIENT_FILE_RECEIVED' %}
                                    <span class="d-block text-muted small mt-1"><i class="bi bi-paperclip" aria-hidden="true"></i> Archivo original del cliente registrado para revisión de Diseño.</span>
                                {% elseif item.sourceFileSnapshot.status|default(null) == 'DESIGN_PREPARATION_REQUIRED' %}
                                    <span class="d-block text-warning small mt-1"><i class="bi bi-palette" aria-hidden="true"></i> Diseño debe preparar o solicitar el archivo de impresión.</span>
                                {% endif %}
                            </div>
                            <div class="d-flex flex-column align-items-md-end gap-2">
                                <span class="pf-status-badge pf-status-badge--{{ itemForecast ? itemForecast.risk_tone : item.designStatus.badgeTone }}">{{ itemForecast ? itemForecast.risk_label : item.designStatus.label }}</span>
                                <span class="text-muted small">{{ plans|length }} {{ plans|length == 1 ? 'operación' : 'operaciones' }}</span>
                                {% if is_granted('production.view') %}
                                    <a href="{{ path('admin_design_show', {id: item.id}) }}" class="btn pf-button pf-button--secondary pf-button--sm">Abrir Diseño</a>
                                {% endif %}
                            </div>
                        </header>

                        {% if canManagePriority %}
                            <details class="service-order-disclosure service-order-disclosure--action mb-3">
                                <summary>
                                    <span class="service-order-disclosure__label"><i class="bi bi-flag" aria-hidden="true"></i> Cambiar prioridad</span>
                                    <span class="service-order-disclosure__hint">Revisar el impacto antes de aplicar</span>
                                </summary>
                                <form method="post" action="{{ path('admin_service_orders_preview_item_priority', {id: serviceOrder.id, item: item.id}) }}" class="pf-form border rounded p-3 mt-2">
                                    <input type="hidden" name="_token" value="{{ csrf_token('production-item-priority-' ~ serviceOrder.id ~ '-' ~ item.id) }}">
                                    <div class="row g-2 align-items-end">
                                        <div class="col-md-3">
                                            <label class="form-label" for="priority-{{ item.id }}">Nueva prioridad</label>
                                            <select class="form-select" id="priority-{{ item.id }}" name="priority" required>
                                                {% for option in productionPriorities %}
                                                    <option value="{{ option.value }}"{% if item.priority == option %} selected{% endif %}>{{ option.label }}</option>
                                                {% endfor %}
                                            </select>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label" for="priority-reason-{{ item.id }}">Motivo del cambio</label>
                                            <input class="form-control" id="priority-reason-{{ item.id }}" name="reason" minlength="5" maxlength="500" required>
                                        </div>
                                        <div class="col-md-3">
                                            <button type="submit" class="btn pf-button pf-button--secondary">Revisar impacto</button>
                                        </div>
                                    </div>
                                </form>
                            </details>
                        {% endif %}

                        {% if item.productionSpecificationsSnapshot._production_adjustment|default(null) %}
                            <div class="alert alert-warning py-2" role="status">Las medidas de producción fueron corregidas después de aplicar la ruta. Revisa las operaciones y confirma la ruta antes de planificar. Las medidas cotizadas y sus importes permanecen intactos.</div>
                        {% endif %}
                        {% if item.planningIssue %}<div class="alert alert-warning py-2" role="status">Requiere planificación: {{ item.planningIssue }}</div>{% endif %}
                        {% if canPlan and item.planningIssue == 'Las medidas de producción se corrigieron; revisa la ruta y confírmala antes de planificar.' %}
                            <form method="post" action="{{ path('admin_service_orders_confirm_item_route_review', {id: serviceOrder.id, item: item.id}) }}" class="mb-3">
                                <input type="hidden" name="_token" value="{{ csrf_token('service-order-item-route-review-' ~ serviceOrder.id ~ '-' ~ item.id) }}">
                                <button type="submit" class="btn pf-button pf-button--secondary">Confirmar que revisé esta ruta</button>
                            </form>
                        {% endif %}

                        {% if itemPlanningSummary %}
                            {% if itemPlanningSummary.operations > 0 %}
                            <div class="service-order-item-planning-summary" aria-label="Resumen de planificación de la partida {{ item.displayLineNumber }}">
                                <div class="service-order-item-planning-summary__fact">
                                    <span class="service-order-item-planning-summary__label">Tiempo de trabajo estimado</span>
                                    {% if itemPlanningSummary.duration_complete and itemPlanningSummary.estimated_minutes is not null %}
                                        {% set totalHours = (itemPlanningSummary.estimated_minutes / 60)|round(0, 'floor') %}
                                        {% set totalRemainder = itemPlanningSummary.estimated_minutes % 60 %}
                                        <strong>{% if totalHours > 0 %}{{ totalHours }} h{% endif %}{% if totalRemainder > 0 %} {{ totalRemainder }} min{% endif %}{% if totalHours == 0 and totalRemainder == 0 %}0 min{% endif %}</strong>
                                        <small>Horas de operación sumadas; los espacios entre jornadas se reflejan en la fecha de fin.</small>
                                    {% else %}
                                        <strong>{{ itemPlanningSummary.estimated }} de {{ itemPlanningSummary.operations }} operaciones estimadas</strong>
                                        <small>Completa los tiempos pendientes para calcular el total.</small>
                                    {% endif %}
                                </div>
                                <div class="service-order-item-planning-summary__fact service-order-item-planning-summary__fact--finish">
                                    <span class="service-order-item-planning-summary__label">Fin de producción pronosticado</span>
                                    {% if itemPlanningSummary.finish_at %}
                                        <strong>{{ itemPlanningSummary.finish_at|date('d/m/Y · H:i', 'America/Mexico_City') }}</strong>
                                        <small>
                                            {% if itemPlanningSummary.finish_type == 'projected' %}
                                                {% if itemPlanningSummary.machine_choice_required|default(false) %}
                                                    Las opciones compatibles tienen un término similar; el fin se confirma al elegir equipo y reservar.
                                                {% else %}
                                                    Estimado con la máquina sugerida; se confirma al reservar la agenda.
                                                {% endif %}
                                            {% elseif itemPlanningSummary.finish_type == 'actual' %}
                                                Fin real registrado al completar la última operación.
                                            {% else %}
                                                Calculado con la agenda reservada.
                                            {% endif %}
                                        </small>
                                    {% else %}
                                        <strong>Pendiente de pronóstico</strong>
                                        <small>Se necesita completar y programar la secuencia de operaciones.</small>
                                    {% endif %}
                                </div>
                                <div class="service-order-item-planning-summary__fact service-order-item-planning-summary__fact--progress">
                                    <span class="service-order-item-planning-summary__label">Avance de planificación</span>
                                    <strong>{{ itemPlanningSummary.ready }} / {{ itemPlanningSummary.operations }} listas</strong>
                                    <small>{{ itemPlanningSummary.with_equipment }} con equipo · {{ itemPlanningSummary.estimated }} con tiempo · {{ itemPlanningSummary.reserved }} con agenda</small>
                                </div>
                            </div>
                            {% else %}
                                <div class="alert alert-warning py-2" role="status">Esta partida aún no tiene una ruta activa de producción.</div>
                            {% endif %}
                        {% endif %}

                        <div class="service-order-route" aria-label="Secuencia de operaciones de la partida {{ item.displayLineNumber }}">
                            <div class="service-order-route__heading">
                                <strong>Ruta de producción</strong>
                                <span>Se conserva este orden. Agenda laboral: lunes a viernes, 08:00–18:00 (hora de Ciudad de México).</span>
                            </div>
                            <ol class="service-order-route__steps{{ plans|length > 3 ? ' service-order-route__steps--many' : '' }}">
                                {% for plan in plans %}
                                    {% set state = operationStates[plan.id]|default('scheduled') %}
                                    {% set planReservations = reservationsByPlan[plan.id]|default([]) %}
                                    {% set planPreview = operationSchedulePreviewByPlan[plan.id]|default(null) %}
                                    {% set shownEquipment = plan.equipment ?? (planPreview ? planPreview.equipment : null) %}
                                    {% set previewMinutes = plan.estimatedMinutes ?? (planPreview ? planPreview.estimated_minutes : null) %}
                                    {% set stateTone = state == 'complete' ? 'complete' : (state in ['active', 'paused'] ? 'active' : ((state == 'equipment' and shownEquipment) ? 'suggested' : ((state in ['equipment', 'estimate', 'blocked'] or planReservations is empty) ? 'attention' : 'scheduled'))) %}
                                    {% set stateLabel = state == 'complete' ? 'Completada' : (state == 'active' ? 'En curso' : (state == 'paused' ? 'Pausada' : (state == 'equipment' and shownEquipment ? 'Máquina sugerida · falta aplicar' : (state == 'equipment' ? 'Falta máquina' : (state == 'estimate' and previewMinutes ? 'Tiempo sugerido · falta aplicar' : (state == 'estimate' ? 'Falta tiempo' : (state == 'blocked' ? 'Bloqueada' : (planReservations is empty ? 'Falta agenda' : 'Programada')))))))) %}
                                    <li class="service-order-route__step service-order-route__step--{{ stateTone }}">
                                        <span class="service-order-route__number">{{ plan.sequenceNumber }}</span>
                                        <span class="service-order-route__copy">
                                            <strong>{{ plan.operationSnapshot.name ?? plan.operation.name }}</strong>
                                            <span class="service-order-route__state"><i class="bi {{ stateTone == 'complete' ? 'bi-check-circle' : (stateTone == 'attention' ? 'bi-exclamation-triangle' : 'bi-clock') }}" aria-hidden="true"></i> {{ stateLabel }}</span>
                                            {% if shownEquipment %}
                                                <small>{{ plan.equipment ? (plan.equipmentSnapshot.name ?? plan.equipment.name) : shownEquipment.name }}{% if planPreview and planPreview.equipment_is_suggested %} · sugerida{% endif %}</small>
                                            {% elseif planPreview and planPreview.machine_choice_required|default(false) %}
                                                <small>Opciones compatibles con término similar</small>
                                            {% elseif equipmentAvailabilityByPlan[plan.id].recommendation_reason|default(null) in ['same_completion', 'same_first_slot'] %}
                                                <small>Varias máquinas compatibles; requiere elección.</small>
                                            {% else %}
                                                <small>Equipo por asignar</small>
                                            {% endif %}
                                            {% if previewMinutes is not null %}
                                                {% set operationHours = (previewMinutes / 60)|round(0, 'floor') %}
                                                {% set operationRemainder = previewMinutes % 60 %}
                                                <small>Duración: {% if operationHours > 0 %}{{ operationHours }} h{% endif %}{% if operationRemainder > 0 %} {{ operationRemainder }} min{% endif %}{% if operationHours == 0 and operationRemainder == 0 %}0 min{% endif %}</small>
                                            {% else %}
                                                <small>Duración pendiente</small>
                                            {% endif %}
                                            {% if planReservations is not empty %}
                                                <span class="service-order-route__schedule-label"><i class="bi bi-calendar-check" aria-hidden="true"></i> Agenda reservada</span>
                                                <span class="service-order-route__slots">
                                                    {% for reservation in planReservations %}
                                                        <small>{{ reservation.startsAt|date('d/m H:i', 'America/Mexico_City') }}–{{ reservation.endsAt|date('H:i', 'America/Mexico_City') }}</small>
                                                    {% endfor %}
                                                </span>
                                            {% elseif planPreview and planPreview.ends_at %}
                                                <span class="service-order-route__schedule-label service-order-route__schedule-label--preview"><i class="bi bi-calendar2-week" aria-hidden="true"></i> Agenda estimada</span>
                                                <span class="service-order-route__slots">
                                                    <small>Inicio {{ planPreview.starts_at|date('d/m H:i', 'America/Mexico_City') }}</small>
                                                    <small>Fin {{ planPreview.ends_at|date('d/m H:i', 'America/Mexico_City') }}</small>
                                                </span>
                                            {% else %}
                                                <span class="service-order-route__schedule-label service-order-route__schedule-label--pending"><i class="bi bi-exclamation-circle" aria-hidden="true"></i> Agenda pendiente</span>
                                            {% endif %}
                                        </span>
                                    </li>
                                {% else %}
                                    <li class="service-order-route__empty">Esta partida aún no tiene operaciones.</li>
                                {% endfor %}
                            </ol>
                        </div>
                        <details class="service-order-plan-details mb-3">
                            <summary><i class="bi bi-sliders" aria-hidden="true"></i> {{ canPlan ? 'Editar secuencia, equipos y tiempos' : 'Ver detalle de las operaciones' }} <i class="bi bi-chevron-down" aria-hidden="true"></i></summary>
                        <div class="pf-table-responsive mb-3">
                            <table class="pf-table">
                                <thead>
                                    <tr>
                                        {% if canPlan and plans|length > 1 %}<th class="pf-table__cell--center" aria-label="Reordenar"></th>{% endif %}
                                        <th>Secuencia</th>
                                        <th>Operación</th>
                                        <th>Área</th>
                                        <th>Equipo</th>
                                        {% if canPlan %}<th class="pf-table__actions-cell">Acciones</th>{% endif %}
                                    </tr>
                                </thead>
                                <tbody
                                    {% if canPlan and plans|length > 1 %}
                                        data-controller="ui--sortable"
                                        data-ui--sortable-url-value="{{ path('admin_service_orders_reorder_item_operations', {id: serviceOrder.id, item: item.id}) }}"
                                        data-ui--sortable-token-value="{{ csrf_token('service-order-operation-reorder-' ~ item.id) }}"
                                    {% endif %}
                                >
                                    {% for plan in plans %}
                                        <tr data-id="{{ plan.id }}" data-sortable-id="{{ plan.id }}">
                                            {% if canPlan and plans|length > 1 %}
                                                <td class="pf-table__cell--center">
                                                    <button type="button" class="pf-sortable__handle" title="Arrastrar para reordenar" aria-label="Reordenar {{ plan.operationSnapshot.name ?? plan.operation.name }}">
                                                        <i class="bi bi-grip-vertical" aria-hidden="true"></i>
                                                    </button>
                                                </td>
                                            {% endif %}
                                            <td>{{ plan.sequenceNumber }}</td>
                                            <td>
                                                <strong>{{ plan.operationSnapshot.name ?? plan.operation.name }}</strong>
                                                <span class="d-block text-muted small">{{ plan.operationSnapshot.code ?? plan.operation.code }}</span>
                                                {% if plan.blockedReason %}<span class="badge text-bg-warning mt-1">Bloqueada: {{ plan.blockedReason }}</span>{% endif %}
                                            </td>
                                            <td>{{ plan.operationSnapshot.area_name ?? plan.operation.operationArea.name }}</td>
                                            <td>
                                                {% if canPlan %}
                                                    {% set planReservations = reservationsByPlan[plan.id]|default([]) %}
                                                    {% set planChoices = equipmentChoicesByPlan[plan.id]|default([]) %}
                                                    {% set planAvailability = equipmentAvailabilityByPlan[plan.id]|default(null) %}
                                                    {% if plan.equipment %}
                                                        <strong>{{ plan.equipmentSnapshot.name ?? plan.equipment.name }}</strong>
                                                        <span class="d-block text-muted small">{{ plan.equipment.code }}</span>
                                                        {% if plan.equipment.capacityUnit %}
                                                            <span class="d-block text-muted small">{{ plan.equipment.capacityRate }} {{ plan.equipment.capacityUnit.label }}{% if plan.equipment.capacityValidatedAt %} · capacidad validada{% else %} · capacidad por validar{% endif %}</span>
                                                        {% else %}
                                                            <span class="d-block text-warning small">Requiere tiempo manual justificado.</span>
                                                        {% endif %}
                                                        {% if planReservations is empty %}
                                                            <details class="service-order-disclosure service-order-disclosure--compact mt-2">
                                                                <summary><span class="service-order-disclosure__label">Reasignar máquina</span></summary>
                                                                {{ form_start(equipmentForms[plan.id], {action: path('admin_service_orders_assign_item_operation_equipment', {id: serviceOrder.id, plan: plan.id}), method: 'POST', attr: {class: 'pf-form mt-2'}}) }}
                                                                    {{ form_errors(equipmentForms[plan.id]) }}
                                                                    {{ form_widget(equipmentForms[plan.id].equipment, {attr: {class: 'form-select form-select-sm mb-2'}}) }}
                                                                    <button type="submit" class="btn pf-button pf-button--secondary pf-button--sm">Guardar máquina</button>
                                                                {{ form_end(equipmentForms[plan.id]) }}
                                                            </details>
                                                        {% endif %}
                                                    {% elseif recommendedEquipmentByPlan[plan.id]|default(null) %}
                                                        <strong>Recomendada: {{ recommendedEquipmentByPlan[plan.id].name }}</strong>
                                                        <span class="d-block text-muted small">{{ recommendedEquipmentByPlan[plan.id].code }} · {% if planAvailability.recommendation_reason|default(null) == 'earliest_completion' %}termina antes según la agenda actual{% elseif planAvailability.recommendation_reason|default(null) == 'earliest_slot' %}tiene el primer espacio disponible{% else %}única máquina compatible{% endif %}</span>
                                                        {% if planChoices|length > 1 %}
                                                            {{ form_start(equipmentForms[plan.id], {action: path('admin_service_orders_assign_item_operation_equipment', {id: serviceOrder.id, plan: plan.id}), method: 'POST', attr: {class: 'pf-form mt-2'}}) }}
                                                                {{ form_errors(equipmentForms[plan.id]) }}
                                                                {{ form_widget(equipmentForms[plan.id].equipment, {attr: {class: 'form-select form-select-sm mb-2'}}) }}
                                                                <button type="submit" class="btn pf-button pf-button--secondary pf-button--sm">Guardar máquina seleccionada</button>
                                                            {{ form_end(equipmentForms[plan.id]) }}
                                                        {% endif %}
                                                    {% elseif planChoices is empty %}
                                                        <span class="text-warning">No hay máquina compatible disponible.</span>
                                                    {% else %}
                                                        <span class="d-block text-muted small mb-1">Elige una máquina compatible</span>
                                                        {% if planAvailability.recommendation_reason|default(null) == 'same_completion' %}<span class="d-block text-muted small mb-1">Las opciones tienen el mismo término estimado; elige según material y preferencia del taller.</span>{% elseif planAvailability.recommendation_reason|default(null) == 'same_first_slot' %}<span class="d-block text-muted small mb-1">Las opciones tienen la misma disponibilidad estimada; elige según material y preferencia del taller.</span>{% endif %}
                                                        {% if planAvailability.blocked_by|default(null) %}<span class="d-block text-muted small mb-1">El horario de este paso depende de completar {{ planAvailability.blocked_by }}.</span>{% endif %}
                                                        {{ form_start(equipmentForms[plan.id], {action: path('admin_service_orders_assign_item_operation_equipment', {id: serviceOrder.id, plan: plan.id}), method: 'POST', attr: {class: 'pf-form'}}) }}
                                                            {{ form_errors(equipmentForms[plan.id]) }}
                                                            {{ form_widget(equipmentForms[plan.id].equipment, {attr: {class: 'form-select form-select-sm mb-2'}}) }}
                                                            <button type="submit" class="btn pf-button pf-button--secondary pf-button--sm">Guardar máquina</button>
                                                        {{ form_end(equipmentForms[plan.id]) }}
                                                    {% endif %}
                                                    {% if planReservations is empty and planAvailability.options|default([])|length > 0 %}
                                                        <ul class="service-order-machine-options list-unstyled mb-0 mt-2">
                                                            {% for machineOption in planAvailability.options %}
                                                                <li class="{% if machineOption.recommended %}is-recommended{% endif %}">
                                                                    <span class="fw-semibold">{{ machineOption.equipment.name }}</span>
                                                                    {% if machineOption.recommended %}<span class="badge text-bg-success ms-1">Recomendada</span>{% endif %}
                                                                    {% if machineOption.starts_at %}
                                                                        <span class="d-block">{% if planAvailability.blocked_by|default(null) %}Primer espacio del equipo: {{ machineOption.starts_at|date('d/m H:i', 'America/Mexico_City') }} · espera a {{ planAvailability.blocked_by }}{% elseif machineOption.ends_at %}Inicio estimado: {{ machineOption.starts_at|date('d/m H:i', 'America/Mexico_City') }} · término: {{ machineOption.ends_at|date('d/m H:i', 'America/Mexico_City') }}{% if machineOption.estimated_minutes %} · ~{{ (machineOption.estimated_minutes / 60)|number_format(1, ',', '.') }} h{% endif %}{% else %}Primer espacio del equipo: {{ machineOption.starts_at|date('d/m H:i', 'America/Mexico_City') }}{% endif %}{% if machineOption.estimate_source %}<span class="d-block text-muted">Según {% if machineOption.estimate_source == 'validated_capacity' %}capacidad validada{% elseif machineOption.estimate_source == 'product_standard' %}estándar del Producto{% elseif machineOption.estimate_source == 'manual' %}tiempo manual{% else %}estimación guardada{% endif %}.</span>{% endif %}</span>
                                                                    {% endif %}
                                                                    {% if machineOption.unavailable_reason %}<span class="d-block text-warning">{{ machineOption.unavailable_reason }}</span>{% endif %}
                                                                </li>
                                                            {% endfor %}
                                                        </ul>
                                                    {% endif %}
                                                {% elseif plan.equipment %}
                                                    <strong>{{ plan.equipmentSnapshot.name ?? plan.equipment.name }}</strong>
                                                    <span class="d-block text-muted small">{{ plan.equipmentSnapshot.code ?? plan.equipment.code }}</span>
                                                {% else %}
                                                    <span class="text-muted">Sin equipo asignado</span>
                                                {% endif %}
                                            </td>
                                            {% if canPlan %}
                                                <td class="pf-table__actions-cell">
                                                <details class="service-order-disclosure service-order-disclosure--compact">
                                                    <summary><span class="service-order-disclosure__label">Acciones de la operación</span></summary>
                                                    <form
                                                        method="post"
                                                        action="{{ path('admin_service_orders_remove_item_operation', {id: serviceOrder.id, plan: plan.id}) }}"
                                                        class="mt-2"
                                                        data-controller="ui--confirm-action"
                                                        data-action="submit->ui--confirm-action#submit"
                                                        data-ui--confirm-action-title-value="¿Retirar operación?"
                                                        data-ui--confirm-action-text-value="La operación dejará de formar parte de esta ruta; se conservará el evento en la bitácora."
                                                        data-ui--confirm-action-confirm-button-text-value="Sí, retirar"
                                                        data-ui--confirm-action-cancel-button-text-value="Cancelar"
                                                        data-ui--confirm-action-icon-value="warning"
                                                    >
                                                        <input type="hidden" name="_token" value="{{ csrf_token('service-order-operation-remove-' ~ plan.id) }}">
                                                        <button type="submit" class="btn pf-button pf-button--danger pf-button--sm">Retirar operación</button>
                                                    </form>
                                                </details>
                                                </td>
                                            {% endif %}
                                        </tr>
                                        {% set planReservations = reservationsByPlan[plan.id]|default([]) %}
                                        <tr class="table-light">
                                            <td colspan="{{ canPlan ? (plans|length > 1 ? 6 : 5) : 4 }}">
                                                <div class="d-flex flex-column gap-2">
                                                    <div>
                                                    {% if plan.estimateKind %}
                                                        <strong>Estimación {{ plan.estimateKind.value == 'manual' ? 'manual' : (plan.estimateKind.value == 'standard' ? 'estándar del Producto' : 'calculada por máquina') }}:</strong>
                                                            {{ plan.estimatedMinutes }} min
                                                            {% if plan.estimatedLoadValue and plan.estimatedLoadUnit %} · Carga {{ plan.estimatedLoadValue }} {{ plan.estimatedLoadUnit.label }}{% endif %}
                                                            {% if plan.estimateKind.value == 'manual' %}<span class="text-muted"> · {{ plan.manualEstimateReason }}</span>{% endif %}
                                                            {% set measuredMinutes = plan.measuredActiveMinutes %}
                                                            {% if plan.actualMinutes is not null %}
                                                                <span class="ms-2"><strong>Real corregido:</strong> {{ plan.actualMinutes }} min · Diferencia: {{ plan.actualMinutes - plan.estimatedMinutes }} min</span>
                                                            {% elseif measuredMinutes is not null %}
                                                                <span class="ms-2"><strong>Real acumulado:</strong> {{ measuredMinutes }} min · Diferencia: {{ measuredMinutes - plan.estimatedMinutes }} min</span>
                                                            {% endif %}
                                                        {% else %}
                                                            <span class="text-warning">Falta calcular el tiempo.</span>
                                                        {% endif %}
                                                    </div>
                                                    {% if planReservations|length > 0 %}
                                                        <div>
                                                            <strong>Reservas:</strong>
                                                            {% for reservation in planReservations %}
                                                                <span class="badge text-bg-light border">{{ reservation.startsAt|date('d/m H:i', 'America/Mexico_City') }}–{{ reservation.endsAt|date('d/m H:i', 'America/Mexico_City') }} · {{ reservation.equipment.code }}</span>
                                                            {% endfor %}
                                                        </div>
                                                        {% if (canReprogramSchedule and scheduleAdjustablePlans[plan.id]|default(false)) or plan.schedulePinned %}
                                                            <details class="service-order-disclosure service-order-disclosure--compact">
                                                                <summary><span class="service-order-disclosure__label">Protección de agenda</span></summary>
                                                                {% if canReprogramSchedule and scheduleAdjustablePlans[plan.id]|default(false) %}
                                                                    <form method="post" action="{{ path('admin_service_orders_set_operation_schedule_pin', {id: serviceOrder.id, plan: plan.id}) }}" class="mt-2">
                                                                        <input type="hidden" name="_token" value="{{ csrf_token('production-schedule-pin-' ~ plan.id) }}">
                                                                        <input type="hidden" name="pinned" value="{{ plan.schedulePinned ? '0' : '1' }}">
                                                                        <button type="submit" class="btn pf-button pf-button--secondary pf-button--sm">{{ plan.schedulePinned ? 'Desfijar de la agenda' : 'Fijar en la agenda' }}</button>
                                                                    </form>
                                                                {% elseif plan.schedulePinned %}
                                                                    <span class="badge text-bg-secondary">Reserva protegida ante reprogramaciones</span>
                                                                {% endif %}
                                                            </details>
                                                        {% endif %}
                                                    {% endif %}
                                                    {% if canPlan and planReservations is empty and not plan.estimateKind %}
                                                        {% if not plan.equipment %}
                                                            <p class="mb-0 small text-muted">Primero asigna la máquina compatible.</p>
                                                        {% elseif not plan.estimateKind %}
                                                            {% if automaticEstimateByPlan[plan.id]|default(false) %}
                                                                <p class="mb-0 small text-muted">El tiempo se calcula automáticamente con las medidas del producto.</p>
                                                            {% elseif physicalEstimateByPlan[plan.id]|default(false) %}
                                                                {% set requiredLoadUnit = requiredLoadUnitByPlan[plan.id] %}
                                                                <form method="post" action="{{ path('admin_service_orders_estimate_item_operation', {id: serviceOrder.id, plan: plan.id}) }}" class="pf-form">
                                                                    <input type="hidden" name="_token" value="{{ csrf_token('service-order-operation-estimate-' ~ plan.id) }}">
                                                                    <input type="hidden" name="load_unit" value="{{ requiredLoadUnit.value }}">
                                                                    <label class="form-label" for="load-{{ plan.id }}">Captura {{ requiredLoadUnit.label }} reales para calcular el tiempo</label>
                                                                    <div class="d-flex flex-wrap gap-2 align-items-end">
                                                                        <input class="form-control form-control-sm" style="max-width: 260px" id="load-{{ plan.id }}" name="load" inputmode="decimal" required value="{{ plan.estimatedLoadValue ?? '' }}" placeholder="Cantidad física">
                                                                        <button type="submit" class="btn pf-button pf-button--secondary pf-button--sm">Calcular tiempo</button>
                                                                    </div>
                                                                </form>
                                                                {% if requiredLoadUnit.value == 'cut_cm' %}<p class="form-text mb-0">Usa la trayectoria real del vector; no se deduce de la cantidad de piezas.</p>{% elseif requiredLoadUnit.value == 'linear_m' %}<p class="form-text mb-0">Usa los metros reales del material según el acomodo.</p>{% endif %}
                                                            {% else %}
                                                                <p class="small text-warning mb-0">La capacidad de esta máquina necesita revisión. Usa la estimación manual si ya conoces el tiempo.</p>
                                                            {% endif %}
                                                            <details class="service-order-disclosure service-order-disclosure--compact mt-2">
                                                                <summary>
                                                                    <span class="service-order-disclosure__label">Capturar tiempo manual</span>
                                                                    <span class="service-order-disclosure__hint">Solo cuando no se pueda calcular</span>
                                                                </summary>
                                                                <form method="post" action="{{ path('admin_service_orders_estimate_item_operation', {id: serviceOrder.id, plan: plan.id}) }}" class="pf-form mt-2">
                                                                    <input type="hidden" name="_token" value="{{ csrf_token('service-order-operation-estimate-' ~ plan.id) }}">
                                                                    {% if requiredLoadUnitByPlan[plan.id]|default(null) %}<input type="hidden" name="load_unit" value="{{ requiredLoadUnitByPlan[plan.id].value }}">{% endif %}
                                                                    <div class="d-flex flex-wrap gap-2 align-items-end">
                                                                        <div><label class="form-label" for="manual-minutes-{{ plan.id }}">Tiempo estimado (minutos)</label><input class="form-control form-control-sm" id="manual-minutes-{{ plan.id }}" name="manual_minutes" type="number" min="1" max="999999" required></div>
                                                                        <div class="flex-grow-1"><label class="form-label" for="estimate-reason-{{ plan.id }}">Motivo o dato de apoyo</label><input class="form-control form-control-sm" id="estimate-reason-{{ plan.id }}" name="reason" minlength="5" maxlength="500" required></div>
                                                                        <button type="submit" class="btn pf-button pf-button--secondary pf-button--sm">Guardar tiempo manual</button>
                                                                    </div>
                                                                </form>
                                                            </details>
                                                        {% endif %}
                                                    {% elseif canPlan and planReservations is empty and plan.estimatedMinutes and plan.equipment %}
                                                        <details class="service-order-disclosure service-order-disclosure--compact mt-2">
                                                            <summary><span class="service-order-disclosure__label">Ajustar estimación</span></summary>
                                                            <form method="post" action="{{ path('admin_service_orders_estimate_item_operation', {id: serviceOrder.id, plan: plan.id}) }}" class="pf-form mt-2">
                                                                <input type="hidden" name="_token" value="{{ csrf_token('service-order-operation-estimate-' ~ plan.id) }}">
                                                                {% if requiredLoadUnitByPlan[plan.id]|default(null) %}<input type="hidden" name="load_unit" value="{{ requiredLoadUnitByPlan[plan.id].value }}">{% endif %}
                                                                <div class="d-flex flex-wrap gap-2 align-items-end">
                                                                    <div><label class="form-label" for="edit-load-{{ plan.id }}">Carga física ({{ plan.estimatedLoadUnit ? plan.estimatedLoadUnit.label : (requiredLoadUnitByPlan[plan.id] ? requiredLoadUnitByPlan[plan.id].label : 'opcional') }})</label><input class="form-control form-control-sm" id="edit-load-{{ plan.id }}" name="load" inputmode="decimal" value="{{ plan.estimatedLoadValue ?? '' }}"></div>
                                                                    <div><label class="form-label" for="edit-minutes-{{ plan.id }}">Minutos manuales (opcional)</label><input class="form-control form-control-sm" id="edit-minutes-{{ plan.id }}" name="manual_minutes" type="number" min="1" max="999999"></div>
                                                                    <div class="flex-grow-1"><label class="form-label" for="edit-reason-{{ plan.id }}">Motivo si usas tiempo manual</label><input class="form-control form-control-sm" id="edit-reason-{{ plan.id }}" name="reason" minlength="5" maxlength="500"></div>
                                                                    <button type="submit" class="btn pf-button pf-button--secondary pf-button--sm">Actualizar tiempo</button>
                                                                </div>
                                                            </form>
                                                        </details>
                                                    {% endif %}
                                                    {% if planReservations|length > 0 %}
                                                        <details class="service-order-disclosure service-order-disclosure--compact">
                                                            {% set isDesignOperation = plan.operationSnapshot.code|default(plan.operation.code) == 'PRE-DISENO' %}
                                                            <summary><span class="service-order-disclosure__label">{{ isDesignOperation ? 'Tiempo real de Diseño' : 'Responsable y tiempo real' }}</span></summary>
                                                            {% if canAssignProduction and operatorAssignmentWindowOpen and not isDesignOperation and not plan.hasStartedExecution %}
                                                                <form method="post" action="{{ path('admin_service_orders_assign_item_operation_operator', {id: serviceOrder.id, plan: plan.id}) }}" class="d-flex flex-wrap gap-2 align-items-center mt-2">
                                                                    <input type="hidden" name="_token" value="{{ csrf_token('service-order-operation-operator-' ~ plan.id) }}">
                                                                    <label class="form-label mb-0" for="operator-{{ plan.id }}">Operador (opcional)</label>
                                                                    <select class="form-select form-select-sm" style="max-width: 280px" id="operator-{{ plan.id }}" name="operator_id">
                                                                        <option value="">Sin asignar</option>
                                                                        {% for operator in productionOperators %}<option value="{{ operator.id }}"{% if plan.assignedOperator and plan.assignedOperator.id == operator.id %} selected{% endif %}>{{ operator.fullName }}</option>{% endfor %}
                                                                    </select>
                                                                    <button type="submit" class="btn pf-button pf-button--secondary pf-button--sm">Guardar operador</button>
                                                                </form>
                                                            {% elseif not isDesignOperation and plan.assignedOperator %}
                                                                <p class="small mt-2 mb-0"><strong>Responsable:</strong> {{ plan.assignedOperator.fullName }}{% if plan.hasStartedExecution %} · La operación ya inició; la asignación queda protegida.{% endif %}</p>
                                                            {% endif %}
                                                            {% if plan.measuredActiveMinutes is not null %}<p class="small mt-2 mb-0"><strong>Tiempo registrado:</strong> {{ plan.measuredActiveMinutes }} min activos (pausas excluidas; calculado automáticamente).</p>{% endif %}
                                                            {% if canManageProductionPlanning %}
                                                                <details class="service-order-disclosure service-order-disclosure--compact mt-2">
                                                                    <summary><span class="service-order-disclosure__label">Corregir tiempo real (excepción)</span></summary>
                                                                    <form method="post" action="{{ path('admin_service_orders_record_item_operation_actual_time', {id: serviceOrder.id, plan: plan.id}) }}" class="d-flex flex-wrap gap-2 align-items-end mt-2">
                                                                        <input type="hidden" name="_token" value="{{ csrf_token('service-order-operation-actual-' ~ plan.id) }}">
                                                                        <div><label class="form-label mb-1" for="actual-minutes-{{ plan.id }}">Tiempo corregido (min)</label><input class="form-control form-control-sm" id="actual-minutes-{{ plan.id }}" name="actual_minutes" type="number" min="0" required value="{{ plan.actualMinutes ?? '' }}"></div>
                                                                        <div class="flex-grow-1"><label class="form-label mb-1" for="actual-note-{{ plan.id }}">Motivo de la corrección</label><input class="form-control form-control-sm" id="actual-note-{{ plan.id }}" name="actual_note" maxlength="500" minlength="5" required value="{{ plan.actualNote ?? '' }}"></div>
                                                                        <button type="submit" class="btn pf-button pf-button--secondary pf-button--sm">Guardar corrección</button>
                                                                    </form>
                                                                </details>
                                                            {% endif %}
                                                        </details>
                                                    {% elseif not canPlan and plan.assignedOperator and (plan.operationSnapshot.code|default(plan.operation.code)) != 'PRE-DISENO' %}
                                                        <span><strong>Operador:</strong> {{ plan.assignedOperator.fullName }}</span>
                                                    {% endif %}
                                                </div>
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="{{ canPlan ? (plans|length > 1 ? 6 : 5) : 4 }}" class="pf-table__empty">Aún no hay operaciones planificadas para esta partida.</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>

                        </details>

                        {% if canPlan %}
                            <details class="service-order-disclosure service-order-disclosure--action">
                                <summary>
                                    <span class="service-order-disclosure__label"><i class="bi bi-plus-circle" aria-hidden="true"></i> Agregar paso de producción</span>
                                    <span class="service-order-disclosure__hint">Añadir una operación a la ruta</span>
                                </summary>
                                <div class="pt-3">
                                    {{ form_start(itemOperationForms[item.id], {action: path('admin_service_orders_add_item_operation', {id: serviceOrder.id, item: item.id}), method: 'POST', attr: {class: 'pf-form'}}) }}
                                        {{ form_errors(itemOperationForms[item.id]) }}
                                        <div class="row g-3 align-items-end">
                                            <div class="col-lg-8">{{ form_row(itemOperationForms[item.id].operation) }}</div>
                                            <div class="col-lg-4"><button type="submit" class="btn pf-button pf-button--primary">Agregar a ruta</button></div>
                                        </div>
                                    {{ form_end(itemOperationForms[item.id]) }}
                                </div>
                            </details>

                            <details class="service-order-disclosure service-order-disclosure--action mt-2">
                                <summary>
                                    <span class="service-order-disclosure__label"><i class="bi bi-rulers" aria-hidden="true"></i> Ajustar medidas de fabricación</span>
                                    <span class="service-order-disclosure__hint">Solo cambia los datos de producción</span>
                                </summary>
                                <div class="pt-3">
                                    <p class="small text-muted">Captura solo las medidas que cambian; deja las demás vacías. La cotización aceptada y sus importes no se modifican.</p>
                                    <form method="post" action="{{ path('admin_service_orders_correct_item_specifications', {id: serviceOrder.id, item: item.id}) }}" class="pf-form">
                                        <input type="hidden" name="_token" value="{{ csrf_token('service-order-item-specifications-' ~ serviceOrder.id ~ '-' ~ item.id) }}">
                                        <div class="row g-3 align-items-end">
                                            <div class="col-md-3"><label class="form-label" for="width-{{ item.id }}">Ancho terminado corregido (cm)</label><input class="form-control" id="width-{{ item.id }}" name="finished_width_cm" inputmode="decimal"></div>
                                            <div class="col-md-3"><label class="form-label" for="height-{{ item.id }}">Alto terminado corregido (cm)</label><input class="form-control" id="height-{{ item.id }}" name="finished_height_cm" inputmode="decimal"></div>
                                            <div class="col-md-4"><label class="form-label" for="spec-reason-{{ item.id }}">Motivo</label><input class="form-control" id="spec-reason-{{ item.id }}" name="reason" maxlength="500" required></div>
                                            <div class="col-md-2"><button type="submit" class="btn pf-button pf-button--secondary">Guardar medidas</button></div>
                                        </div>
                                    </form>
                                </div>
                            </details>

                            {% if splitEligibleItems[item.id]|default(false) %}
                                <details class="service-order-disclosure service-order-disclosure--action mt-2">
                                    <summary>
                                        <span class="service-order-disclosure__label"><i class="bi bi-diagram-2" aria-hidden="true"></i> Dividir cantidad en partidas</span>
                                        <span class="service-order-disclosure__hint">Para fabricar o entregar por separado</span>
                                    </summary>
                                    <div class="pt-3">
                                        <p class="small text-muted">Las nuevas partidas reemplazan este renglón en la orden. Captura una cantidad por línea; su suma debe coincidir con la cantidad contratada. El sistema distribuye el importe al centavo y conserva el total de la orden.</p>
                                        <form method="post" action="{{ path('admin_service_orders_split_item', {id: serviceOrder.id, item: item.id}) }}" class="pf-form">
                                            <input type="hidden" name="_token" value="{{ csrf_token('service-order-item-split-' ~ serviceOrder.id ~ '-' ~ item.id) }}">
                                            <div class="row g-3 align-items-end">
                                                <div class="col-md-4"><label class="form-label" for="quantities-{{ item.id }}">Cantidades hijas</label><textarea class="form-control" id="quantities-{{ item.id }}" name="quantities" rows="3" required placeholder="1&#10;1"></textarea><div class="form-text">Una por línea. Puedes usar coma decimal; admite de 2 a 20 renglones.</div></div>
                                                <div class="col-md-6"><label class="form-label" for="split-reason-{{ item.id }}">Motivo de la división</label><input class="form-control" id="split-reason-{{ item.id }}" name="reason" maxlength="500" required></div>
                                                <div class="col-md-2"><button type="submit" class="btn pf-button pf-button--secondary">Dividir partida</button></div>
                                            </div>
                                        </form>
                                    </div>
                                </details>
                            {% endif %}
                        {% endif %}
                    </article>
                {% endfor %}
            </div>

            {% if canPlan %}
                <footer class="pf-card__body border-top d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                    <div>
                        <p class="mb-1 text-muted small">Las operaciones se reservan respetando su secuencia y evitando cruces en cada máquina.{% if is_granted('production_calendar.manage') %} Ajusta turnos y excepciones en <a href="{{ path('admin_production_calendar_index') }}">jornada de producción</a>.{% endif %}</p>
                        {% if planningProgress.operations > 0 and planningProgress.reserved == planningProgress.operations and not serviceOrder.commitmentDate %}
                            <p class="mb-0 small">La agenda está lista. Confirma la fecha compromiso en el resumen de la orden para cerrar la planificación.</p>
                        {% elseif planningHasIssues %}
                            <p class="mb-0 small text-warning">Resuelve las partidas u operaciones marcadas antes de reservar la orden.</p>
                        {% elseif planningProgress.operations > 0 and planningProgress.ready < planningProgress.operations %}
                            <p class="mb-0 small">{{ planningProgress.operations - planningProgress.ready }} operación(es) todavía necesitan datos o reserva.</p>
                        {% endif %}
                    </div>
                    {% if canConfirmPlanning %}
                        <form
                            method="post"
                            action="{{ path('admin_service_orders_confirm_planning', {id: serviceOrder.id}) }}"
                            data-controller="ui--confirm-action"
                            data-action="submit->ui--confirm-action#submit"
                            data-ui--confirm-action-title-value="¿Confirmar la planificación de la orden?"
                            data-ui--confirm-action-text-value="PrintFlow reservará los tramos pendientes en secuencia y confirmará la planificación en una sola operación. Si encuentra un bloqueo, no dejará reservas parciales."
                            data-ui--confirm-action-confirm-button-text-value="Confirmar planificación"
                            data-ui--confirm-action-cancel-button-text-value="Revisar orden"
                            data-ui--confirm-action-icon-value="question"
                        >
                            <input type="hidden" name="_token" value="{{ csrf_token('service-order-confirm-planning-' ~ serviceOrder.id) }}">
                            <button type="submit" class="btn pf-button pf-button--primary">Confirmar planificación</button>
                        </form>
                    {% elseif canReserveFullPlan %}
                        <form
                            method="post"
                            action="{{ path('admin_service_orders_reserve_full_plan', {id: serviceOrder.id}) }}"
                            data-controller="ui--confirm-action"
                            data-action="submit->ui--confirm-action#submit"
                            data-ui--confirm-action-title-value="¿Reservar la agenda de toda la orden?"
                            data-ui--confirm-action-text-value="El sistema reservará las operaciones en secuencia y sin solapes. Si algún tramo no puede asignarse, no se guardará ninguna reserva de esta acción."
                            data-ui--confirm-action-confirm-button-text-value="Reservar orden"
                            data-ui--confirm-action-cancel-button-text-value="Revisar datos"
                            data-ui--confirm-action-icon-value="question"
                        >
                            <input type="hidden" name="_token" value="{{ csrf_token('service-order-reserve-full-plan-' ~ serviceOrder.id) }}">
                            <button type="submit" class="btn pf-button pf-button--primary">Reservar agenda completa</button>
                        </form>
                    {% endif %}
                </footer>
            {% endif %}
        </section>

        <section class="pf-card mb-4">
            {% if is_granted('service_orders.view_commercial') %}
                <header class="pf-card__header">
                    <h2 class="pf-card__title">Partidas e importes contratados</h2>
                    <p class="pf-card__description">Las divisiones sustituyen el renglón original y reparten su cantidad e importe. La cotización aceptada y el total de la orden permanecen sin cambios.</p>
                </header>
            {% else %}
                <header class="pf-card__header">
                    <h2 class="pf-card__title">Partidas de la orden</h2>
                    <p class="pf-card__description">Cantidades y especificaciones para el seguimiento operativo.</p>
                </header>
            {% endif %}
            <div class="pf-card__body p-0">
                <div class="pf-table-responsive">
                    <table class="pf-table">
                        <thead><tr><th>#</th><th>Concepto</th><th class="pf-table__cell--right">Cantidad</th>{% if is_granted('service_orders.view_commercial') %}<th class="pf-table__cell--right">P. unitario</th><th class="pf-table__cell--right">Importe</th>{% endif %}</tr></thead>
                        <tbody>
                            {% for item in itemsForDisplay %}
                                <tr>
                                    <td>{{ item.displayLineNumber }}<span class="d-block text-muted small">{{ item.trackingCode }}</span></td>
                                    <td>
                                        <strong>{{ item.commercialItemSnapshot.name ?? item.commercialItem.name }}</strong>
                                        <span class="d-block text-muted small">{{ item.commercialItemSnapshot.code ?? '' }}</span>
                                        {% if item.specificationsSnapshot.summary|default(null) %}
                                            <span class="d-block text-muted small mt-1">{{ item.specificationsSnapshot.summary }}</span>
                                        {% endif %}
                                    </td>
                                    <td class="pf-table__cell--right">{{ item.quantity }}</td>
                                    {% if is_granted('service_orders.view_commercial') %}
                                        <td class="pf-table__cell--right">${{ item.unitPrice|number_format(2, '.', ',') }}</td>
                                        <td class="pf-table__cell--right">${{ item.lineSubtotal|number_format(2, '.', ',') }}</td>
                                    {% endif %}
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
            {% if is_granted('service_orders.view_commercial') %}
                <div class="pf-card__body border-top">
                    <dl class="row justify-content-end mb-0">
                        <dt class="col-sm-3 text-sm-end">Subtotal</dt><dd class="col-sm-2 text-sm-end">${{ serviceOrder.subtotal|number_format(2, '.', ',') }}</dd>
                        <dt class="col-sm-3 text-sm-end">Descuento</dt><dd class="col-sm-2 text-sm-end">${{ serviceOrder.discountAmount|number_format(2, '.', ',') }}</dd>
                        <dt class="col-sm-3 text-sm-end">IVA</dt><dd class="col-sm-2 text-sm-end">${{ serviceOrder.taxAmount|number_format(2, '.', ',') }}</dd>
                        <dt class="col-sm-3 text-sm-end">Total</dt><dd class="col-sm-2 text-sm-end fw-semibold">${{ serviceOrder.total|number_format(2, '.', ',') }} {{ serviceOrder.currency }}</dd>
                    </dl>
                </div>
            {% endif %}
        </section>

        {% if is_granted('service_orders.view_commercial') and serviceOrder.notes %}
            <section class="pf-card">
                <header class="pf-card__header"><h2 class="pf-card__title">Notas comerciales</h2></header>
                <div class="pf-card__body" style="white-space: pre-line;">{{ serviceOrder.notes }}</div>
            </section>
        {% endif %}
    </section>
{% endblock %}
