{% extends 'layouts/app.html.twig' %}

{% block title %}{{ serviceOrder.folio }} | PrintFlow{% endblock %}

{% block app_navigation_active %}service_orders{% endblock %}

{% block app_breadcrumb %}Comercial / Órdenes de servicio / Detalle{% endblock %}

{% block app_content %}
    <section class="pf-page__content">
        <header class="pf-page-header">
            <div class="pf-page-header__content">
                <p class="pf-page-header__eyebrow">Comercial / Órdenes de servicio</p>
                <h1 class="pf-page-header__title">{{ serviceOrder.folio }}</h1>
                <p class="pf-page-header__description">
                    Creada desde la cotización <a href="{{ path('admin_quotations_show', {id: serviceOrder.sourceQuotation.id}) }}">{{ serviceOrder.sourceQuotationFolio }}</a>.
                    Las partidas e importes de origen están congelados.
                </p>
            </div>
            <div class="pf-page-header__actions">
                <span class="pf-status-badge pf-status-badge--{{ serviceOrder.status.badgeTone }}">{{ serviceOrder.status.label }}</span>
                <a href="{{ path('admin_service_orders_index') }}" class="btn pf-button pf-button--secondary">
                    <i class="bi bi-arrow-left" aria-hidden="true"></i>
                    Volver
                </a>
            </div>
        </header>

        <div class="row g-4 mb-4">
            <div class="col-12 col-md-4">
                <section class="pf-card h-100">
                    <div class="pf-card__body">
                        <span class="text-muted small d-block mb-1">Total contratado</span>
                        <strong class="fs-3">${{ serviceOrder.total|number_format(2, '.', ',') }} {{ serviceOrder.currency }}</strong>
                        <span class="d-block text-muted small mt-2">IVA: ${{ serviceOrder.taxAmount|number_format(2, '.', ',') }}</span>
                    </div>
                </section>
            </div>
            <div class="col-12 col-md-4">
                <section class="pf-card h-100">
                    <div class="pf-card__body">
                        <span class="text-muted small d-block mb-1">Cliente</span>
                        <strong>{{ serviceOrder.clientSnapshot.legal_name ?? serviceOrder.clientSnapshot.business_name ?? 'No especificado' }}</strong>
                        {% if serviceOrder.clientSnapshot.tax_id ?? false %}
                            <span class="d-block text-muted small mt-2">RFC: {{ serviceOrder.clientSnapshot.tax_id }}</span>
                        {% endif %}
                    </div>
                </section>
            </div>
            <div class="col-12 col-md-4">
                <section class="pf-card h-100">
                    <div class="pf-card__body">
                        <span class="text-muted small d-block mb-1">Fecha compromiso</span>
                        {% if serviceOrder.commitmentDate %}
                            <strong>{{ serviceOrder.commitmentDate|date('d/m/Y') }}</strong>
                        {% else %}
                            <strong>Por asignar</strong>
                            <span class="d-block text-muted small mt-2">Se define durante la planificación.</span>
                        {% endif %}
                        {% if serviceOrder.plannedAt %}
                            <span class="d-block text-muted small mt-2">Planificada {{ serviceOrder.plannedAt|date('d/m/Y H:i', 'America/Mexico_City') }}{% if serviceOrder.plannedBy %} por {{ serviceOrder.plannedBy.fullName }}{% endif %}</span>
                        {% endif %}
                    </div>
                </section>
            </div>
        </div>

        <section class="pf-card mb-4">
            <header class="pf-card__header">
                <h2 class="pf-card__title">Origen comercial</h2>
                <p class="pf-card__description">Evidencia copiada al momento de crear la orden.</p>
            </header>
            <div class="pf-card__body">
                <dl class="row mb-0">
                    <dt class="col-sm-3">Cotización</dt>
                    <dd class="col-sm-9"><a href="{{ path('admin_quotations_show', {id: serviceOrder.sourceQuotation.id}) }}">{{ serviceOrder.sourceQuotationFolio }}</a></dd>
                    <dt class="col-sm-3">Aceptada</dt>
                    <dd class="col-sm-9">{{ serviceOrder.quotationSnapshot.accepted_at ? serviceOrder.quotationSnapshot.accepted_at|date('d/m/Y H:i', 'America/Mexico_City') : 'Sin fecha registrada' }}</dd>
                    {% if serviceOrder.quotationSnapshot.acceptance_channel ?? false %}
                        <dt class="col-sm-3">Canal</dt>
                        <dd class="col-sm-9">{{ serviceOrder.quotationSnapshot.acceptance_channel }}</dd>
                    {% endif %}
                    {% if serviceOrder.quotationSnapshot.acceptance_contact ?? false %}
                        <dt class="col-sm-3">Contacto</dt>
                        <dd class="col-sm-9">{{ serviceOrder.quotationSnapshot.acceptance_contact }}</dd>
                    {% endif %}
                    {% if serviceOrder.quotationSnapshot.acceptance_notes ?? false %}
                        <dt class="col-sm-3">Observación</dt>
                        <dd class="col-sm-9" style="white-space: pre-line;">{{ serviceOrder.quotationSnapshot.acceptance_notes }}</dd>
                    {% endif %}
                    {% if serviceOrder.quotationSnapshot.acceptance_evidence_reference ?? false %}
                        <dt class="col-sm-3">Evidencia</dt>
                        <dd class="col-sm-9" style="white-space: pre-line;">{{ serviceOrder.quotationSnapshot.acceptance_evidence_reference }}</dd>
                    {% endif %}
                </dl>
            </div>
        </section>

        <section class="pf-card mb-4">
            <header class="pf-card__header">
                <h2 class="pf-card__title">Planificación operativa</h2>
                <p class="pf-card__description">La ruta se define manualmente por partida. Las operaciones y equipos se validan contra los catálogos activos; no hay cálculos de capacidad ni consumo de materiales en esta fase.</p>
            </header>

            {% if canPlan %}
                <div class="pf-card__body border-bottom">
                    {{ form_start(planningForm, {action: path('admin_service_orders_update_planning', {id: serviceOrder.id}), method: 'POST', attr: {class: 'pf-form'}}) }}
                        {{ form_errors(planningForm) }}
                        <div class="row g-3 align-items-end">
                            <div class="col-md-6 col-lg-4">{{ form_row(planningForm.commitmentDate) }}</div>
                            <div class="col-md-6 col-lg-8">
                                <button type="submit" class="btn pf-button pf-button--secondary">Guardar fecha compromiso</button>
                            </div>
                        </div>
                    {{ form_end(planningForm) }}
                </div>
            {% elseif serviceOrder.isPlanned %}
                <div class="pf-card__body border-bottom small text-muted">
                    La ruta quedó bloqueada al marcar la orden como planificada. La ejecución de etapas se habilitará en la siguiente subfase.
                </div>
            {% endif %}

            <div class="pf-card__body d-flex flex-column gap-4">
                {% for item in serviceOrder.items %}
                    {% set plans = operationPlansByItem[item.id]|default([]) %}
                    <article class="border rounded p-3">
                        <header class="d-flex flex-column flex-md-row justify-content-between gap-2 mb-3">
                            <div>
                                <span class="text-muted small">Partida {{ item.lineNumber }}</span>
                                <h3 class="h6 mb-1">{{ item.commercialItemSnapshot.name ?? item.commercialItem.name }}</h3>
                                <span class="text-muted small">Cantidad contratada: {{ item.quantity }}</span>
                                {% if item.specificationsSnapshot.summary|default(null) %}
                                    <span class="d-block text-muted small mt-1">{{ item.specificationsSnapshot.summary }}</span>
                                {% endif %}
                            </div>
                            <span class="text-muted small">{{ plans|length }} {{ plans|length == 1 ? 'operación' : 'operaciones' }} activas</span>
                        </header>

                        <div class="pf-table-responsive mb-3">
                            <table class="pf-table">
                                <thead>
                                    <tr>
                                        {% if canPlan and plans|length > 1 %}<th class="pf-table__cell--center" aria-label="Reordenar"></th>{% endif %}
                                        <th>Secuencia</th>
                                        <th>Operación</th>
                                        <th>Área</th>
                                        <th>Equipo</th>
                                        {% if canPlan %}<th class="pf-table__actions-cell">Acciones</th>{% endif %}
                                    </tr>
                                </thead>
                                <tbody
                                    {% if canPlan and plans|length > 1 %}
                                        data-controller="ui--sortable"
                                        data-ui--sortable-url-value="{{ path('admin_service_orders_reorder_item_operations', {id: serviceOrder.id, item: item.id}) }}"
                                        data-ui--sortable-token-value="{{ csrf_token('service-order-operation-reorder-' ~ item.id) }}"
                                    {% endif %}
                                >
                                    {% for plan in plans %}
                                        <tr data-id="{{ plan.id }}" data-sortable-id="{{ plan.id }}">
                                            {% if canPlan and plans|length > 1 %}
                                                <td class="pf-table__cell--center">
                                                    <button type="button" class="pf-sortable__handle" title="Arrastrar para reordenar" aria-label="Reordenar {{ plan.operationSnapshot.name ?? plan.operation.name }}">
                                                        <i class="bi bi-grip-vertical" aria-hidden="true"></i>
                                                    </button>
                                                </td>
                                            {% endif %}
                                            <td>{{ plan.sequenceNumber }}</td>
                                            <td>
                                                <strong>{{ plan.operationSnapshot.name ?? plan.operation.name }}</strong>
                                                <span class="d-block text-muted small">{{ plan.operationSnapshot.code ?? plan.operation.code }}</span>
                                            </td>
                                            <td>{{ plan.operationSnapshot.area_name ?? plan.operation.operationArea.name }}</td>
                                            <td>
                                                {% if canPlan %}
                                                    {{ form_start(equipmentForms[plan.id], {action: path('admin_service_orders_assign_item_operation_equipment', {id: serviceOrder.id, plan: plan.id}), method: 'POST', attr: {class: 'pf-form'}}) }}
                                                        {{ form_errors(equipmentForms[plan.id]) }}
                                                        {{ form_widget(equipmentForms[plan.id].equipment, {attr: {class: 'form-select form-select-sm mb-2'}}) }}
                                                        <button type="submit" class="btn pf-button pf-button--secondary pf-button--sm">Guardar equipo</button>
                                                    {{ form_end(equipmentForms[plan.id]) }}
                                                {% elseif plan.equipment %}
                                                    <strong>{{ plan.equipmentSnapshot.name ?? plan.equipment.name }}</strong>
                                                    <span class="d-block text-muted small">{{ plan.equipmentSnapshot.code ?? plan.equipment.code }}</span>
                                                {% else %}
                                                    <span class="text-muted">Sin equipo asignado</span>
                                                {% endif %}
                                            </td>
                                            {% if canPlan %}
                                                <td class="pf-table__actions-cell">
                                                    <form
                                                        method="post"
                                                        action="{{ path('admin_service_orders_remove_item_operation', {id: serviceOrder.id, plan: plan.id}) }}"
                                                        data-controller="ui--confirm-action"
                                                        data-action="submit->ui--confirm-action#submit"
                                                        data-ui--confirm-action-title-value="¿Retirar operación?"
                                                        data-ui--confirm-action-text-value="La operación dejará de formar parte de esta ruta; se conservará el evento en la bitácora."
                                                        data-ui--confirm-action-confirm-button-text-value="Sí, retirar"
                                                        data-ui--confirm-action-cancel-button-text-value="Cancelar"
                                                        data-ui--confirm-action-icon-value="warning"
                                                    >
                                                        <input type="hidden" name="_token" value="{{ csrf_token('service-order-operation-remove-' ~ plan.id) }}">
                                                        <button type="submit" class="btn pf-button pf-button--danger pf-button--sm">Retirar</button>
                                                    </form>
                                                </td>
                                            {% endif %}
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="{{ canPlan ? (plans|length > 1 ? 6 : 5) : 4 }}" class="pf-table__empty">Aún no hay operaciones planificadas para esta partida.</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>

                        {% if canPlan %}
                            <details>
                                <summary class="fw-semibold">Agregar operación a esta partida</summary>
                                <div class="pt-3">
                                    {{ form_start(itemOperationForms[item.id], {action: path('admin_service_orders_add_item_operation', {id: serviceOrder.id, item: item.id}), method: 'POST', attr: {class: 'pf-form'}}) }}
                                        {{ form_errors(itemOperationForms[item.id]) }}
                                        <div class="row g-3 align-items-end">
                                            <div class="col-lg-8">{{ form_row(itemOperationForms[item.id].operation) }}</div>
                                            <div class="col-lg-4"><button type="submit" class="btn pf-button pf-button--primary">Agregar a ruta</button></div>
                                        </div>
                                    {{ form_end(itemOperationForms[item.id]) }}
                                </div>
                            </details>
                        {% endif %}
                    </article>
                {% endfor %}
            </div>

            {% if canPlan %}
                <footer class="pf-card__body border-top d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                    <p class="mb-0 text-muted small">Para planificar se requiere fecha compromiso y al menos una operación activa en cada partida. El equipo sigue siendo opcional.</p>
                    <form
                        method="post"
                        action="{{ path('admin_service_orders_mark_planned', {id: serviceOrder.id}) }}"
                        data-controller="ui--confirm-action"
                        data-action="submit->ui--confirm-action#submit"
                        data-ui--confirm-action-title-value="¿Marcar orden como planificada?"
                        data-ui--confirm-action-text-value="La ruta, fecha y equipos quedarán bloqueados para preservar la trazabilidad antes de iniciar ejecución."
                        data-ui--confirm-action-confirm-button-text-value="Sí, marcar planificada"
                        data-ui--confirm-action-cancel-button-text-value="Cancelar"
                        data-ui--confirm-action-icon-value="question"
                    >
                        <input type="hidden" name="_token" value="{{ csrf_token('service-order-mark-planned-' ~ serviceOrder.id) }}">
                        <button type="submit" class="btn pf-button pf-button--primary">Marcar como planificada</button>
                    </form>
                </footer>
            {% endif %}
        </section>

        <section class="pf-card mb-4">
            <header class="pf-card__header">
                <h2 class="pf-card__title">Partidas e importes contratados</h2>
                <p class="pf-card__description">Estas partidas no se editan desde la orden; provienen de la cotización aceptada.</p>
            </header>
            <div class="pf-card__body p-0">
                <div class="pf-table-responsive">
                    <table class="pf-table">
                        <thead><tr><th>#</th><th>Concepto</th><th class="pf-table__cell--right">Cantidad</th><th class="pf-table__cell--right">P. unitario</th><th class="pf-table__cell--right">Importe</th></tr></thead>
                        <tbody>
                            {% for item in serviceOrder.items %}
                                <tr>
                                    <td>{{ item.lineNumber }}</td>
                                    <td>
                                        <strong>{{ item.commercialItemSnapshot.name ?? item.commercialItem.name }}</strong>
                                        <span class="d-block text-muted small">{{ item.commercialItemSnapshot.code ?? '' }}</span>
                                        {% if item.specificationsSnapshot.summary|default(null) %}
                                            <span class="d-block text-muted small mt-1">{{ item.specificationsSnapshot.summary }}</span>
                                        {% endif %}
                                    </td>
                                    <td class="pf-table__cell--right">{{ item.quantity }}</td>
                                    <td class="pf-table__cell--right">${{ item.unitPrice|number_format(2, '.', ',') }}</td>
                                    <td class="pf-table__cell--right">${{ item.lineSubtotal|number_format(2, '.', ',') }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="pf-card__body border-top">
                <dl class="row justify-content-end mb-0">
                    <dt class="col-sm-3 text-sm-end">Subtotal</dt><dd class="col-sm-2 text-sm-end">${{ serviceOrder.subtotal|number_format(2, '.', ',') }}</dd>
                    <dt class="col-sm-3 text-sm-end">Descuento</dt><dd class="col-sm-2 text-sm-end">${{ serviceOrder.discountAmount|number_format(2, '.', ',') }}</dd>
                    <dt class="col-sm-3 text-sm-end">IVA</dt><dd class="col-sm-2 text-sm-end">${{ serviceOrder.taxAmount|number_format(2, '.', ',') }}</dd>
                    <dt class="col-sm-3 text-sm-end">Total</dt><dd class="col-sm-2 text-sm-end fw-semibold">${{ serviceOrder.total|number_format(2, '.', ',') }} {{ serviceOrder.currency }}</dd>
                </dl>
            </div>
        </section>

        {% if serviceOrder.notes %}
            <section class="pf-card">
                <header class="pf-card__header"><h2 class="pf-card__title">Notas comerciales</h2></header>
                <div class="pf-card__body" style="white-space: pre-line;">{{ serviceOrder.notes }}</div>
            </section>
        {% endif %}
    </section>
{% endblock %}
