{% set flashes = {
    success: { class: 'success', role: 'status' },
    error: { class: 'danger', role: 'alert' },
    danger: { class: 'danger', role: 'alert' },
    warning: { class: 'warning', role: 'alert' },
    info: { class: 'info', role: 'status' }
} %}

{% for type, messages in app.flashes %}
    {% set flash = flashes[type]|default({
        class: 'secondary',
        role: 'status'
    }) %}
    {% set toastType = type == 'danger' ? 'error' : type %}

    <div class="pf-flash-stack">
        {% for message in messages %}
            <div
                class="alert alert-{{ flash.class }} pf-flash"
                role="{{ flash.role }}"
                data-controller="ui--flash-toast"
                data-ui--flash-toast-type-value="{{ toastType }}"
                data-ui--flash-toast-message-value="{{ message|striptags }}"
            >
                {{ message }}
            </div>
        {% endfor %}
    </div>
{% endfor %}