{% set flash_classes = {
    success: 'success',
    error: 'danger',
    danger: 'danger',
    warning: 'warning',
    info: 'info'
} %}

{% for type, messages in app.flashes %}
    {% for message in messages %}
        <div
            class="alert alert-{{ flash_classes[type]|default('secondary') }} pf-flash"
            role="alert"
        >
            {{ message }}
        </div>
    {% endfor %}
{% endfor %}