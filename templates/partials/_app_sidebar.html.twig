{% set current_navigation = active_navigation|default('dashboard') %}

<aside
    id="pf-app-sidebar"
    class="pf-sidebar"
    data-ui--sidebar-target="sidebar"
    aria-label="Navegación principal"
>
    <div class="pf-sidebar__brand">
        <a href="{{ path('app_dashboard') }}" class="pf-brand pf-brand--app">
            <span class="pf-brand__mark">
                <img
                    src="{{ asset('images/brand/logo_printflow.png') }}"
                    alt="PrintFlow"
                    class="pf-brand__logo"
                >
            </span>

            <span class="pf-brand__name">PrintFlow</span>
        </a>
    </div>

    <nav class="pf-sidebar__nav">
        {% if is_granted('dashboard.view') %}
            <a
                href="{{ path('app_dashboard') }}"
                class="pf-sidebar__link {{ current_navigation == 'dashboard' ? 'is-active' : '' }}"
                {% if current_navigation == 'dashboard' %}aria-current="page"{% endif %}
                data-action="ui--sidebar#close"
            >
                <i class="bi bi-house-door" aria-hidden="true"></i>
                <span>Inicio</span>
            </a>
        {% endif %}

        {% if is_granted('user.view') or is_granted('role.view') %}
            <p class="pf-sidebar__section">Administración</p>

            {% if is_granted('user.view') %}
                <a
                    href="{{ path('admin_users_index') }}"
                    class="pf-sidebar__link {{ current_navigation == 'users' ? 'is-active' : '' }}"
                    {% if current_navigation == 'users' %}aria-current="page"{% endif %}
                    data-action="ui--sidebar#close"
                >
                    <i class="bi bi-people" aria-hidden="true"></i>
                    <span>Usuarios</span>
                </a>
            {% endif %}

            {% if is_granted('role.view') %}
                <a
                    href="{{ path('admin_roles_index') }}"
                    class="pf-sidebar__link {{ current_navigation == 'roles' ? 'is-active' : '' }}"
                    {% if current_navigation == 'roles' %}aria-current="page"{% endif %}
                    data-action="ui--sidebar#close"
                >
                    <i class="bi bi-shield-lock" aria-hidden="true"></i>
                    <span>Roles y permisos</span>
                </a>
            {% endif %}
        {% endif %}

        {% if is_granted('catalog.view') %}
            <p class="pf-sidebar__section">Catálogos</p>

            <a
                href="{{ path('admin_catalog_items_index') }}"
                class="pf-sidebar__link {{ current_navigation == 'catalog_items' ? 'is-active' : '' }}"
                {% if current_navigation == 'catalog_items' %}aria-current="page"{% endif %}
                data-action="ui--sidebar#close"
            >
                <i class="bi bi-box-seam" aria-hidden="true"></i>
                <span>Productos y servicios</span>
            </a>

            <a
                href="{{ path('admin_catalog_categories_index') }}"
                class="pf-sidebar__link {{ current_navigation == 'catalog_categories' ? 'is-active' : '' }}"
                {% if current_navigation == 'catalog_categories' %}aria-current="page"{% endif %}
                data-action="ui--sidebar#close"
            >
                <i class="bi bi-tags" aria-hidden="true"></i>
                <span>Categorías comerciales</span>
            </a>

            <a
                href="{{ path('admin_catalog_units_index') }}"
                class="pf-sidebar__link {{ current_navigation == 'catalog_units' ? 'is-active' : '' }}"
                {% if current_navigation == 'catalog_units' %}aria-current="page"{% endif %}
                data-action="ui--sidebar#close"
            >
                <i class="bi bi-rulers" aria-hidden="true"></i>
                <span>Unidades de medida</span>
            </a>
        {% endif %}

        {% if is_granted('clients.view') or is_granted('quotations.view') or is_granted('service_orders.view') %}
            <p class="pf-sidebar__section">Comercial</p>

            {% if is_granted('clients.view') %}
                <a
                    href="{{ path('admin_clients_index') }}"
                    class="pf-sidebar__link {{ current_navigation == 'clients' ? 'is-active' : '' }}"
                    {% if current_navigation == 'clients' %}aria-current="page"{% endif %}
                    data-action="ui--sidebar#close"
                >
                    <i class="bi bi-people" aria-hidden="true"></i>
                    <span>Clientes</span>
                </a>
            {% endif %}

            {% if is_granted('quotations.view') %}
                <a
                    href="{{ path('admin_quotations_index') }}"
                    class="pf-sidebar__link {{ current_navigation == 'quotations' ? 'is-active' : '' }}"
                    {% if current_navigation == 'quotations' %}aria-current="page"{% endif %}
                    data-action="ui--sidebar#close"
                >
                    <i class="bi bi-file-earmark-text" aria-hidden="true"></i>
                    <span>Cotizaciones</span>
                </a>
            {% endif %}

            {% if is_granted('service_orders.view') %}
                <a
                    href="{{ path('admin_service_orders_index') }}"
                    class="pf-sidebar__link {{ current_navigation == 'service_orders' ? 'is-active' : '' }}"
                    {% if current_navigation == 'service_orders' %}aria-current="page"{% endif %}
                    data-action="ui--sidebar#close"
                >
                    <i class="bi bi-clipboard-check" aria-hidden="true"></i>
                    <span>Órdenes de servicio</span>
                </a>
            {% endif %}
        {% endif %}

        {% if is_granted('suppliers.view') or is_granted('materials.view') or is_granted('material_categories.view') or is_granted('operations.view') or is_granted('operation_areas.view') %}
            <p class="pf-sidebar__section">Operación</p>

            {% if is_granted('suppliers.view') %}
                <a
                    href="{{ path('admin_suppliers_index') }}"
                    class="pf-sidebar__link {{ current_navigation == 'suppliers' ? 'is-active' : '' }}"
                    {% if current_navigation == 'suppliers' %}aria-current="page"{% endif %}
                    data-action="ui--sidebar#close"
                >
                    <i class="bi bi-truck" aria-hidden="true"></i>
                    <span>Proveedores</span>
                </a>
            {% endif %}

            {% if is_granted('materials.view') %}
                <a
                    href="{{ path('admin_materials_index') }}"
                    class="pf-sidebar__link {{ current_navigation == 'materials' ? 'is-active' : '' }}"
                    {% if current_navigation == 'materials' %}aria-current="page"{% endif %}
                    data-action="ui--sidebar#close"
                >
                    <i class="bi bi-box-seam" aria-hidden="true"></i>
                    <span>Materiales</span>
                </a>
            {% endif %}

            {% if is_granted('material_categories.view') %}
                <a
                    href="{{ path('admin_material_categories_index') }}"
                    class="pf-sidebar__link {{ current_navigation == 'material_categories' ? 'is-active' : '' }}"
                    {% if current_navigation == 'material_categories' %}aria-current="page"{% endif %}
                    data-action="ui--sidebar#close"
                >
                    <i class="bi bi-tags" aria-hidden="true"></i>
                    <span>Categorías de materiales</span>
                </a>
            {% endif %}
            {% if is_granted('operations.view') %}
                <a
                    href="{{ path('admin_operations_index') }}"
                    class="pf-sidebar__link {{ current_navigation == 'operations' ? 'is-active' : '' }}"
                    {% if current_navigation == 'operations' %}aria-current="page"{% endif %}
                    data-action="ui--sidebar#close"
                >
                    <i class="bi bi-diagram-3" aria-hidden="true"></i>
                    <span>Operaciones</span>
                </a>
            {% endif %}

            {% if is_granted('operation_areas.view') %}
                <a
                    href="{{ path('admin_operation_areas_index') }}"
                    class="pf-sidebar__link {{ current_navigation == 'operation_areas' ? 'is-active' : '' }}"
                    {% if current_navigation == 'operation_areas' %}aria-current="page"{% endif %}
                    data-action="ui--sidebar#close"
                >
                    <i class="bi bi-diagram-2" aria-hidden="true"></i>
                    <span>Áreas operativas</span>
                </a>
            {% endif %}

            {% if is_granted('equipment.view') %}
                <a
                    href="{{ path('admin_equipment_index') }}"
                    class="pf-sidebar__link {{ current_navigation == 'equipment' ? 'is-active' : '' }}"
                    {% if current_navigation == 'equipment' %}aria-current="page"{% endif %}
                    data-action="ui--sidebar#close"
                >
                    <i class="bi bi-tools" aria-hidden="true"></i>
                    <span>Equipos</span>
                </a>
            {% endif %}
        {% endif %}

        {% if is_granted('audit_log.view') %}
            <p class="pf-sidebar__section">Control</p>

            <a
                href="{{ path('admin_audit_index') }}"
                class="pf-sidebar__link {{ current_navigation == 'audit' ? 'is-active' : '' }}"
                {% if current_navigation == 'audit' %}aria-current="page"{% endif %}
                data-action="ui--sidebar#close"
            >
                <i class="bi bi-journal-text" aria-hidden="true"></i>
                <span>Bitácora</span>
            </a>
        {% endif %}
    </nav>

    <div class="pf-sidebar__footer">
        <span class="pf-sidebar__footer-label">PrintFlow</span>
        <span class="pf-sidebar__footer-version">Gestión de impresión</span>
    </div>
</aside>
