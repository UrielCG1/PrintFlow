{% set current_navigation = active_navigation|default('dashboard') %}
{% set canSeeDailyOperations = is_granted('service_orders.view') or (is_granted('production.view') and is_granted('production.design.review')) or (is_granted('production.view') and is_granted('production.execute')) or is_granted('quality.review') or is_granted('delivery.confirm') or is_granted('delivery.ship') %}
{% set canSeeWorkshopSetup = is_granted('production_routes.manage') or is_granted('production_calendar.manage') or is_granted('equipment.view') or is_granted('operations.view') or is_granted('operation_areas.view') %}
{% set canSeeMaterials = is_granted('suppliers.view') or is_granted('materials.view') or is_granted('material_categories.view') or is_granted('inventory.view') %}

<aside
    id="pf-app-sidebar"
    class="pf-sidebar"
    data-ui--sidebar-target="sidebar"
    aria-label="Navegación principal"
>
    <div class="pf-sidebar__brand">
        <a href="{{ path('app_dashboard') }}" class="pf-brand pf-brand--app">
            {% include 'partials/_brand_logo.html.twig' with { logo_class: 'pf-brand__logo' } %}
        </a>
    </div>

    <nav class="pf-sidebar__nav">
        {% if is_granted('dashboard.view') %}
            <a
                href="{{ path('app_dashboard') }}"
                class="pf-sidebar__link {{ current_navigation == 'dashboard' ? 'is-active' : '' }}"
                {% if current_navigation == 'dashboard' %}aria-current="page"{% endif %}
                data-action="ui--sidebar#close"
            >
                <i class="bi bi-house-door" aria-hidden="true"></i>
                <span>Inicio</span>
            </a>
        {% endif %}

        {% if is_granted('user.view') or is_granted('role.view') %}
            <p class="pf-sidebar__section">Administración</p>

            {% if is_granted('user.view') %}
                <a
                    href="{{ path('admin_users_index') }}"
                    class="pf-sidebar__link {{ current_navigation == 'users' ? 'is-active' : '' }}"
                    {% if current_navigation == 'users' %}aria-current="page"{% endif %}
                    data-action="ui--sidebar#close"
                >
                    <i class="bi bi-people" aria-hidden="true"></i>
                    <span>Usuarios</span>
                </a>
            {% endif %}

            {% if is_granted('role.view') %}
                <a
                    href="{{ path('admin_roles_index') }}"
                    class="pf-sidebar__link {{ current_navigation == 'roles' ? 'is-active' : '' }}"
                    {% if current_navigation == 'roles' %}aria-current="page"{% endif %}
                    data-action="ui--sidebar#close"
                >
                    <i class="bi bi-shield-lock" aria-hidden="true"></i>
                    <span>Roles y permisos</span>
                </a>
            {% endif %}

            {% if is_granted('discounts.view') %}
                <a
                    href="{{ path('admin_discounts_index') }}"
                    class="pf-sidebar__link {{ current_navigation == 'discounts' ? 'is-active' : '' }}"
                    {% if current_navigation == 'discounts' %}aria-current="page"{% endif %}
                    data-action="ui--sidebar#close"
                >
                    <i class="bi bi-percent" aria-hidden="true"></i>
                    <span>Descuentos y costeo</span>
                </a>
            {% endif %}
        {% endif %}

        {% if is_granted('catalog.view') %}
            <p class="pf-sidebar__section">Catálogos</p>

            <a
                href="{{ path('admin_catalog_health_index') }}"
                class="pf-sidebar__link {{ current_navigation == 'catalog_health' ? 'is-active' : '' }}"
                {% if current_navigation == 'catalog_health' %}aria-current="page"{% endif %}
                data-action="ui--sidebar#close"
            >
                <i class="bi bi-activity" aria-hidden="true"></i>
                <span>Estado del catálogo</span>
            </a>

            <a
                href="{{ path('admin_catalog_items_index') }}"
                class="pf-sidebar__link {{ current_navigation == 'catalog_items' ? 'is-active' : '' }}"
                {% if current_navigation == 'catalog_items' %}aria-current="page"{% endif %}
                data-action="ui--sidebar#close"
            >
                <i class="bi bi-box-seam" aria-hidden="true"></i>
                <span>Productos y servicios</span>
            </a>

            <a
                href="{{ path('admin_catalog_categories_index') }}"
                class="pf-sidebar__link {{ current_navigation == 'catalog_categories' ? 'is-active' : '' }}"
                {% if current_navigation == 'catalog_categories' %}aria-current="page"{% endif %}
                data-action="ui--sidebar#close"
            >
                <i class="bi bi-tags" aria-hidden="true"></i>
                <span>Categorías comerciales</span>
            </a>

            <a
                href="{{ path('admin_catalog_units_index') }}"
                class="pf-sidebar__link {{ current_navigation == 'catalog_units' ? 'is-active' : '' }}"
                {% if current_navigation == 'catalog_units' %}aria-current="page"{% endif %}
                data-action="ui--sidebar#close"
            >
                <i class="bi bi-rulers" aria-hidden="true"></i>
                <span>Unidades de medida</span>
            </a>

            <a
                href="{{ path('admin_catalog_characteristics_index') }}"
                class="pf-sidebar__link {{ current_navigation == 'catalog_characteristics' ? 'is-active' : '' }}"
                {% if current_navigation == 'catalog_characteristics' %}aria-current="page"{% endif %}
                data-action="ui--sidebar#close"
            >
                <i class="bi bi-sliders" aria-hidden="true"></i>
                <span>Características de producto</span>
            </a>
        {% endif %}

        {% if is_granted('clients.view') or is_granted('quotations.view') %}
            <p class="pf-sidebar__section">Comercial</p>

            {% if is_granted('clients.view') %}
                <a
                    href="{{ path('admin_clients_index') }}"
                    class="pf-sidebar__link {{ current_navigation == 'clients' ? 'is-active' : '' }}"
                    {% if current_navigation == 'clients' %}aria-current="page"{% endif %}
                    data-action="ui--sidebar#close"
                >
                    <i class="bi bi-people" aria-hidden="true"></i>
                    <span>Clientes</span>
                </a>
            {% endif %}

            {% if is_granted('quotations.view') %}
                <a
                    href="{{ path('admin_quotations_index') }}"
                    class="pf-sidebar__link {{ current_navigation == 'quotations' ? 'is-active' : '' }}"
                    {% if current_navigation == 'quotations' %}aria-current="page"{% endif %}
                    data-action="ui--sidebar#close"
                >
                    <i class="bi bi-file-earmark-text" aria-hidden="true"></i>
                    <span>Cotizaciones</span>
                </a>
            {% endif %}

        {% endif %}

        {% if canSeeDailyOperations or canSeeWorkshopSetup or canSeeMaterials %}
            <p class="pf-sidebar__section">Operación</p>

            {% if canSeeDailyOperations %}
                <p class="pf-sidebar__subsection">Trabajo diario</p>

                {% if is_granted('service_orders.view') %}
                    <a
                        href="{{ path('admin_service_orders_index') }}"
                        class="pf-sidebar__link {{ current_navigation == 'service_orders' ? 'is-active' : '' }}"
                        {% if current_navigation == 'service_orders' %}aria-current="page"{% endif %}
                        data-action="ui--sidebar#close"
                    >
                        <i class="bi bi-clipboard-check" aria-hidden="true"></i>
                        <span>Órdenes de servicio</span>
                    </a>
                {% endif %}

                {% if is_granted('production.view') and is_granted('production.design.review') %}
                    <a
                        href="{{ path('admin_design_index') }}"
                        class="pf-sidebar__link {{ current_navigation == 'design' ? 'is-active' : '' }}"
                        {% if current_navigation == 'design' %}aria-current="page"{% endif %}
                        data-action="ui--sidebar#close"
                    >
                        <i class="bi bi-palette" aria-hidden="true"></i>
                        <span>Diseño</span>
                    </a>
                {% endif %}

                {% if is_granted('production.view') and is_granted('production.execute') %}
                    <a
                        href="{{ path('admin_printing_index') }}"
                        class="pf-sidebar__link {{ current_navigation == 'printing' ? 'is-active' : '' }}"
                        {% if current_navigation == 'printing' %}aria-current="page"{% endif %}
                        data-action="ui--sidebar#close"
                    >
                        <i class="bi bi-printer" aria-hidden="true"></i>
                        <span>Impresión</span>
                    </a>
                    <a
                        href="{{ path('admin_production_execution_index') }}"
                        class="pf-sidebar__link {{ current_navigation == 'production_execution' ? 'is-active' : '' }}"
                        {% if current_navigation == 'production_execution' %}aria-current="page"{% endif %}
                        data-action="ui--sidebar#close"
                    >
                        <i class="bi bi-play-circle" aria-hidden="true"></i>
                        <span>Ejecución</span>
                    </a>
                {% endif %}

                {% if is_granted('quality.review') %}
                    <a
                        href="{{ path('admin_production_quality_delivery_quality_index') }}"
                        class="pf-sidebar__link {{ current_navigation == 'quality' ? 'is-active' : '' }}"
                        {% if current_navigation == 'quality' %}aria-current="page"{% endif %}
                        data-action="ui--sidebar#close"
                    >
                        <i class="bi bi-clipboard2-check" aria-hidden="true"></i>
                        <span>Calidad</span>
                    </a>
                {% endif %}

                {% if is_granted('delivery.confirm') or is_granted('delivery.ship') %}
                    <a
                        href="{{ path('admin_production_quality_delivery_delivery_index') }}"
                        class="pf-sidebar__link {{ current_navigation == 'delivery' ? 'is-active' : '' }}"
                        {% if current_navigation == 'delivery' %}aria-current="page"{% endif %}
                        data-action="ui--sidebar#close"
                    >
                        <i class="bi bi-box-seam" aria-hidden="true"></i>
                        <span>Entregas</span>
                    </a>
                {% endif %}
            {% endif %}

            {% if canSeeWorkshopSetup %}
            <p class="pf-sidebar__subsection">Planificación del taller</p>

            {% if is_granted('production_routes.manage') %}
                <a
                    href="{{ path('admin_production_routes_index') }}"
                    class="pf-sidebar__link {{ current_navigation == 'production_routes' ? 'is-active' : '' }}"
                    {% if current_navigation == 'production_routes' %}aria-current="page"{% endif %}
                    data-action="ui--sidebar#close"
                >
                    <i class="bi bi-signpost-split" aria-hidden="true"></i>
                    <span>Rutas de producción</span>
                </a>
            {% endif %}

            {% if is_granted('production_calendar.manage') %}
                <a
                    href="{{ path('admin_production_calendar_index') }}"
                    class="pf-sidebar__link {{ current_navigation == 'production_calendar' ? 'is-active' : '' }}"
                    {% if current_navigation == 'production_calendar' %}aria-current="page"{% endif %}
                    data-action="ui--sidebar#close"
                >
                    <i class="bi bi-calendar-week" aria-hidden="true"></i>
                    <span>Jornada de producción</span>
                </a>
            {% endif %}

            {% if is_granted('equipment.view') %}
                <a
                    href="{{ path('admin_equipment_index') }}"
                    class="pf-sidebar__link {{ current_navigation == 'equipment' ? 'is-active' : '' }}"
                    {% if current_navigation == 'equipment' %}aria-current="page"{% endif %}
                    data-action="ui--sidebar#close"
                >
                    <i class="bi bi-tools" aria-hidden="true"></i>
                    <span>Equipos</span>
                </a>
            {% endif %}

            {% if is_granted('operations.view') %}
                <a
                    href="{{ path('admin_operations_index') }}"
                    class="pf-sidebar__link {{ current_navigation == 'operations' ? 'is-active' : '' }}"
                    {% if current_navigation == 'operations' %}aria-current="page"{% endif %}
                    data-action="ui--sidebar#close"
                >
                    <i class="bi bi-diagram-3" aria-hidden="true"></i>
                    <span>Operaciones</span>
                </a>
            {% endif %}

            {% if is_granted('operation_areas.view') %}
                <a
                    href="{{ path('admin_operation_areas_index') }}"
                    class="pf-sidebar__link {{ current_navigation == 'operation_areas' ? 'is-active' : '' }}"
                    {% if current_navigation == 'operation_areas' %}aria-current="page"{% endif %}
                    data-action="ui--sidebar#close"
                >
                    <i class="bi bi-diagram-2" aria-hidden="true"></i>
                    <span>Áreas operativas</span>
                </a>
            {% endif %}
            {% endif %}

            {% if canSeeMaterials %}
            <p class="pf-sidebar__subsection">Materiales y proveedores</p>

            {% if is_granted('suppliers.view') %}
                <a
                    href="{{ path('admin_suppliers_index') }}"
                    class="pf-sidebar__link {{ current_navigation == 'suppliers' ? 'is-active' : '' }}"
                    {% if current_navigation == 'suppliers' %}aria-current="page"{% endif %}
                    data-action="ui--sidebar#close"
                >
                    <i class="bi bi-truck" aria-hidden="true"></i>
                    <span>Proveedores</span>
                </a>
            {% endif %}

            {% if is_granted('materials.view') %}
                <a
                    href="{{ path('admin_materials_index') }}"
                    class="pf-sidebar__link {{ current_navigation == 'materials' ? 'is-active' : '' }}"
                    {% if current_navigation == 'materials' %}aria-current="page"{% endif %}
                    data-action="ui--sidebar#close"
                >
                    <i class="bi bi-box-seam" aria-hidden="true"></i>
                    <span>Materiales</span>
                </a>
            {% endif %}

            {% if is_granted('inventory.view') %}
                <a
                    href="{{ path('admin_inventory_receipts_index') }}"
                    class="pf-sidebar__link {{ current_navigation == 'inventory' ? 'is-active' : '' }}"
                    {% if current_navigation == 'inventory' %}aria-current="page"{% endif %}
                    data-action="ui--sidebar#close"
                >
                    <i class="bi bi-qr-code-scan" aria-hidden="true"></i>
                    <span>Inventario</span>
                </a>
            {% endif %}

            {% if is_granted('material_categories.view') %}
                <a
                    href="{{ path('admin_material_categories_index') }}"
                    class="pf-sidebar__link {{ current_navigation == 'material_categories' ? 'is-active' : '' }}"
                    {% if current_navigation == 'material_categories' %}aria-current="page"{% endif %}
                    data-action="ui--sidebar#close"
                >
                    <i class="bi bi-tags" aria-hidden="true"></i>
                    <span>Categorías de materiales</span>
                </a>
            {% endif %}
            {% endif %}
        {% endif %}

        {% if is_granted('audit_log.view') %}
            <p class="pf-sidebar__section">Control</p>

            <a
                href="{{ path('admin_audit_index') }}"
                class="pf-sidebar__link {{ current_navigation == 'audit' ? 'is-active' : '' }}"
                {% if current_navigation == 'audit' %}aria-current="page"{% endif %}
                data-action="ui--sidebar#close"
            >
                <i class="bi bi-journal-text" aria-hidden="true"></i>
                <span>Bitácora</span>
            </a>
        {% endif %}
    </nav>

    <div class="pf-sidebar__footer">
        <span class="pf-sidebar__footer-label">OoxCorp</span>
        <span class="pf-sidebar__footer-version">Gestión de impresión</span>
    </div>
</aside>
