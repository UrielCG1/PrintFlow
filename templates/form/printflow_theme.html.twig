{% use 'form_div_layout.html.twig' %}

{% block form_row %}
    {% set row_class = (row_attr.class|default('') ~ ' pf-form-field')|trim %}
    {% set row_attr = row_attr|merge({ class: row_class }) %}

    <div{% with { attr: row_attr } %}{{ block('attributes') }}{% endwith %}>
        {{- form_label(form) -}}
        {{- form_widget(form) -}}
        {{- form_help(form) -}}
        {{- form_errors(form) -}}
    </div>
{% endblock %}

{% block checkbox_row %}
    {% set row_class = (row_attr.class|default('') ~ ' pf-form-field pf-form-field--check')|trim %}
    {% set row_attr = row_attr|merge({ class: row_class }) %}

    <div{% with { attr: row_attr } %}{{ block('attributes') }}{% endwith %}>
        {{- form_widget(form) -}}
        {{- form_help(form) -}}
        {{- form_errors(form) -}}
    </div>
{% endblock %}

{% block form_label %}
    {% if label is not same as(false) %}
        {% set label_attr = label_attr|merge({
            class: (label_attr.class|default('') ~ ' form-label')|trim
        }) %}

        {{ parent() }}
    {% endif %}
{% endblock %}

{% block form_widget_simple %}
    {% if type is not defined or type != 'hidden' %}
        {% set attr = attr|merge({
            class: (
                attr.class|default('')
                ~ ' form-control'
                ~ (not valid ? ' is-invalid' : '')
            )|trim
        }) %}
    {% endif %}

    {{ parent() }}
{% endblock %}

{% block textarea_widget %}
    {% set attr = attr|merge({
        class: (
            attr.class|default('')
            ~ ' form-control'
            ~ (not valid ? ' is-invalid' : '')
        )|trim
    }) %}

    {{ parent() }}
{% endblock %}

{% block choice_widget_collapsed %}
    {% set attr = attr|merge({
        class: (
            attr.class|default('')
            ~ ' form-select'
            ~ (not valid ? ' is-invalid' : '')
        )|trim
    }) %}

    {{ parent() }}
{% endblock %}

{% block checkbox_widget %}
    {% set attr = attr|merge({
        class: (
            attr.class|default('')
            ~ ' form-check-input'
            ~ (not valid ? ' is-invalid' : '')
        )|trim
    }) %}

    <div class="form-check">
        {{ parent() }}
        {{ form_label(form) }}
    </div>
{% endblock %}

{% block checkbox_label %}
    {% set label_attr = label_attr|merge({
        class: (label_attr.class|default('') ~ ' form-check-label')|trim
    }) %}

    {{ block('form_label') }}
{% endblock %}

{% block form_help %}
    {% if help is not empty %}
        <div id="{{ id }}_help" class="pf-form-help">
            {{ help|trans(help_translation_parameters, translation_domain) }}
        </div>
    {% endif %}
{% endblock %}

{% block form_errors %}
    {% if errors|length > 0 %}
        <div class="pf-form-errors" role="alert">
            <ul>
                {% for error in errors %}
                    <li>{{ error.message }}</li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}
{% endblock %}