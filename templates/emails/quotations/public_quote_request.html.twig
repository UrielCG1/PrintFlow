<tr><td style="padding:24px 36px;background:#e8f3ec;color:#52625a;font-size:12px;line-height:1.55;text-align:left;">{% include 'emails/quotations/_privacy_notice.html.twig' %}</td></tr>
</table></td></tr></table></body></html>
