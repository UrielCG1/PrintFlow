<!DOCTYPE html><html lang="es"><body style="font-family:Arial,sans-serif;color:#0b1c30;background:#f2f7f4;padding:24px;"><div style="max-width:600px;margin:auto;background:#fff;padding:30px;border-radius:14px;"><h1 style="font-size:22px;color:{{ withChanges ? '#b54708' : '#087c19' }};">Cotización {{ folio }} {{ withChanges ? 'aceptada con cambios' : 'aceptada' }}</h1><p><strong>Aceptada por:</strong> {{ name }}</p><p><strong>Importe aceptado:</strong> ${{ amount|number_format(2, '.', ',') }} {{ currency }}</p>{% if notes %}<div style="padding:16px;background:#fff7ed;border-left:4px solid #f79009;"><strong>Requiere revisión antes de producción.</strong><br>{{ notes|nl2br }}</div>{% endif %}<h2 style="font-size:17px;">Conceptos</h2><ul>{% for item in items %}<li>{{ item.quantity }} × {{ item.name }}</li>{% endfor %}</ul></div></body></html>
