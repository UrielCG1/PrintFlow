{% extends 'base.html.twig' %}

{% block title %}Cambiar contraseña | OoxCorp{% endblock %}

{% block body %}
    <main class="pf-user-form pf-user-reset-form">
        <a href="{{ path('app_dashboard') }}" class="pf-user-reset-form__brand" aria-label="Ir al inicio de OoxCorp">
            {% include 'partials/_brand_logo.html.twig' with { logo_class: 'pf-user-reset-form__brand-logo' } %}
        </a>

        <h1 class="pf-page-header__title">Cambiar contraseña</h1>

        {% if must_change_password %}
            <p class="pf-page-header__description">
                Por seguridad, debes cambiar tu contraseña temporal antes de continuar.
            </p>
        {% endif %}

        {{ form_start(form, { attr: { class: 'pf-user-form__card pf-form' } }) }}
            {{ form_widget(form) }}

            <button
                type="submit"
                class="btn pf-button pf-button--primary pf-button--block"
            >
                Guardar nueva contraseña
            </button>
        {{ form_end(form) }}
    </main>
{% endblock %}
