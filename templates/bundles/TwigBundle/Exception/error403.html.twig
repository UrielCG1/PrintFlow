{% extends 'layouts/app.html.twig' %}

{% set exceptionMessage = exception.message|default('') %}
{% set normalizedMessage = exceptionMessage|lower %}
{% set exceptionClass = exception.class|default('') %}
{% set previousExceptionClass = exception.previous.class|default('') %}
{% set isPermissionDenied = 'AccessDeniedException' in previousExceptionClass or 'AccessDeniedException' in exceptionClass %}
{% set isGenericDenied = exceptionMessage in ['', 'Access Denied', 'Access Denied.'] %}
{% set isInvalidRequest = 'token' in normalizedMessage or 'solicitud no es válida' in normalizedMessage or (isGenericDenied and not isPermissionDenied) %}

{% block title %}
    {% if isInvalidRequest %}Solicitud no válida{% elseif isPermissionDenied %}Permisos insuficientes{% else %}Acceso no disponible{% endif %} | OoxCorp
{% endblock %}

{% block app_navigation_active %}dashboard{% endblock %}

{% block app_breadcrumb %}Acceso / Permisos{% endblock %}

{% block app_content %}
    <section class="pf-page__content">
        <header class="pf-page-header">
            <div class="pf-page-header__content">
                <p class="pf-page-header__eyebrow">Control de acceso · Error 403</p>
                <h1 class="pf-page-header__title">
                    {% if isInvalidRequest %}
                        No se pudo validar esta acción
                    {% elseif isPermissionDenied %}
                        No tienes permisos suficientes
                    {% else %}
                        Esta acción no está disponible
                    {% endif %}
                </h1>
                <p class="pf-page-header__description">
                    {% if isInvalidRequest %}
                        Por seguridad, no aceptamos esta solicitud. Actualiza la página e inténtalo nuevamente.
                    {% elseif isPermissionDenied %}
                        Tu cuenta no tiene permiso para entrar a esta sección o realizar esta acción. Si necesitas este acceso, solicita al administrador que revise los permisos de tu perfil.
                    {% else %}
                        {{ exceptionMessage }}
                    {% endif %}
                </p>
            </div>
        </header>

        <section class="pf-card" aria-labelledby="access-denied-title">
            <div class="pf-card__body">
                <div class="d-flex align-items-start gap-3">
                    <span class="pf-status-badge pf-status-badge--warning" aria-hidden="true">
                        <i class="bi bi-shield-lock"></i>
                    </span>
                    <div>
                        <h2 id="access-denied-title" class="h5 mb-2">
                            {% if isInvalidRequest %}
                                La página pudo haber cambiado
                            {% elseif isPermissionDenied %}
                                Tu sesión sigue activa
                            {% else %}
                                Revisa el estado de la operación
                            {% endif %}
                        </h2>
                        <p class="text-body-secondary mb-0">
                            {% if isInvalidRequest %}
                                Regresa a la pantalla anterior para volver a cargar la información antes de intentarlo.
                            {% elseif isPermissionDenied %}
                                Puedes volver a la pantalla anterior o ir al inicio para continuar en un módulo disponible para tu perfil.
                            {% else %}
                                Regresa a la pantalla anterior o ve al inicio para continuar.
                            {% endif %}
                        </p>
                    </div>
                </div>

                <div class="d-flex flex-wrap justify-content-end gap-2 mt-4 pt-3 border-top">
                    <button class="btn pf-button pf-button--secondary" type="button" onclick="window.history.back()">
                        <i class="bi bi-arrow-left" aria-hidden="true"></i>
                        Regresar
                    </button>
                    {% if is_granted('dashboard.view') %}
                        <a class="btn pf-button pf-button--primary" href="{{ path('app_dashboard') }}">
                            <i class="bi bi-house-door" aria-hidden="true"></i>
                            Ir al inicio
                        </a>
                    {% endif %}
                </div>
            </div>
        </section>
    </section>
{% endblock %}
