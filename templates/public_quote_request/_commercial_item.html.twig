{% macro item(item, number) %}
{% set specifications = item.specifications.vars.data|default({}) %}
<section class="pf-quote-card pf-quote-item" data-ui--public-quote-target="item">
 <div class="pf-quote-card__header"><div class="pf-quote-card__icon"><i class="bi bi-grid"></i></div><div><h2>Detalles del trabajo · Partida <span data-item-number>{{ number }}</span></h2><p>Selecciona el mismo Producto y especificaciones disponibles para Ventas.</p></div><button type="button" class="btn btn-sm btn-outline-danger ms-auto" data-action="ui--public-quote#removeItem"><i class="bi bi-trash"></i> Quitar</button></div>
 <div class="row g-4">
  {{ form_row(item.commercialCategory,{row_attr:{class:'col-md-5 pf-quote-field'},attr:{class:'form-select','data-commercial-category':'','data-action':'change->ui--public-quote#categoryChanged'}}) }}
  {{ form_row(item.commercialItem,{row_attr:{class:'col-md-5 pf-quote-field'},attr:{class:'form-select','data-commercial-item':'','data-action':'change->ui--public-quote#productChanged'}}) }}
  {{ form_row(item.quantity,{row_attr:{class:'col-md-2 pf-quote-field'},attr:{class:'form-control','data-quantity':'','data-action':'input->ui--public-quote#quantityChanged'}}) }}
 </div>
 {{ form_widget(item.quantityMode,{attr:{'data-quantity-mode':''}}) }}
 <div class="pf-product-characteristics mt-4" data-characteristics-panel hidden><h3 class="h6 mb-3">Características del Producto</h3><div class="row g-3" data-characteristics-fields data-specifications-name="{{ item.specifications.vars.full_name }}" data-initial-specifications="{{ specifications|json_encode|e('html_attr') }}"></div></div>
 <div class="pf-product-characteristics mt-4" data-dimensions-panel hidden><h3 class="h6 mb-3">Medidas terminadas</h3><div class="row g-3 align-items-end"><div class="col-md-4"><label class="form-label">Ancho terminado (cm)</label><input class="form-control" type="text" name="{{ item.specifications.vars.full_name }}[finished_width_cm]" value="{{ specifications.finished_width_cm|default('') }}" inputmode="decimal" data-specification="finished_width_cm" data-action="input->ui--public-quote#dimensionChanged"></div><div class="col-md-4"><label class="form-label">Alto terminado (cm)</label><input class="form-control" type="text" name="{{ item.specifications.vars.full_name }}[finished_height_cm]" value="{{ specifications.finished_height_cm|default('') }}" inputmode="decimal" data-specification="finished_height_cm" data-action="input->ui--public-quote#dimensionChanged"></div><div class="col-md-4"><div class="alert alert-info mb-0"><strong data-calculated-area>Captura ambas medidas.</strong><div class="small" data-quantity-help></div></div></div></div></div>
 <div class="border rounded-3 p-3 mt-4 bg-light" data-price-preview><div class="row g-3"><div class="col-md-4"><small>Unidad</small><strong class="d-block" data-price-unit>—</strong></div><div class="col-md-4"><small>Precio unitario</small><strong class="d-block" data-unit-price>—</strong></div><div class="col-md-4"><small>Subtotal</small><strong class="d-block" data-line-subtotal>—</strong></div></div><small class="text-secondary" data-price-help>Selecciona un Producto y captura una cantidad válida.</small></div>
 {% do item.specifications.setRendered %}
 <div class="row g-4 mt-1"><div class="col-md-6">{{ form_row(item.attachment,{attr:{class:'form-control','data-action':'change->ui--public-quote#previewFile'}}) }}<div class="pf-design-information pf-file-preview mt-3" data-file-preview hidden></div></div>{{ form_row(item.notes,{row_attr:{class:'col-md-6 pf-quote-field'},attr:{class:'form-control',rows:5,placeholder:'Indicaciones adicionales...'}}) }}</div>
</section>
{% endmacro %}
