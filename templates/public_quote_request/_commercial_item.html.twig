{% macro help_tip(text) %}<button type="button" class="btn btn-link text-success border-0 p-0 pf-field-tooltip" data-controller="ui--tooltip" data-bs-toggle="tooltip" data-bs-title="{{ text|e('html_attr') }}" aria-label="Ayuda: {{ text|e('html_attr') }}"><i class="bi bi-question-circle-fill"></i></button>{% endmacro %}
{% macro item(item, number) %}
{% import _self as ui %}{% set specifications = item.specifications.vars.data|default({}) %}
<section class="pf-quote-card pf-quote-item" data-ui--public-quote-target="item">
 <div class="pf-quote-card__header pf-quote-item__header"><div class="pf-quote-card__icon"><i class="bi bi-grid"></i></div><div><h2>Detalles del trabajo · Partida <span data-item-number>{{ number }}</span></h2><p>Configura el producto con las mismas opciones disponibles para Ventas.</p></div><button type="button" class="btn btn-sm btn-outline-danger ms-auto" data-action="ui--public-quote#removeItem"><i class="bi bi-trash"></i><span> Quitar</span></button></div>

 <div class="row g-3 align-items-start pf-quote-item__selection">
  <div class="col-12 col-md-4 pf-quote-field"><div class="pf-field-label">{{ form_label(item.commercialCategory) }}{{ ui.help_tip('Define el grupo comercial y filtra los productos disponibles.') }}</div>{{ form_widget(item.commercialCategory,{attr:{class:'form-select','data-commercial-category':'','data-action':'change->ui--public-quote#categoryChanged'}}) }}{{ form_errors(item.commercialCategory) }}</div>
  <div class="col-12 col-md-5 pf-quote-field"><div class="pf-field-label">{{ form_label(item.commercialItem) }}{{ ui.help_tip('El producto determina sus características, unidad de cobro y precio vigente.') }}</div>{{ form_widget(item.commercialItem,{attr:{class:'form-select','data-commercial-item':'','data-action':'change->ui--public-quote#productChanged'}}) }}{{ form_errors(item.commercialItem) }}</div>
  <div class="col-12 col-md-3 pf-quote-field"><div class="pf-field-label">{{ form_label(item.quantity) }}{{ ui.help_tip('Cantidad facturable. En productos por m² puede calcularse automáticamente desde las medidas.') }}</div>{{ form_widget(item.quantity,{attr:{class:'form-control','data-quantity':'','data-action':'input->ui--public-quote#quantityChanged'}}) }}{{ form_errors(item.quantity) }}<span class="pf-quantity-mode" data-quantity-mode-label>Captura manual</span></div>
 </div>
 {{ form_widget(item.quantityMode,{attr:{'data-quantity-mode':''}}) }}

 <section class="pf-quote-item__panel" data-characteristics-panel hidden><div class="pf-quote-item__panel-heading"><div><span class="pf-section-label">Configuración</span><h3>Características del producto</h3></div><i class="bi bi-sliders"></i></div><div class="row g-3 pf-characteristics-grid" data-characteristics-fields data-specifications-name="{{ item.specifications.vars.full_name }}" data-initial-specifications="{{ specifications|json_encode|e('html_attr') }}"></div></section>

 <section class="pf-quote-item__panel" data-dimensions-panel hidden><div class="pf-quote-item__panel-heading"><div><span class="pf-section-label">Gran formato</span><h3>Medidas terminadas</h3></div><i class="bi bi-bounding-box-circles"></i></div><div class="pf-dimensions-grid"><div class="pf-quote-field"><div class="pf-field-label"><label class="form-label">Ancho terminado (cm)</label>{{ ui.help_tip('Ancho final del producto terminado expresado en centímetros.') }}</div><input class="form-control" type="text" name="{{ item.specifications.vars.full_name }}[finished_width_cm]" value="{{ specifications.finished_width_cm|default('') }}" inputmode="decimal" data-specification="finished_width_cm" data-action="input->ui--public-quote#dimensionChanged"></div><div class="pf-quote-field"><div class="pf-field-label"><label class="form-label">Alto terminado (cm)</label>{{ ui.help_tip('Alto final del producto terminado expresado en centímetros.') }}</div><input class="form-control" type="text" name="{{ item.specifications.vars.full_name }}[finished_height_cm]" value="{{ specifications.finished_height_cm|default('') }}" inputmode="decimal" data-specification="finished_height_cm" data-action="input->ui--public-quote#dimensionChanged"></div><div class="pf-area-summary"><span>Área calculada</span><strong data-calculated-area>Captura ambas medidas.</strong><small data-quantity-help></small></div></div></section>

 <div class="pf-item-price" data-price-preview><div><span>Unidad</span><strong data-price-unit>—</strong></div><div><span>Precio unitario</span><strong data-unit-price>—</strong></div><div class="pf-item-price__total"><span>Subtotal</span><strong data-line-subtotal>—</strong></div><p data-price-help>Selecciona un Producto y captura una cantidad válida.</p></div>
 {% do item.specifications.setRendered %}

 <div class="pf-quote-item__supporting"><div class="pf-quote-field"><div class="pf-field-label">{{ form_label(item.attachment) }}{{ ui.help_tip('Adjunta el diseño o archivo de referencia. Formatos permitidos: PDF, AI, EPS, SVG, imágenes o ZIP; máximo 20 MB.') }}</div>{{ form_widget(item.attachment,{attr:{class:'form-control','data-action':'change->ui--public-quote#previewFile'}}) }}{{ form_errors(item.attachment) }}<div class="pf-design-information pf-file-preview mt-3" data-file-preview hidden></div></div><div class="pf-quote-field pf-quote-field--textarea"><div class="pf-field-label">{{ form_label(item.notes) }}{{ ui.help_tip('Describe acabados, condiciones, instrucciones o cualquier requerimiento que no aparezca en las opciones anteriores.') }}</div>{{ form_widget(item.notes,{attr:{class:'form-control',rows:6,placeholder:'Indicaciones adicionales...'}}) }}{{ form_errors(item.notes) }}</div></div>
</section>
{% endmacro %}
