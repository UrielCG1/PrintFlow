{% extends 'base.html.twig' %}

{% macro item(item, number) %}
<section class="pf-quote-card pf-quote-item" data-ui--public-quote-target="item">
    <i class="bi bi-layers pf-quote-card__decoration" aria-hidden="true"></i>
    <div class="pf-quote-card__header">
        <div class="pf-quote-card__icon" aria-hidden="true"><i class="bi bi-grid"></i></div>
        <div><h2>Detalles del trabajo · Partida <span data-item-number>{{ number }}</span></h2><p>Selecciona el producto y sus especificaciones.</p></div>
        <button type="button" class="btn btn-sm btn-outline-danger ms-auto" data-action="ui--public-quote#removeItem"><i class="bi bi-trash"></i><span class="d-none d-sm-inline"> Quitar</span></button>
    </div>
    <div class="pf-section-label">Selecciona el producto</div>
    <div class="row g-4 mb-4">
        {{ form_row(item.category,{row_attr:{class:'col-md-6 pf-quote-field'},attr:{class:'form-select','data-action':'change->ui--public-quote#categoryChanged'},label:'Categoría del producto'}) }}
        {{ form_row(item.product,{row_attr:{class:'col-md-6 pf-quote-field'},attr:{class:'form-select','data-action':'change->ui--public-quote#productChanged'},label:'Producto'}) }}
    </div>
    <div class="row g-4">
        {{ form_row(item.quantity,{row_attr:{class:'col-sm-6 col-lg-3 pf-quote-field'},attr:{class:'form-control'}}) }}
        {{ form_row(item.width,{row_attr:{class:'col-sm-6 col-lg-3 pf-quote-field pf-dimension'},attr:{class:'form-control'}}) }}
        {{ form_row(item.height,{row_attr:{class:'col-sm-6 col-lg-3 pf-quote-field pf-dimension'},attr:{class:'form-control'}}) }}
        {{ form_row(item.measurementUnit,{row_attr:{class:'col-sm-6 col-lg-3 pf-quote-field pf-dimension'},attr:{class:'form-select'},label:'Unidad de medida'}) }}
        {{ form_row(item.material,{row_attr:{class:'col-md-6 pf-quote-field'},attr:{class:'form-select'}}) }}
        {{ form_row(item.printSides,{row_attr:{class:'col-md-6 pf-quote-field'},attr:{class:'form-select'},label:'Caras de impresión'}) }}
    </div>
    {{ form_widget(item.characteristicsJson,{attr:{'data-characteristics-json':''}}) }}
    <div class="pf-product-characteristics mt-4" data-characteristics hidden></div>
    <div class="pf-quote-choice-group pf-quote-field mt-4">
        {{ form_label(item.finishes,'Acabados especiales') }}
        <div class="pf-quote-choice-group__options">{{ form_widget(item.finishes) }}</div>{{ form_errors(item.finishes) }}
    </div>
    <div class="row g-4 mt-1">
        <div class="col-md-6 pf-quote-field">{{ form_row(item.attachment,{attr:{class:'form-control','data-action':'change->ui--public-quote#previewFile'},label:'Archivo del trabajo'}) }}<div class="pf-design-information pf-file-preview mt-3" data-file-preview hidden></div></div>
        {{ form_row(item.notes,{row_attr:{class:'col-md-6 pf-quote-field pf-quote-field--textarea'},attr:{class:'form-control',rows:5,placeholder:'Instrucciones adicionales o requerimientos especiales...'},label:'Indicaciones adicionales'}) }}
    </div>
</section>
{% endmacro %}
{% import _self as quote %}
{% import 'public_quote_request/_commercial_item.html.twig' as commercial_quote %}

{% block title %}Solicitar cotización{% endblock %}
{% block body %}
{% set success_messages = app.flashes('success') %}
<div class="pf-public-quote" data-controller="ui--public-quote" data-ui--public-quote-customer-url-value="{{ path('public_quote_customer',{number:'CONTACT_NUMBER'}) }}" data-ui--public-quote-products-url-value="{{ path('public_quote_products',{categoryId:'CATEGORY_ID'}) }}" data-ui--public-quote-price-url-value="{{ path('public_quote_price_preview',{id:'PRODUCT_ID'}) }}" data-ui--public-quote-recovery-url-value="{{ path('public_quote_customer_number_recovery') }}">
    <section class="pf-public-quote__hero" style="--pf-quote-hero-image:url('{{ asset('images/quote/hero-printing.jpg') }}')">
        <div class="container-xxl pf-public-quote__hero-container"><div class="pf-public-quote__hero-content">
            <div class="pf-public-quote__badge"><span class="pf-public-quote__badge-dot"></span>Soluciones de impresión para empresas</div>
            <h1 class="pf-public-quote__hero-title">Dale forma a tus ideas <span>con impresión profesional.</span></h1>
            <p class="pf-public-quote__hero-description">Cotiza materiales impresos para tu negocio de manera rápida. Cuéntanos qué necesitas y prepararemos una propuesta adaptada a tu proyecto.</p>
            <div class="pf-public-quote__hero-actions"><a href="#quote-form" class="btn pf-public-quote__hero-button">Comenzar cotización <i class="bi bi-arrow-down"></i></a><div class="pf-public-quote__benefit"><i class="bi bi-clock"></i><span>Respuesta personalizada en menos de 24 horas hábiles</span></div></div>
            <div class="pf-public-quote__features"><span><i class="bi bi-check-circle-fill"></i> Atención personalizada</span><span><i class="bi bi-check-circle-fill"></i> Materiales para cada proyecto</span><span><i class="bi bi-check-circle-fill"></i> Producción profesional</span></div>
        </div></div>
    </section>

    <div class="container-xxl pf-public-quote__content"><div class="row g-4 g-xl-5 justify-content-center">
        <aside class="col-xl-3 d-none d-xl-block"><div class="pf-quote-sidebar">
            <div class="pf-section-label">Nuestro proceso</div>
            <div class="pf-quote-process"><div class="pf-quote-process__item is-active"><span class="pf-quote-process__number">1</span><div><strong>Configuración</strong><small>Define tus necesidades</small></div></div><div class="pf-quote-process__item"><span class="pf-quote-process__number">2</span><div><strong>Validación</strong><small>Revisión técnica</small></div></div><div class="pf-quote-process__item"><span class="pf-quote-process__number">3</span><div><strong>Producción</strong><small>Impresión profesional</small></div></div></div>
            <div class="pf-quote-promotion"><h2>Descuento corporativo</h2><p>Accede a condiciones especiales para pedidos recurrentes o volúmenes elevados.</p><span>Solicita información</span></div>
        </div></aside>

        <main class="col-12 col-xl-9"><div class="pf-quote-content">
            <div class="pf-quote-stepper" aria-label="Progreso de la solicitud"><div class="pf-quote-stepper__item is-active"><span>1</span><strong>Cotización</strong></div><div class="pf-quote-stepper__line"></div><div class="pf-quote-stepper__item"><span>2</span><strong>Producción</strong></div><div class="pf-quote-stepper__line"></div><div class="pf-quote-stepper__item"><span>3</span><strong>Entrega</strong></div></div>
            {{ form_start(form,{attr:{class:'pf-quote-form',id:'quote-form','data-action':'submit->ui--public-quote#validate'}}) }}<div class="pf-quote-form__errors">{{ form_errors(form) }}</div>

            <section class="pf-quote-card">
                <div class="pf-quote-card__header"><div class="pf-quote-card__icon"><i class="bi bi-person"></i></div><div><h2>Detalles de contacto</h2><p>Información necesaria para procesar tu presupuesto.</p></div></div>
                <div class="pf-invoice-option mb-4"><div class="d-flex align-items-center gap-3"><div class="pf-invoice-option__icon"><i class="bi bi-person-check"></i></div><div><div class="d-flex align-items-center gap-2"><strong>¿Ya eres cliente?</strong>{{ commercial_quote.help_tip('Activa esta opción para identificarte mediante el número público asignado a tu contacto y cargar tus datos de forma segura.') }}</div><p>Activa esta opción para cargar tus datos.</p></div></div><div class="form-check form-switch m-0">{{ form_widget(form.existingCustomer,{attr:{class:'form-check-input','data-ui--public-quote-target':'existingCustomer','data-action':'ui--public-quote#toggleCustomer'}}) }}</div></div>
                <div data-ui--public-quote-target="customerLookup" hidden><div class="row g-4 align-items-end"><div class="col-md-7 pf-quote-field">{{ commercial_quote.field(form.customerNumber,'Número de cliente','Ingresa el número público asignado a tu contacto; no corresponde a datos fiscales ni a un número de pedido.','form-control',{'data-ui--public-quote-target':'customerNumber'}) }}</div><div class="col-md-5"><button class="btn pf-public-quote__hero-button w-100" type="button" data-action="ui--public-quote#loadCustomer">Cargar cliente</button></div></div><button type="button" class="btn btn-link text-success px-0 mt-2 fw-semibold" data-action="ui--public-quote#toggleRecovery"><i class="bi bi-question-circle"></i> ¿No recuerdas tu número de cliente?</button><div class="pf-customer-recovery mt-2" data-ui--public-quote-target="recoveryPanel" hidden><div><strong>Recupéralo por correo</strong><p>Escribe el correo registrado en tu contacto y te enviaremos tu número de cliente.</p></div><div class="pf-customer-recovery__form"><input type="email" class="form-control" placeholder="correo@empresa.com" autocomplete="email" data-ui--public-quote-target="recoveryEmail"><button type="button" class="btn pf-public-quote__hero-button" data-action="ui--public-quote#recoverCustomerNumber" data-ui--public-quote-target="recoveryButton">Enviar número</button></div><input type="hidden" value="{{ csrf_token('public_customer_number_recovery') }}" data-ui--public-quote-target="recoveryToken"><div class="small mt-2" role="status" aria-live="polite" data-ui--public-quote-target="recoveryStatus"></div></div><div class="pf-design-information mt-4" data-ui--public-quote-target="customerSummary" hidden></div></div>
                <div class="row g-4" data-ui--public-quote-target="prospectFields"><div class="col-md-6 pf-quote-field">{{ commercial_quote.field(form.fullName,'Nombre completo','Nombre de la persona con quien nuestro equipo dará seguimiento a la solicitud.','form-control',{}) }}</div><div class="col-md-6 pf-quote-field">{{ commercial_quote.field(form.email,'Correo electrónico','Correo donde enviaremos la cotización preliminar y las actualizaciones de tu solicitud.','form-control',{}) }}</div><div class="col-md-6 pf-quote-field">{{ commercial_quote.field(form.phone,'WhatsApp / Teléfono','Número de contacto para aclaraciones técnicas, comerciales o de entrega.','form-control',{}) }}</div><div class="col-md-6 pf-quote-field">{{ commercial_quote.field(form.contactPreference,'Método de contacto preferido','Selecciona el medio por el que prefieres que nuestro equipo se comunique contigo.','form-select',{}) }}</div><div class="col-md-6 pf-quote-field">{{ commercial_quote.field(form.companyName,'Nombre de la empresa (opcional)','Si cotizas para una empresa, escribe su nombre comercial para asociar correctamente la solicitud.','form-control',{}) }}</div></div>
            </section>

            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4"><div><div class="pf-section-label mb-1">Trabajos a cotizar</div><p class="mb-0 text-secondary">Puedes incluir varias partidas en una solicitud.</p></div><button type="button" class="btn pf-public-quote__hero-button" data-action="ui--public-quote#addItem"><i class="bi bi-plus-lg"></i> Agregar partida</button></div>
            <template data-ui--public-quote-target="prototype">{{ commercial_quote.item(form.items.vars.prototype,'__number__') }}</template>
            <div class="pf-public-quote-items" data-ui--public-quote-target="items">{% for item in form.items %}{{ commercial_quote.item(item,loop.index) }}{% endfor %}</div>{{ form_errors(form.items) }}

            <section class="pf-quote-card">
                <div class="pf-quote-card__header"><div class="pf-quote-card__icon"><i class="bi bi-truck"></i></div><div><h2>Entrega y facturación</h2><p>Información logística y detalles fiscales.</p></div></div>
                <div class="row g-4"><div class="col-md-6 pf-quote-field">{{ commercial_quote.field(form.deliveryMethod,'Método de entrega','Indica si recogerás el trabajo, necesitas envío o prefieres definirlo después.','form-select',{'data-ui--public-quote-target':'deliveryMethod','data-action':'ui--public-quote#deliveryChanged'}) }}</div><div class="col-md-6 pf-quote-field">{{ commercial_quote.field(form.neededAt,'Fecha deseada de entrega','Fecha preferida para recibir el trabajo; está sujeta a validación de producción y logística.','form-control',{min:'now'|date('Y-m-d'),'data-action':'change->ui--public-quote#showDateNotice'}) }}</div></div>
                <div class="alert alert-info d-flex align-items-start gap-3 mt-4 mb-0" data-delivery-date-notice hidden><i class="bi bi-calendar-check fs-5" aria-hidden="true"></i><div><strong>Fecha sujeta a disponibilidad</strong><p class="mb-0 mt-1">La fecha seleccionada es una preferencia. La fecha final de entrega se estimará y confirmará de acuerdo con la disponibilidad de producción y entrega del sistema.</p></div></div>
                {{ form_widget(form.deliveryAddressId,{attr:{'data-ui--public-quote-target':'deliveryAddressId'}}) }}<div class="mt-4" data-ui--public-quote-target="deliveryAddress" hidden></div>
                <div class="pf-invoice-option mt-4"><div class="d-flex align-items-center gap-3"><div class="pf-invoice-option__icon"><i class="bi bi-receipt"></i></div><div><div class="d-flex align-items-center gap-2"><strong>¿Necesitas factura?</strong>{{ commercial_quote.help_tip('Activa esta opción si requerirás factura. Nuestro equipo solicitará posteriormente los datos fiscales necesarios.') }}</div><p>Los datos fiscales podrán solicitarse posteriormente.</p></div></div><div class="form-check form-switch m-0">{{ form_widget(form.requiresInvoice,{attr:{class:'form-check-input'}}) }}<span></span></div></div>{{ form_errors(form.requiresInvoice) }}
            </section>
            <div class="pf-quote-guarantee"><i class="bi bi-patch-check"></i><div><strong>Garantía de satisfacción</strong><p>Revisaremos tu solicitud y enviaremos una propuesta personalizada con materiales, tiempos y costos.</p></div></div>
            <div class="pf-quote-submit"><button class="btn pf-quote-submit__button" type="submit"><span>Enviar solicitud</span><i class="bi bi-arrow-right"></i></button><div class="pf-quote-trust-signals"><span><i class="bi bi-shield-check"></i> Cifrado de datos</span><span><i class="bi bi-building-check"></i> Empresa certificada</span><span><i class="bi bi-award"></i> Calidad profesional</span></div></div>
            {{ form_end(form) }}
        </div></main>
    </div></div>
    <div class="modal fade" tabindex="-1" data-quote-confirmation-modal aria-labelledby="quote-confirmation-title" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><div><h2 class="modal-title fs-4" id="quote-confirmation-title">Confirma tu solicitud</h2><p class="text-secondary mb-0">Revisa los datos antes de generar el PDF.</p></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div><div class="modal-body" data-confirmation-summary></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Regresar y corregir</button><button type="button" class="btn pf-public-quote__hero-button" data-action="ui--public-quote#confirmSubmission"><i class="bi bi-check-circle"></i> Confirmar y enviar</button></div></div></div></div>
    {% if success_messages is not empty %}
    <div class="modal fade pf-success-modal" tabindex="-1" data-ui--public-quote-target="successModal" aria-labelledby="quote-success-title" aria-describedby="quote-success-description" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered modal-lg"><div class="modal-content">
        <div class="pf-success-modal__hero"><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button><div class="pf-success-modal__check"><i class="bi bi-check-lg"></i></div><span class="pf-success-modal__eyebrow">Solicitud recibida</span><h2 id="quote-success-title">¡Gracias por confiar en PrintFlow!</h2><p id="quote-success-description">Tu proyecto ya está en manos de nuestro equipo.</p></div>
        <div class="modal-body pf-success-modal__body"><div class="pf-success-modal__timeline">
          <div class="pf-success-modal__step is-complete"><span><i class="bi bi-envelope-check"></i></span><div><strong>Enviamos tu cotización preliminar</strong><p>Revisa tu correo electrónico; ahí encontrarás el PDF con la información y precios calculados inicialmente.</p></div></div>
          <div class="pf-success-modal__step"><span><i class="bi bi-person-workspace"></i></span><div><strong>Nuestro equipo revisará tu solicitud</strong><p>Validaremos el archivo, atenderemos tus observaciones y nos comunicaremos contigo si necesitamos aclarar alguna duda o realizar un ajuste.</p></div></div>
          <div class="pf-success-modal__step"><span><i class="bi bi-send-check"></i></span><div><strong>Recibirás la cotización revisada</strong><p>Pronto llegará a tu correo la cotización con las consideraciones o modificaciones que correspondan.</p></div></div>
        </div><div class="pf-success-modal__note"><i class="bi bi-heart-fill"></i><p><strong>Gracias por tu preferencia.</strong><br>Será un gusto dar forma a tu proyecto.</p></div></div>
        <div class="modal-footer pf-success-modal__footer"><button type="button" class="btn pf-public-quote__hero-button" data-bs-dismiss="modal">Entendido <i class="bi bi-arrow-right"></i></button></div>
      </div></div>
    </div>
    {% endif %}
</div>
{% endblock %}
