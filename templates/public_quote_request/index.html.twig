{% extends 'base.html.twig' %}

{% macro item(item, number) %}
<section class="pf-quote-card pf-quote-item" data-ui--public-quote-target="item">
    <i class="bi bi-layers pf-quote-card__decoration" aria-hidden="true"></i>
    <div class="pf-quote-card__header">
        <div class="pf-quote-card__icon" aria-hidden="true"><i class="bi bi-grid"></i></div>
        <div><h2>Detalles del trabajo · Partida <span data-item-number>{{ number }}</span></h2><p>Selecciona el producto y sus especificaciones.</p></div>
        <button type="button" class="btn btn-sm btn-outline-danger ms-auto" data-action="ui--public-quote#removeItem"><i class="bi bi-trash"></i><span class="d-none d-sm-inline"> Quitar</span></button>
    </div>
    <div class="pf-section-label">Selecciona el producto</div>
    <div class="row g-4 mb-4">
        {{ form_row(item.category,{row_attr:{class:'col-md-6 pf-quote-field'},attr:{class:'form-select'},label:'Categoría del producto'}) }}
        {{ form_row(item.product,{row_attr:{class:'col-md-6 pf-quote-field'},attr:{class:'form-select'},label:'Producto'}) }}
    </div>
    <div class="row g-4">
        {{ form_row(item.quantity,{row_attr:{class:'col-sm-6 col-lg-3 pf-quote-field'},attr:{class:'form-control'}}) }}
        {{ form_row(item.width,{row_attr:{class:'col-sm-6 col-lg-3 pf-quote-field pf-dimension'},attr:{class:'form-control'}}) }}
        {{ form_row(item.height,{row_attr:{class:'col-sm-6 col-lg-3 pf-quote-field pf-dimension'},attr:{class:'form-control'}}) }}
        {{ form_row(item.measurementUnit,{row_attr:{class:'col-sm-6 col-lg-3 pf-quote-field pf-dimension'},attr:{class:'form-select'},label:'Unidad de medida'}) }}
        {{ form_row(item.material,{row_attr:{class:'col-md-6 pf-quote-field'},attr:{class:'form-control'}}) }}
        {{ form_row(item.printSides,{row_attr:{class:'col-md-6 pf-quote-field'},attr:{class:'form-select'},label:'Caras de impresión'}) }}
    </div>
    {{ form_widget(item.characteristicsJson,{attr:{'data-characteristics-json':''}}) }}
    <div class="pf-product-characteristics mt-4" data-characteristics hidden></div>
    <div class="pf-quote-choice-group pf-quote-field mt-4">
        {{ form_label(item.finishes,'Acabados especiales') }}
        <div class="pf-quote-choice-group__options">{{ form_widget(item.finishes) }}</div>{{ form_errors(item.finishes) }}
    </div>
    <div class="row g-4 mt-1">
        {{ form_row(item.attachment,{row_attr:{class:'col-md-6 pf-quote-field'},attr:{class:'form-control'},label:'Archivo del trabajo'}) }}
        {{ form_row(item.notes,{row_attr:{class:'col-md-6 pf-quote-field pf-quote-field--textarea'},attr:{class:'form-control',rows:5,placeholder:'Instrucciones adicionales o requerimientos especiales...'},label:'Indicaciones adicionales'}) }}
    </div>
</section>
{% endmacro %}
{% import _self as quote %}

{% block title %}Solicitar cotización{% endblock %}
{% block body %}
<div class="pf-public-quote" data-controller="ui--public-quote" data-ui--public-quote-customer-url-value="{{ path('public_quote_customer',{id:'CONTACT_ID'}) }}">
    <section class="pf-public-quote__hero" style="--pf-quote-hero-image:url('{{ asset('images/quote/hero-printing.jpg') }}')">
        <div class="container-xxl pf-public-quote__hero-container"><div class="pf-public-quote__hero-content">
            <div class="pf-public-quote__badge"><span class="pf-public-quote__badge-dot"></span>Soluciones de impresión para empresas</div>
            <h1 class="pf-public-quote__hero-title">Dale forma a tus ideas <span>con impresión profesional.</span></h1>
            <p class="pf-public-quote__hero-description">Cotiza materiales impresos para tu negocio de manera rápida. Cuéntanos qué necesitas y prepararemos una propuesta adaptada a tu proyecto.</p>
            <div class="pf-public-quote__hero-actions"><a href="#quote-form" class="btn pf-public-quote__hero-button">Comenzar cotización <i class="bi bi-arrow-down"></i></a><div class="pf-public-quote__benefit"><i class="bi bi-clock"></i><span>Respuesta personalizada en menos de 24 horas hábiles</span></div></div>
            <div class="pf-public-quote__features"><span><i class="bi bi-check-circle-fill"></i> Atención personalizada</span><span><i class="bi bi-check-circle-fill"></i> Materiales para cada proyecto</span><span><i class="bi bi-check-circle-fill"></i> Producción profesional</span></div>
        </div></div>
    </section>

    <div class="container-xxl pf-public-quote__content"><div class="row g-4 g-xl-5 justify-content-center">
        <aside class="col-xl-3 d-none d-xl-block"><div class="pf-quote-sidebar">
            <div class="pf-section-label">Nuestro proceso</div>
            <div class="pf-quote-process"><div class="pf-quote-process__item is-active"><span class="pf-quote-process__number">1</span><div><strong>Configuración</strong><small>Define tus necesidades</small></div></div><div class="pf-quote-process__item"><span class="pf-quote-process__number">2</span><div><strong>Validación</strong><small>Revisión técnica</small></div></div><div class="pf-quote-process__item"><span class="pf-quote-process__number">3</span><div><strong>Producción</strong><small>Impresión profesional</small></div></div></div>
            <div class="pf-quote-promotion"><h2>Descuento corporativo</h2><p>Accede a condiciones especiales para pedidos recurrentes o volúmenes elevados.</p><span>Solicita información</span></div>
        </div></aside>

        <main class="col-12 col-xl-9"><div class="pf-quote-content">
            <div class="pf-quote-stepper" aria-label="Progreso de la solicitud"><div class="pf-quote-stepper__item is-active"><span>1</span><strong>Cotización</strong></div><div class="pf-quote-stepper__line"></div><div class="pf-quote-stepper__item"><span>2</span><strong>Producción</strong></div><div class="pf-quote-stepper__line"></div><div class="pf-quote-stepper__item"><span>3</span><strong>Entrega</strong></div></div>
            {% for message in app.flashes('success') %}<div class="alert alert-success d-flex align-items-center gap-2 border-0 mb-4"><i class="bi bi-check-circle-fill"></i><span>{{ message }}</span></div>{% endfor %}
            {{ form_start(form,{attr:{class:'pf-quote-form',id:'quote-form','data-action':'submit->ui--public-quote#validate'}}) }}<div class="pf-quote-form__errors">{{ form_errors(form) }}</div>

            <section class="pf-quote-card">
                <div class="pf-quote-card__header"><div class="pf-quote-card__icon"><i class="bi bi-person"></i></div><div><h2>Detalles de contacto</h2><p>Información necesaria para procesar tu presupuesto.</p></div></div>
                <div class="pf-invoice-option mb-4"><div class="d-flex align-items-center gap-3"><div class="pf-invoice-option__icon"><i class="bi bi-person-check"></i></div><div><strong>¿Ya eres cliente?</strong><p>Activa esta opción para cargar tus datos.</p></div></div><div class="form-check form-switch m-0">{{ form_widget(form.existingCustomer,{attr:{class:'form-check-input','data-ui--public-quote-target':'existingCustomer','data-action':'ui--public-quote#toggleCustomer'}}) }}</div></div>
                <div data-ui--public-quote-target="customerLookup" hidden><div class="row g-4 align-items-end">{{ form_row(form.customerNumber,{row_attr:{class:'col-md-7 pf-quote-field'},attr:{class:'form-control','data-ui--public-quote-target':'customerNumber'},label:'Número de cliente'}) }}<div class="col-md-5"><button class="btn pf-public-quote__hero-button w-100" type="button" data-action="ui--public-quote#loadCustomer">Cargar cliente</button></div></div><div class="pf-design-information mt-4" data-ui--public-quote-target="customerSummary" hidden></div></div>
                <div class="row g-4" data-ui--public-quote-target="prospectFields">{{ form_row(form.fullName,{row_attr:{class:'col-md-6 pf-quote-field'},attr:{class:'form-control'},label:'Nombre completo'}) }}{{ form_row(form.email,{row_attr:{class:'col-md-6 pf-quote-field'},attr:{class:'form-control'},label:'Correo electrónico'}) }}{{ form_row(form.phone,{row_attr:{class:'col-md-6 pf-quote-field'},attr:{class:'form-control'},label:'WhatsApp / Teléfono'}) }}{{ form_row(form.contactPreference,{row_attr:{class:'col-md-6 pf-quote-field'},attr:{class:'form-select'},label:'Método de contacto preferido'}) }}{{ form_row(form.companyName,{row_attr:{class:'col-md-6 pf-quote-field'},attr:{class:'form-control'},label:'Nombre de la empresa (opcional)'}) }}</div>
            </section>

            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4"><div><div class="pf-section-label mb-1">Trabajos a cotizar</div><p class="mb-0 text-secondary">Puedes incluir varias partidas en una solicitud.</p></div><button type="button" class="btn pf-public-quote__hero-button" data-action="ui--public-quote#addItem"><i class="bi bi-plus-lg"></i> Agregar partida</button></div>
            <template data-ui--public-quote-target="prototype">{{ quote.item(form.items.vars.prototype,'__number__') }}</template>
            <div data-ui--public-quote-target="items">{% for item in form.items %}{{ quote.item(item,loop.index) }}{% endfor %}</div>{{ form_errors(form.items) }}

            <section class="pf-quote-card">
                <div class="pf-quote-card__header"><div class="pf-quote-card__icon"><i class="bi bi-truck"></i></div><div><h2>Entrega y facturación</h2><p>Información logística y detalles fiscales.</p></div></div>
                <div class="row g-4">{{ form_row(form.deliveryMethod,{row_attr:{class:'col-md-6 pf-quote-field'},attr:{class:'form-select','data-ui--public-quote-target':'deliveryMethod','data-action':'ui--public-quote#deliveryChanged'},label:'Método de entrega'}) }}{{ form_row(form.neededAt,{row_attr:{class:'col-md-6 pf-quote-field'},attr:{class:'form-control'},label:'Fecha requerida'}) }}</div>
                {{ form_widget(form.deliveryAddressId,{attr:{'data-ui--public-quote-target':'deliveryAddressId'}}) }}<div class="mt-4" data-ui--public-quote-target="deliveryAddress" hidden></div>
                <div class="pf-invoice-option mt-4"><div class="d-flex align-items-center gap-3"><div class="pf-invoice-option__icon"><i class="bi bi-receipt"></i></div><div><strong>¿Necesitas factura?</strong><p>Los datos fiscales podrán solicitarse posteriormente.</p></div></div><div class="form-check form-switch m-0">{{ form_widget(form.requiresInvoice,{attr:{class:'form-check-input'}}) }}<span>Requiero factura</span></div></div>{{ form_errors(form.requiresInvoice) }}
            </section>
            <div class="pf-quote-guarantee"><i class="bi bi-patch-check"></i><div><strong>Garantía de satisfacción</strong><p>Revisaremos tu solicitud y enviaremos una propuesta personalizada con materiales, tiempos y costos.</p></div></div>
            <div class="pf-quote-submit"><button class="btn pf-quote-submit__button" type="submit"><span>Enviar solicitud</span><i class="bi bi-arrow-right"></i></button><div class="pf-quote-trust-signals"><span><i class="bi bi-shield-check"></i> Cifrado de datos</span><span><i class="bi bi-building-check"></i> Empresa certificada</span><span><i class="bi bi-award"></i> Calidad profesional</span></div></div>
            {{ form_end(form) }}
        </div></main>
    </div></div>
</div>
{% endblock %}
