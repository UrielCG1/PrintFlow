<!DOCTYPE html><html lang="es-MX"><head><meta charset="UTF-8"><style>
@page{margin:25mm 16mm 23mm}*{box-sizing:border-box}body{color:#172033;font-family:DejaVu Sans,sans-serif;font-size:9.5px;line-height:1.45}.top{position:fixed;top:-18mm;right:-16mm;left:-16mm;height:12mm;background:#172033}.footer{position:fixed;right:-16mm;bottom:-17mm;left:-16mm;height:10mm;padding:3mm 16mm 0;background:#172033;color:#fff;font-size:7.5px}.page:after{content:"Página " counter(page) " de " counter(pages);float:right}.header,.summary,.items,.totals{width:100%;border-collapse:collapse}.header{margin-bottom:18px;border-bottom:2px solid #27f52e}.header td{padding-bottom:13px;vertical-align:top}.issuer{margin:0 0 4px;font-size:20px}.detail{margin:0;color:#667085;font-size:8.5px}.title{margin:0 0 5px;color:#10a816;font-size:21px;text-align:right}.folio{text-align:right;font-weight:700}.warning{margin:12px 0;padding:10px;border:2px solid #d92d20;background:#fff4f2;color:#b42318;text-align:center;font-weight:700}.section{margin-top:18px}.section-title{margin:0 0 8px;color:#344054;font-size:9px;text-transform:uppercase}.summary td,.items td,.items th{padding:8px;border:1px solid #e4e7ec}.summary td{width:50%}.label{display:block;color:#667085;font-size:7.5px;text-transform:uppercase}.items th{background:#f2f4f7;font-size:7.5px;text-align:left}.number{text-align:right}.totals-wrap{width:44%;margin:18px 0 0 auto}.totals td{padding:5px 8px;border-bottom:1px solid #e4e7ec}.totals .grand td{border-top:2px solid #27f52e;font-size:11px;font-weight:700}.notes{margin-top:18px;padding:9px;border-left:3px solid #27f52e;background:#f8fdf8}
.delivery-date{display:inline-block;margin-top:8px;padding:7px 10px;border:2px solid #d92d20;color:#b42318;font-size:8px;font-weight:700;line-height:1.35;text-align:center}.delivery-date-value{display:block;font-size:10px}.header-right{text-align:right}
</style></head><body><div class="top"></div><div class="footer">Solicitud de cotización calculada por PrintFlow.<span class="page"></span></div>
{% set monthNames = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'] %}
<table class="header"><tr><td><h1 class="issuer">{{ issuer.name }}</h1><p class="detail">RFC: {{ issuer.tax_id }}</p><p class="detail">{{ issuer.address }}</p><p class="detail">{{ issuer.email }} | {{ issuer.phone }}</p></td><td class="header-right"><h2 class="title">Cotización</h2><p class="folio">{{ quotation.requestReference }}</p><div class="delivery-date">FECHA DE ENTREGA:<span class="delivery-date-value">{% if quotation.requestedDeliveryAt %}{{ quotation.requestedDeliveryAt|date('d') }}/{{ monthNames[quotation.requestedDeliveryAt|date('n') - 1] }}/{{ quotation.requestedDeliveryAt|date('Y') }}{% else %}POR CONFIRMAR{% endif %}</span></div></td></tr></table>
<section class="section"><h2 class="section-title">Datos del cliente</h2><table class="summary"><tr><td><span class="label">Cliente</span>{{ quotation.requestContactName }}</td><td><span class="label">Empresa</span>{{ quotation.requestCompanyName|default('No especificada') }}</td></tr><tr><td><span class="label">Correo</span>{{ quotation.requestEmail }}</td><td><span class="label">Teléfono</span>{{ quotation.requestPhone }}</td></tr></table></section>
<section class="section"><h2 class="section-title">Información del documento</h2><table class="summary"><tr><td><span class="label">Fecha de solicitud</span>{{ quotation.createdAt|date('d/m/Y H:i') }}</td><td><span class="label">Vigencia del cálculo</span>{{ quotation.expiresAt|date('d/m/Y') }}</td></tr></table></section>
<section class="section"><h2 class="section-title">Partidas cotizadas</h2><table class="items"><thead><tr><th>#</th><th>Concepto</th><th class="number">Cantidad</th><th class="number">P. unitario</th><th class="number">Subtotal</th></tr></thead><tbody>{% for line in lines %}<tr><td>{{ line.number }}</td><td><small>{{ line.code }}</small><br><strong>{{ line.name }}</strong>{% if line.notes %}<br>{{ line.notes }}{% endif %}</td><td class="number">{{ line.quantity }}</td><td class="number">${{ line.unit_price|number_format(2,'.',',') }}</td><td class="number">${{ line.subtotal|number_format(2,'.',',') }}</td></tr>{% endfor %}</tbody></table></section>
<div class="totals-wrap"><table class="totals"><tr><td>Subtotal</td><td class="number">${{ quotation.subtotal|number_format(2,'.',',') }}</td></tr><tr><td>Descuento</td><td class="number">-${{ quotation.discountAmount|number_format(2,'.',',') }}</td></tr><tr><td>IVA</td><td class="number">${{ quotation.taxAmount|number_format(2,'.',',') }}</td></tr><tr class="grand"><td>Total</td><td class="number">${{ quotation.total|number_format(2,'.',',') }} {{ quotation.currency }}</td></tr></table></div><div class="notes"><strong>Importante:</strong> los importes se calcularon con las reglas comerciales vigentes. Un asesor confirmará disponibilidad y fecha final de entrega.</div></body></html>
