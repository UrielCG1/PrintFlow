{% extends 'base.html.twig' %}
{% block title %}Confirmación de correo | Ooxcorp{% endblock %}
{% block body %}<main style="min-height:100vh;display:grid;place-items:center;padding:24px;background:#f3f7f4;color:#10233d;"><section style="width:min(620px,100%);padding:40px;background:#fff;border:1px solid #dce8df;border-top:5px solid #00a51c;border-radius:20px;box-shadow:0 18px 45px rgba(16,35,61,.1);text-align:center;"><div style="width:64px;height:64px;display:grid;place-items:center;margin:0 auto 20px;border-radius:18px;background:#e9f8ec;color:#008c16;font-size:30px;"><i class="bi {{ success or alreadyVerified ? 'bi-patch-check-fill' : 'bi-exclamation-circle' }}"></i></div>{% if success %}<h1>Correo confirmado</h1><p>Gracias. Tu correo quedó verificado correctamente y ya puedes utilizarlo en los servicios de Ooxcorp.</p>{% elseif alreadyVerified %}<h1>Correo ya confirmado</h1><p>Este correo ya había sido verificado previamente.</p>{% else %}<h1>Enlace no válido o vencido</h1><p>Solicita a nuestro equipo que envíe una nueva confirmación de correo.</p>{% endif %}<a href="{{ path('public_quote_request') }}" class="btn btn-success mt-3">Ir a cotizar</a></section></main>{% endblock %}
