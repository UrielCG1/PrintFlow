{% extends 'layouts/public.html.twig' %}

{% block title %}Iniciar sesión | PrintFlow{% endblock %}

{% block body_class %}pf-public-body pf-public-body--auth{% endblock %}

{% block public_frame %}
    <section class="pf-auth d-flex align-items-center justify-content-center position-relative overflow-hidden">
        <aside
            class="pf-auth__visual position-fixed top-0 start-0 z-0 w-100 h-100 border-0"
            aria-hidden="true"
        >
            <img
                class="pf-auth__visual-image w-100 h-100 object-fit-cover"
                src="{{ asset('images/illustrations/login-print-production.png') }}"
                alt=""
            >
        </aside>

        <div class="pf-auth__panel position-relative z-1 w-100 bg-transparent">
            <div class="pf-auth__form pf-card bg-white bg-opacity-75 p-4 p-md-5 shadow-lg">
                <div class="pf-brand w-100 justify-content-center text-center">
                    <span class="pf-brand__mark"></span>
                    <span class="pf-brand__name">PrintFlow</span>
                </div>

                <header class="pf-auth__header text-center">
                    <h1>Bienvenido</h1>
                    <p class="mx-auto">Ingresa tus credenciales para acceder a la plataforma de operaciones de producción.</p>
                </header>

                {% include 'partials/_flash_messages.html.twig' %}

                {% if error %}
                    <div id="login-error" class="alert alert-danger pf-auth__alert" role="alert">
                        No fue posible iniciar sesión. Verifica tus credenciales e inténtalo de nuevo.
                    </div>
                {% endif %}

                <form method="post" action="{{ path('app_login') }}" class="pf-form pf-auth__form-fields">
                    <div class="pf-auth__field">
                        <label for="username" class="form-label">Usuario</label>

                        <div class="input-group pf-auth__input-group bg-white bg-opacity-75">
                            <span class="input-group-text bg-success-subtle text-success-emphasis">
                                <i class="bi bi-person" aria-hidden="true"></i>
                            </span>

                            <input
                                id="username"
                                name="_username"
                                type="text"
                                class="form-control"
                                value="{{ last_username }}"
                                autocomplete="username"
                                placeholder="Nombre de usuario"
                                required
                                autofocus
                            >
                        </div>
                    </div>

                    <div class="pf-auth__field">
                        <label for="password" class="form-label">Contraseña</label>

                        <div
                            class="input-group pf-auth__input-group bg-white bg-opacity-75"
                            data-controller="ui--password-visibility"
                        >
                            <span class="input-group-text bg-success-subtle text-success-emphasis">
                                <i class="bi bi-lock" aria-hidden="true"></i>
                            </span>

                            <input
                                id="password"
                                name="_password"
                                type="password"
                                class="form-control"
                                autocomplete="current-password"
                                placeholder="Contraseña"
                                required
                                data-ui--password-visibility-target="input"
                            >

                            <button
                                type="button"
                                class="btn pf-button pf-button--ghost pf-auth__password-toggle bg-success-subtle text-success-emphasis"
                                data-ui--password-visibility-target="toggle"
                                data-action="ui--password-visibility#toggle"
                                aria-label="Mostrar contraseña"
                                aria-pressed="false"
                            >
                                <i
                                    class="bi bi-eye"
                                    aria-hidden="true"
                                    data-ui--password-visibility-target="icon"
                                ></i>
                            </button>
                        </div>
                    </div>

                    <input
                        type="hidden"
                        name="_csrf_token"
                        value="{{ csrf_token('authenticate') }}"
                        data-controller="csrf-protection"
                    >

                    <twig:Ui:Button
                        type="submit"
                        class="pf-button--primary pf-button--block pf-auth__submit"
                    >
                        Iniciar sesión
                    </twig:Ui:Button>
                </form>

                {# TODO: sustituir href cuando exista app_password_reset_request. #}
                <a
                    href="#"
                    class="pf-auth__recovery-link d-flex justify-content-center text-center"
                    data-future-route="app_password_reset_request"
                    aria-disabled="true"
                    tabindex="-1"
                >
                    ¿Olvidaste tu contraseña?
                </a>

                <div class="pf-auth__support">
                    <div class="pf-auth__support-item">
                        <i class="bi bi-headset text-success-emphasis" aria-hidden="true"></i>

                        <p>
                            ¿Necesitas ayuda? Contacta al administrador o soporte técnico.
                        </p>
                    </div>

                    <div class="pf-auth__support-item">
                        <i class="bi bi-shield-lock text-success-emphasis" aria-hidden="true"></i>

                        <p>Acceso seguro. Conexión cifrada únicamente.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}