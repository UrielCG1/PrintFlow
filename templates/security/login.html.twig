{% extends 'layouts/public.html.twig' %}

{% block title %}Iniciar sesión | PrintFlow{% endblock %}

{% block body_class %}pf-public-body pf-public-body--auth{% endblock %}

{% block public_frame %}
    <section class="pf-auth">
        <aside class="pf-auth__visual" aria-hidden="true">
            <img
                class="pf-auth__visual-image"
                src="{{ asset('images/illustrations/paper_background.jpg') }}"
                alt=""
            >
        </aside>

        <div class="pf-auth__panel">
            <div class="pf-auth__form">
                <div class="pf-brand">
                    <img
                        class="pf-brand__mark"
                        src="{{ asset('images/brand/logo.png') }}"
                        alt="PrintFlow"
                    >
                    <span class="pf-brand__name visually-hidden">PrintFlow</span>
                </div>

                <header class="pf-auth__header">
                    <h1>Bienvenido</h1>
                </header>

                {% include 'partials/_flash_messages.html.twig' %}

                {% if error %}
                    <div
                        id="login-error"
                        class="alert alert-danger pf-auth__alert"
                        role="alert"
                    >
                        No fue posible iniciar sesión. Verifica tus credenciales e inténtalo de nuevo.
                    </div>
                {% endif %}

                <form
                    method="post"
                    action="{{ path('app_login') }}"
                    class="pf-form pf-auth__form-fields"
                >
                    <div class="pf-auth__field">
                        <div class="input-group pf-auth__input-group">
                            <span class="input-group-text">
                                <i class="bi bi-person" aria-hidden="true"></i>
                            </span>

                            <input
                                id="username"
                                name="_username"
                                type="text"
                                class="form-control"
                                value="{{ last_username }}"
                                autocomplete="username"
                                placeholder="Nombre de usuario"
                                required
                                autofocus
                            >
                        </div>
                    </div>

                    <div class="pf-auth__field">
                        <div
                            class="input-group pf-auth__input-group"
                            data-controller="ui--password-visibility"
                        >
                            <span class="input-group-text">
                                <i class="bi bi-lock" aria-hidden="true"></i>
                            </span>

                            <input
                                id="password"
                                name="_password"
                                type="password"
                                class="form-control"
                                autocomplete="current-password"
                                placeholder="Contraseña"
                                required
                                data-ui--password-visibility-target="input"
                            >

                            <button
                                type="button"
                                class="btn pf-button pf-button--ghost pf-auth__password-toggle"
                                data-ui--password-visibility-target="toggle"
                                data-action="ui--password-visibility#toggle"
                                aria-label="Mostrar contraseña"
                                aria-pressed="false"
                            >
                                <i
                                    class="bi bi-eye"
                                    aria-hidden="true"
                                    data-ui--password-visibility-target="icon"
                                ></i>
                            </button>
                        </div>
                    </div>

                    <input
                        type="hidden"
                        name="_csrf_token"
                        value="{{ csrf_token('authenticate') }}"
                        data-controller="csrf-protection"
                    >

                    <twig:Ui:Button
                        type="submit"
                        class="pf-button--success pf-button--block pf-auth__submit"
                    >
                        Iniciar sesión
                    </twig:Ui:Button>
                </form>

                {# TODO: sustituir href cuando exista app_password_reset_request. #}
                <a
                    href="#"
                    class="pf-auth__recovery-link"
                    data-future-route="app_password_reset_request"
                    aria-disabled="true"
                    tabindex="-1"
                >
                    ¿Olvidaste tu contraseña?
                </a>
            </div>
        </div>
    </section>

    <div class="pf-auth__support pf-auth__support--footer">
        <div class="pf-auth__support-item">
            <i class="bi bi-headset" aria-hidden="true"></i>

            <p>
                Soporte técnico.
            </p>
        </div>

        <div class="pf-auth__support-item">
            <i class="bi bi-shield-lock" aria-hidden="true"></i>

            <p>Privacidad</p>
        </div>

        <div class="pf-auth__support-item">
            <i class="bi bi-shield-lock" aria-hidden="true"></i>

            <p>Términos de servicio</p>
        </div>
    </div>
{% endblock %}