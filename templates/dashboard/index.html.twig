{% extends 'layouts/app.html.twig' %}

{% block title %}Inicio | OoxCorp{% endblock %}

{% block app_navigation_active %}dashboard{% endblock %}

{% block app_breadcrumb %}Inicio{% endblock %}

{% block app_content %}
    <twig:Ui:PageHeader
        title="Inicio"
        description="Resumen de las herramientas a las que tienes acceso."
    ></twig:Ui:PageHeader>

    <section class="pf-dashboard-welcome">
        <div>
            <p class="pf-dashboard-welcome__eyebrow">Sesión activa</p>
            <h2>Hola, {{ app.user.fullName }}</h2>
            <p>Selecciona un módulo para continuar con tu operación.</p>
        </div>

        <span class="pf-status-badge pf-status-badge--success">
            <i class="bi bi-check-circle" aria-hidden="true"></i>
            Acceso verificado
        </span>
    </section>

    {% if is_granted('inventory.configure') %}
        <section class="pf-dashboard-section">
            <div class="pf-dashboard-section__header"><div><h2>Avisos de inventario</h2><p>Variantes cuyo saldo utilizable alcanzó el mínimo configurado.</p></div><div class="d-flex gap-2"><a href="{{ path('admin_inventory_replenishment_index') }}" class="btn pf-button pf-button--primary pf-button--sm">Preparar reposición</a><a href="{{ path('admin_inventory_receipts_minimums') }}" class="btn pf-button pf-button--secondary pf-button--sm">Configurar mínimos</a></div></div>
            {% if materialShortageAlerts is not empty %}
                <twig:Ui:Card class="mb-3">
                    <div class="d-flex align-items-start gap-2 mb-3"><i class="bi bi-exclamation-triangle-fill text-warning" aria-hidden="true"></i><div><strong>Órdenes con material insuficiente</strong><p class="mb-0 small text-body-secondary">Revisa cada orden para autorizar una sustitución, esperar compra o permitir producción parcial.</p></div></div>
                    <div class="table-responsive"><table class="table pf-table mb-0"><thead><tr><th>Orden</th><th>Material</th><th>Faltante</th><th>Estado</th></tr></thead><tbody>{% for alert in materialShortageAlerts %}<tr><td><a href="{{ path('admin_service_orders_show', {id: alert.serviceOrder.id}) }}">{{ alert.serviceOrder.folio }}</a></td><td><strong>{{ alert.variant.material.name }}</strong><div class="small text-body-secondary">{{ alert.variant.code }}</div></td><td>{{ alert.shortageQuantity|number_format(6, '.', ',') }} {{ alert.variant.inventoryUnit.symbol }}</td><td>{{ alert.status.value == 'PARTIAL' ? 'Cobertura parcial' : 'Sin cobertura' }}</td></tr>{% endfor %}</tbody></table></div>
                </twig:Ui:Card>
            {% endif %}
            <twig:Ui:Card>
                {% if lowStockAlerts is empty %}
                    <p class="mb-0">No hay materiales en mínimo o por debajo de él.</p>
                {% else %}
                    <div class="table-responsive"><table class="table pf-table mb-0"><thead><tr><th>Material</th><th>Disponible</th><th>Mínimo</th></tr></thead><tbody>{% for alert in lowStockAlerts %}<tr><td><strong>{{ alert.variant.material.name }}</strong><div class="small text-body-secondary">{{ alert.variant.code }}</div></td><td>{{ alert.availableQuantity|number_format(6, '.', ',') }} {{ alert.variant.inventoryUnit.symbol }}</td><td>{{ alert.variant.minimumStock|number_format(6, '.', ',') }} {{ alert.variant.inventoryUnit.symbol }}</td></tr>{% endfor %}</tbody></table></div>
                {% endif %}
            </twig:Ui:Card>
        </section>
    {% endif %}

    {% set has_administration_access =
        is_granted('user.view')
        or is_granted('role.view')
        or is_granted('audit_log.view')
    %}

    <section class="pf-dashboard-section">
        <div class="pf-dashboard-section__header">
            <div>
                <h2>Módulos disponibles</h2>
                <p>Accesos habilitados según tus permisos asignados.</p>
            </div>
        </div>

        {% if has_administration_access %}
            <div class="pf-dashboard-grid">
                {% if is_granted('user.view') %}
                    <twig:Ui:Card
                        title="Usuarios"
                        subtitle="Cuentas, estatus y contraseñas temporales."
                        class="pf-dashboard-card"
                    >
                        <a
                            href="{{ path('admin_users_index') }}"
                            class="pf-dashboard-shortcut"
                        >
                            <span class="pf-dashboard-shortcut__icon">
                                <i class="bi bi-people" aria-hidden="true"></i>
                            </span>

                            <span>
                                Administrar usuarios
                                <small>Consultar y gestionar cuentas</small>
                            </span>

                            <i class="bi bi-arrow-right" aria-hidden="true"></i>
                        </a>
                    </twig:Ui:Card>
                {% endif %}

                {% if is_granted('role.view') %}
                    <twig:Ui:Card
                        title="Roles y permisos"
                        subtitle="Control de acceso al sistema."
                        class="pf-dashboard-card"
                    >
                        <a
                            href="{{ path('admin_roles_index') }}"
                            class="pf-dashboard-shortcut"
                        >
                            <span class="pf-dashboard-shortcut__icon">
                                <i class="bi bi-shield-lock" aria-hidden="true"></i>
                            </span>

                            <span>
                                Administrar roles
                                <small>Definir permisos y responsabilidades</small>
                            </span>

                            <i class="bi bi-arrow-right" aria-hidden="true"></i>
                        </a>
                    </twig:Ui:Card>
                {% endif %}

                {% if is_granted('audit_log.view') %}
                    <twig:Ui:Card
                        title="Bitácora"
                        subtitle="Trazabilidad de las acciones administrativas."
                        class="pf-dashboard-card"
                    >
                        <a
                            href="{{ path('admin_audit_index') }}"
                            class="pf-dashboard-shortcut"
                        >
                            <span class="pf-dashboard-shortcut__icon">
                                <i class="bi bi-journal-text" aria-hidden="true"></i>
                            </span>

                            <span>
                                Consultar bitácora
                                <small>Revisar actividades y cambios registrados</small>
                            </span>

                            <i class="bi bi-arrow-right" aria-hidden="true"></i>
                        </a>
                    </twig:Ui:Card>
                {% endif %}
            </div>
        {% else %}
            <twig:Ui:Card class="pf-dashboard-empty">
                <div class="pf-dashboard-empty__icon">
                    <i class="bi bi-shield-check" aria-hidden="true"></i>
                </div>

                <div>
                    <h2>Sin módulos administrativos asignados</h2>
                    <p>Tu cuenta está autenticada, pero no tiene accesos adicionales habilitados.</p>
                </div>
            </twig:Ui:Card>
        {% endif %}
    </section>
{% endblock %}
