{% set variants = {
    primary: 'pf-button--primary',
    secondary: 'pf-button--secondary',
    success: 'pf-button--success',
    danger: 'pf-button--danger',
    link: 'pf-button--link'
} %}

{% set sizes = {
    sm: 'pf-button--sm',
    md: '',
    lg: 'pf-button--lg'
} %}

{% set button_class = [
    'btn',
    'pf-button',
    variants[variant]|default(variants.primary),
    sizes[size]|default('')
]|filter(value => value is not empty)|join(' ') %}

{% set component_content %}
    {% block content %}{% endblock %}
{% endset %}

{% if href %}
    <a
        {{ attributes.defaults({ class: button_class }) }}
        href="{{ href }}"
        {% if disabled %}aria-disabled="true" tabindex="-1"{% endif %}
    >
        {{ component_content }}
    </a>
{% else %}
    <button
        {{ attributes.defaults({ class: button_class, type: type }) }}
        {% if disabled %}disabled{% endif %}
    >
        {{ component_content }}
    </button>
{% endif %}